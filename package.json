{
  "name": "thearchiveof",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "write:redirects": "node scripts/write-redirects.mjs",
    "build": "npm run write:redirects && astro check && astro build && node --experimental-strip-types scripts/write-headers.mjs && node scripts/write-article-keys.mjs && npm run check:urls",
    "preview": "astro preview",
    "preview:cf": "wrangler pages dev dist",
    "test": "node scripts/write-article-keys.mjs && node --test --experimental-strip-types tests/*.test.mjs",
    "check": "astro check",
    "check:pages": "node scripts/check-pages-config.mjs",
    "check:functions": "wrangler pages functions build --outdir .wrangler/functions-check --compatibility-date 2026-09-01",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "check:urls": "node --experimental-strip-types scripts/check-url-contract.mjs",
    "equity:check": "node --experimental-strip-types scripts/check-equity-closes.mjs",
    "model:hii": "node --experimental-strip-types scripts/hii-valuation.mjs",
    "model:salesforce": "node --experimental-strip-types scripts/salesforce-valuation.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/markdown-remark": "latest",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "rehype-katex": "latest",
    "remark-math": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest",
    "wrangler": "^4.40.0"
  }
}
