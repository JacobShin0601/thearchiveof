---
import {
  HII_CURRENT_PRICE,
  hiiBacklog,
  hiiMarginBenchmarks,
  hiiMarginHistory,
  hiiMarginSensitivity,
  hiiScenarios,
} from '../data/hii-valuation';

interface Props {
  variant: 'margin' | 'backlog' | 'sensitivity' | 'valuation';
  language?: 'ko' | 'en';
}

const { variant, language = 'ko' } = Astro.props;
const en = language === 'en';

const width = 720;
const height = 330;
const pad = { left: 48, right: 20, top: 24, bottom: 48 };
const chartWidth = width - pad.left - pad.right;
const chartHeight = height - pad.top - pad.bottom;
const marginMax = 0.18;
const xFor = (index: number) =>
  pad.left + (index / (hiiMarginHistory.length - 1)) * chartWidth;
const yFor = (value: number) => pad.top + chartHeight - (value / marginMax) * chartHeight;
const line = (key: 'combinedMargin' | 'ingallsMargin' | 'newportMargin') =>
  hiiMarginHistory
    .map((row, index) => ({ value: row[key], index }))
    .filter((point) => typeof point.value === 'number')
    .map((point) => `${xFor(point.index)},${yFor(point.value as number)}`)
    .join(' ');
const yTicks = [0, 0.03, 0.06, 0.09, 0.12, 0.15, 0.18];

const valuationRows = [
  hiiScenarios[0],
  { name: en ? 'Current price' : '현재가', presentValue: HII_CURRENT_PRICE, current: true },
  hiiScenarios[1],
  hiiScenarios[2],
];
const valuationMax = Math.max(...valuationRows.map((row) => row.presentValue));
const sensitivityMax = Math.max(...hiiMarginSensitivity.map((row) => row.operatingIncome));
---

<figure class={`hii-figure ${variant}`}>
  {variant === 'margin' && (
    <>
      <h3>{en ? 'HII shipbuilding margin history' : 'HII 조선 부문 마진의 11년 역사'}</h3>
      <p class="kicker">
        {en
          ? 'The 7.5% base case sits below the pre-COVID average and near the 2021–2023 recovery level.'
          : '7.5% Base는 코로나 이전 평균보다 낮고 2021–2023년 회복기와 비슷하다.'}
      </p>
      <div class="legend" aria-hidden="true">
        <span class="combined">{en ? 'Combined shipbuilding' : '통합 조선'}</span>
        <span class="ingalls">Ingalls</span>
        <span class="newport">Newport News</span>
      </div>
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={en ? 'Ingalls, Newport News, and combined shipbuilding operating margins from 2015 to 2026 guidance' : '2015년부터 2026년 가이던스까지 Ingalls, Newport News, 통합 조선 영업마진'}>
        <title>{en ? 'HII shipbuilding margin history' : 'HII 조선 부문 마진 역사'}</title>
        {yTicks.map((tick) => (
          <g>
            <line class="grid" x1={pad.left} x2={width - pad.right} y1={yFor(tick)} y2={yFor(tick)} />
            <text class="axis y" x={pad.left - 8} y={yFor(tick) + 4}>{Math.round(tick * 100)}%</text>
          </g>
        ))}
        <line class="benchmark pre-covid" x1={pad.left} x2={width - pad.right} y1={yFor(hiiMarginBenchmarks.preCovid2015To2019)} y2={yFor(hiiMarginBenchmarks.preCovid2015To2019)} />
        <line class="benchmark base" x1={pad.left} x2={width - pad.right} y1={yFor(hiiMarginBenchmarks.base2030)} y2={yFor(hiiMarginBenchmarks.base2030)} />
        <text class="annotation pre-covid-label" x={width - pad.right - 4} y={yFor(hiiMarginBenchmarks.preCovid2015To2019) - 6} text-anchor="end">
          {en ? '2015–19 weighted avg 9.9%' : '2015–19 가중평균 9.9%'}
        </text>
        <text class="annotation base-label" x={width - pad.right - 4} y={yFor(hiiMarginBenchmarks.base2030) - 6} text-anchor="end">
          {en ? '2030 base 7.5%' : '2030 Base 7.5%'}
        </text>
        <polyline class="margin-line ingalls-line" points={line('ingallsMargin')} />
        <polyline class="margin-line newport-line" points={line('newportMargin')} />
        <polyline class="margin-line combined-line" points={line('combinedMargin')} />
        {hiiMarginHistory.map((row, index) => (
          <>
            <circle class={`point ${row.year === 2026 ? 'estimate' : ''}`} cx={xFor(index)} cy={yFor(row.combinedMargin as number)} r="3.5" />
            <text class="axis x" x={xFor(index)} y={height - 18} text-anchor="middle">{String(row.year).slice(2)}</text>
          </>
        ))}
        <text class="estimate-label" x={xFor(hiiMarginHistory.length - 1)} y={yFor(0.0625) + 18} text-anchor="end">6.0–6.5%</text>
      </svg>
    </>
  )}

  {variant === 'backlog' && (
    <>
      <h3>{en ? 'How HII expects its obligations to convert' : 'HII의 수주가 매출로 전환되는 시간'}</h3>
      <p class="kicker">
        {en
          ? 'Share of remaining performance obligations as of June 30, 2026'
          : '2026년 6월 30일 기준 잔여 수행의무의 매출 인식 시점'}
      </p>
      <div class="stacked" aria-label={en ? '35 percent through 2027, 35 percent during 2028 and 2029, and 30 percent after 2029' : '2027년까지 35%, 2028년에서 2029년까지 35%, 2029년 이후 30%'}>
        {hiiBacklog.conversion.map((row, index) => (
          <div class={`stack stack-${index}`} style={`width:${row.share * 100}%`}>
            <strong>{Math.round(row.share * 100)}%</strong>
            <span>{en ? row.period : row.periodKo}</span>
          </div>
        ))}
      </div>
      <div class="backlog-note">
        <strong>$57.3B</strong>
        <span>{en ? '$34.6B funded · $22.7B unfunded' : 'funded $34.6B · unfunded $22.7B'}</span>
      </div>
    </>
  )}

  {variant === 'sensitivity' && (
    <>
      <h3>{en ? 'Same revenue, very different economics' : '같은 매출, 완전히 다른 economics'}</h3>
      <p class="kicker">
        {en
          ? 'Operating income at the base-case 2030 shipbuilding revenue of $13.0B'
          : '2030년 Base 조선 매출 $13.0B를 고정했을 때의 영업이익'}
      </p>
      <div class="bars sensitivity-bars">
        {hiiMarginSensitivity.map((row) => (
          <div class="bar-row">
            <span>{(row.margin * 100).toFixed(row.margin === 0.075 ? 1 : 0)}%</span>
            <div class="track"><i style={`width:${(row.operatingIncome / sensitivityMax) * 100}%`}></i></div>
            <b>${row.operatingIncome.toFixed(2)}B</b>
          </div>
        ))}
      </div>
    </>
  )}

  {variant === 'valuation' && (
    <>
      <h3>{en ? 'What is Huntington Ingalls Industries worth today?' : '2030년의 Huntington Ingalls Industries를 오늘 가격으로 환산하면'}</h3>
      <p class="kicker">{en ? 'Scenario values discounted at 10% a year' : '시나리오별 2030년 가격을 연 10%로 할인'}</p>
      <div class="bars">
        {valuationRows.map((row) => (
          <div class={`bar-row ${'current' in row && row.current ? 'current' : ''}`}>
            <span>{row.name}</span>
            <div class="track"><i style={`width:${(row.presentValue / valuationMax) * 100}%`}></i></div>
            <b>${Math.round(row.presentValue)}</b>
          </div>
        ))}
      </div>
    </>
  )}

  <figcaption>
    {variant === 'margin' && (en
      ? <>Combined margin is Ingalls plus Newport News segment operating income divided by their segment revenue. 2026E is the midpoint of company guidance. The 2023 Ingalls result includes a court-judgment sale. Source: HII annual reports; author calculation.</>
      : <>통합 마진은 Ingalls와 Newport News의 부문 영업이익 합계를 두 부문의 매출 합계로 나눈 값이다. 2026E는 회사 가이던스 중간값이다. 2023년 Ingalls에는 court judgment 매각 효과가 포함됐다. Source: HII annual reports; author calculation.</>)}
    {variant === 'backlog' && (en
      ? <>The filing gives cumulative recognition windows, not annual amounts: 35% through 2027, another 35% through 2029, and the balance thereafter. Backlog is as of June 30, 2026. Source: HII Q2 2026 Form 10-Q.</>
      : <>공시는 연도별 금액이 아니라 누적 구간을 제시한다. 2027년까지 35%, 2029년까지 추가 35%, 나머지는 그 이후다. 수주잔고는 2026-06-30 기준. Source: HII Q2 2026 Form 10-Q.</>)}
    {variant === 'sensitivity' && (en
      ? <>Revenue is held constant. Moving from a 6% to a 9% margin raises shipbuilding operating income by 50%. Source: author estimate.</>
      : <>매출은 고정했다. 마진이 6%에서 9%로 오르면 조선 영업이익은 50% 증가한다. Source: author estimate.</>)}
    {variant === 'valuation' && (en
      ? <>October 6, 2026 close: $263.75. Bear $161, base $285, bull $424. Discount period: 4.233 years through December 31, 2030. Source: HII filings, S&amp;P Global Market Intelligence price data via Stock Analysis; author estimates.</>
      : <>2026-10-06 종가 $263.75. Bear $161, Base $285, Bull $424. 2030-12-31까지 4.233년 할인. Source: HII filings, S&amp;P Global Market Intelligence price data via Stock Analysis; author estimates.</>)}
  </figcaption>
</figure>

<style>
  .hii-figure{margin:2.3rem 0;padding:1.2rem;border:1px solid var(--line);background:var(--paper-deep);color:var(--ink);font-family:var(--sans);font-size:.86rem;line-height:1.5}
  .hii-figure h3{font-family:var(--serif);font-size:1.3rem;margin:0}
  .kicker{margin:.35rem 0 1rem;color:var(--muted)}
  .hii-figure figcaption{margin-top:1rem;color:var(--muted);font-size:.75rem}
  svg{display:block;width:100%;height:auto;overflow:visible}
  .grid{stroke:var(--line);stroke-width:1}
  .axis{fill:var(--muted);font-size:10px}
  .axis.y{text-anchor:end}
  .margin-line{fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .combined-line{stroke:var(--accent);stroke-width:3}
  .ingalls-line{stroke:var(--ink);stroke-dasharray:5 4;opacity:.65}
  .newport-line{stroke:var(--muted);stroke-dasharray:2 4}
  .point{fill:var(--accent)}
  .point.estimate{fill:var(--paper);stroke:var(--accent);stroke-width:2}
  .benchmark{stroke-width:1}
  .pre-covid{stroke:var(--muted);stroke-dasharray:6 5}
  .base{stroke:var(--accent);stroke-dasharray:3 4;opacity:.8}
  .annotation,.estimate-label{fill:var(--muted);font-size:10px}
  .legend{display:flex;gap:1rem;flex-wrap:wrap;margin:-.35rem 0 .35rem;color:var(--muted);font-size:.74rem}
  .legend span::before{content:'';display:inline-block;width:18px;height:2px;margin-right:.35rem;vertical-align:middle;background:var(--accent)}
  .legend .ingalls::before{background:var(--ink)}
  .legend .newport::before{background:var(--muted)}
  .stacked{display:flex;min-height:112px;border:1px solid var(--line)}
  .stack{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15rem;text-align:center;background:var(--accent);color:var(--paper);padding:.6rem .3rem}
  .stack strong{font-size:1.35rem}
  .stack span{font-size:.74rem}
  .stack-1{background:color-mix(in srgb,var(--accent) 72%,var(--ink))}
  .stack-2{background:color-mix(in srgb,var(--accent) 42%,var(--ink))}
  .backlog-note{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-top:.8rem}
  .backlog-note strong{font-family:var(--serif);font-size:1.4rem}
  .backlog-note span{color:var(--muted)}
  .bars{display:grid;gap:.65rem}
  .bar-row{display:grid;grid-template-columns:88px 1fr 76px;gap:.55rem;align-items:center}
  .bar-row.current span,.bar-row.current b{color:var(--accent)}
  .track{height:22px;background:color-mix(in srgb,var(--accent) 12%,transparent)}
  .track i{display:block;height:100%;background:var(--accent)}
  .bar-row.current .track i{background:var(--ink)}
  .bar-row b{text-align:right}
  @media(max-width:650px){
    .hii-figure{padding:.85rem}
    .bar-row{grid-template-columns:72px 1fr 64px}
    .stacked{min-height:148px}
    .stack strong{font-size:1.05rem}
    .stack span{font-size:.67rem}
    .backlog-note{align-items:flex-start;flex-direction:column;gap:.1rem}
    .annotation{display:none}
  }
</style>
