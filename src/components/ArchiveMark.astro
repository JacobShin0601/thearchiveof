---
interface Props {
  variant?: 'overlap' | 'book' | 'double-c' | 'orbit';
  size?: number;
  label?: string;
  decorative?: boolean;
}

const {
  variant = 'overlap',
  size = 32,
  label = 'The Archive of',
  decorative = false,
} = Astro.props;
const titleId = `archive-mark-title-${variant}-${size}`;
const descId = `archive-mark-desc-${variant}-${size}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 180 180"
  width={size}
  height={size}
  class={`archive-mark archive-mark-${variant}`}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-labelledby={decorative ? undefined : `${titleId} ${descId}`}
>
  {!decorative && <>
    <title id={titleId}>{label}</title>
    <desc id={descId}>
      {variant === 'overlap' && 'Two quiet overlapping lenses represent different fields meeting.'}
      {variant === 'book' && 'An open book represents records that create new questions.'}
      {variant === 'double-c' && 'Two open curves represent connected perspectives.'}
      {variant === 'orbit' && 'An open editorial orbit represents review and revision.'}
    </desc>
  </>}
  <rect width="180" height="180" rx="38" fill="#294c3e"/>
  {variant === 'overlap' && <>
    <ellipse cx="77" cy="90" rx="43" ry="60" fill="none" stroke="#f2f0e9" stroke-width="8"/>
    <ellipse cx="103" cy="90" rx="43" ry="60" fill="none" stroke="#a9c0b1" stroke-width="8"/>
    <circle cx="90" cy="90" r="3" fill="#e8b86a"/>
  </>}
  {variant === 'book' && <>
    <path d="M38 65q52 5 52 27v50q0-22-52-27V65ZM142 65q-52 5-52 27v50q0-22 52-27V65Z" fill="#f2f0e9"/>
    <path d="M90 92v50" stroke="#a9c0b1" stroke-width="3"/>
    <circle cx="90" cy="87" r="3" fill="#e8b86a"/>
  </>}
  {variant === 'double-c' && <>
    <path d="M78 47C31 55 31 125 78 133M102 47c47 8 47 78 0 86" fill="none" stroke="#f2f0e9" stroke-width="12" stroke-linecap="round"/>
    <path d="M68 90h44" stroke="#a9c0b1" stroke-width="5" stroke-linecap="round"/>
  </>}
  {variant === 'orbit' && <>
    <circle cx="90" cy="90" r="57" fill="none" stroke="#f2f0e9" stroke-width="8" stroke-dasharray="215 143" stroke-linecap="round" transform="rotate(-40 90 90)"/>
    <circle cx="90" cy="90" r="38" fill="none" stroke="#a9c0b1" stroke-width="3" stroke-dasharray="2 8"/>
    <path d="M90 29v9" stroke="#e8b86a" stroke-width="3" stroke-linecap="round"/>
  </>}
</svg>

<style>
  .archive-mark { display: block; }
</style>
