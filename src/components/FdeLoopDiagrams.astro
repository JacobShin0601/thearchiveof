---
interface Props {
  variant: 'hero' | 'latency' | 'impedance' | 'loops' | 'roles' | 'workaround' | 'scale' | 'models' | 'accumulation' | 'ai-leverage' | 'evidence';
  language: 'ko' | 'en';
}

const { variant, language } = Astro.props;
const ko = language === 'ko';

const c = ko ? {
  hero: { title: 'FDE의 단위는 사람이 아니라 Loop다', items: ['문제 발견', '구축', '배포', '학습', '제품화', '재사용'], caption: 'Conceptual illustration · 고객과 core product 사이의 loop가 한 번 돌 때마다 다음 배포를 위한 자산이 남아야 한다.' },
  latency: { title: 'Customer-to-Product Latency', items: ['Custom Agent', 'SSO 문제', '고객 대응 인력', '전문가들', 'Escalation', 'Product team', '수정', '여전히 불안정', '사용 중단'], note: '이 사례의 latency: 2주 이상', caption: 'Author’s experience — simplified · 하나의 고객·제품·지역에서 겪은 사례이며 Google Cloud 전체의 benchmark가 아니다.' },
  impedance: { title: 'Organizational Impedance', left: ['고객', 'FDE', '제품'], right: ['고객', 'Field', '전문가', '서비스 조직', 'Product owner', 'Engineering'], caption: 'Conceptual illustration · 오른쪽은 실제 AWS·Google 조직도가 아니다. 각 경계에서 handoff, queue, priority, ownership friction이 생길 수 있음을 단순화했다.' },
  loops: { title: 'FDE에 필요한 두 개의 Loop', left: ['고객의 말', '현실 관찰', '숨은 문제', '문제 재정의', '구축'], right: ['구축', 'Product gap', 'Core product', '제품화', '재사용'], risk1: 'Risk · Adoption bias', risk2: 'Risk · Organizational impedance', caption: 'Author’s framework · 첫 loop는 무엇을 만들지 찾고, 두 번째 loop는 한 고객의 학습을 다음 고객의 제품으로 바꾼다.' },
  roles: { title: '직무명이 아니라 feedback architecture', caption: 'Conceptual positioning · 실제 회사나 조직의 성과평가가 아니다. 같은 직무도 권한과 product feedback 구조에 따라 위치가 달라질 수 있다.' },
  workaround: { title: 'Productization인가, Workaround Factory인가', good: ['Core product 변경', 'Reusable primitive', '다음 고객이 더 빠름', 'Software leverage'], bad: ['Core 변경 불가', 'Custom integration', '고객별 code', 'Maintenance', 'Services labor'], caption: 'Conceptual illustration · 제품을 바꿀 영향력 없이 해결 책임만 주어지면 현장 조직은 bespoke workaround를 쌓을 수 있다.' },
  scale: { title: 'Scale Advantage vs Organizational Disadvantage', good: ['더 많은 고객', '더 많은 signal', 'Compute·models', 'Distribution', 'Security·trust'], bad: ['더 많은 handoff', 'Product distance', 'KPI conflict', 'Global roadmap', 'Escalation latency'], question: '학습의 이점이 조직의 지연보다 클 수 있는가?', caption: 'Author’s framework · hyperscaler의 규모는 학습 재료와 전달 마찰을 동시에 키울 수 있다.' },
  models: { title: 'Why Palantir May Be Different', cols: [['Hyperscaler', 'Product', 'Sales·SA·Support', 'Customer', 'FDE added later'], ['AI-native startup', 'Customer', 'FDE', 'Learning', 'Productization'], ['Palantir', 'Customer problem', 'FDE', 'Data + operations', 'Ontology·platform', 'Next customer']], labels: ['Product-first', 'FDE-first', 'FDE-native + accumulated platform'], caption: 'Author’s framework · 실제 reporting line이 아니라 세 가지 역사적 출발점을 비교한 개념도다.' },
  accumulation: { title: '그 Loop가 1,000번 돌고 나면 무엇이 남는가?', items: ['Customer 1 → reusable primitive', 'Customer 10 → deployment pattern', 'Customer 100 → platform capability', 'Customer N → accumulated learning'], caption: 'Conceptual illustration · Gotham·Foundry, Ontology, Apollo, AIP를 단일한 선형 제품 역사로 단정하는 그림이 아니다.' },
  'ai-leverage': { title: 'AI는 FDE를 없애기보다 output을 키울 수 있다', before: ['고객', 'FDE', '데이터 연결', '업무 모델링', 'Workflow', '배포'], after: ['고객', 'FDE + AI', '기존 Ontology·platform', 'Agent·application', '배포'], caption: 'Hypothesis · AIP와 AI FDE가 사람을 완전히 대체한다는 뜻이 아니라, 축적된 platform 위에서 배포 생산성을 높일 가능성을 그렸다.' },
  evidence: { title: '무엇이 내 생각을 바꿀까?', rows: [['Customer-to-Product Latency', '더 짧은 feedback cycle'], ['Productization', '현장 작업이 product primitive로 이동'], ['Reuse', '여러 고객에서 같은 artifact 재사용'], ['Deployment compression', '비슷한 배포가 더 빨라짐'], ['Core product influence', 'FDE learning이 roadmap을 변경'], ['Workaround ratio', 'bespoke code보다 reusable product'], ['Outcome KPI', 'consumption뿐 아니라 고객 결과']], caption: 'Author’s falsification checklist · 공개된 실제 KPI나 점수가 아니라 향후 확인하고 싶은 evidence다.' },
} : {
  hero: { title: 'The unit of FDE is the loop, not the engineer', items: ['Discover', 'Build', 'Deploy', 'Learn', 'Productize', 'Reuse'], caption: 'Conceptual illustration · Each turn between the customer and core product should leave an asset that improves the next deployment.' },
  latency: { title: 'Customer-to-Product Latency', items: ['Custom Agent', 'SSO issue', 'Customer-facing team', 'Specialists', 'Escalation', 'Product team', 'Fix', 'Still unreliable', 'Feature abandoned'], note: 'Latency in this case: more than two weeks', caption: 'Author’s experience — simplified · One customer, product, and region; not a benchmark for Google Cloud as a whole.' },
  impedance: { title: 'Organizational Impedance', left: ['Customer', 'FDE', 'Product'], right: ['Customer', 'Field', 'Specialist', 'Service org', 'Product owner', 'Engineering'], caption: 'Conceptual illustration · The right side is not an AWS or Google org chart. It simplifies the handoffs, queues, priorities, and ownership friction that can appear at boundaries.' },
  loops: { title: 'The Two Loops of FDE', left: ['What customer says', 'Observe reality', 'Hidden problem', 'Redefine', 'Build'], right: ['Build', 'Product gap', 'Core product', 'Productize', 'Reuse'], risk1: 'Risk · Adoption bias', risk2: 'Risk · Organizational impedance', caption: 'Author’s framework · The first loop discovers what to build. The second turns one customer’s learning into the next customer’s product.' },
  roles: { title: 'Feedback architecture, not job titles', caption: 'Conceptual positioning · This is not a rating of any real organization. The same role can move depending on authority and product-feedback design.' },
  workaround: { title: 'Productization or a Workaround Factory?', good: ['Change core product', 'Reusable primitive', 'Next customer faster', 'Software leverage'], bad: ['Core cannot change', 'Custom integration', 'Customer-specific code', 'Maintenance', 'Services labor'], caption: 'Conceptual illustration · Responsibility to solve without influence over the product can accumulate bespoke workarounds.' },
  scale: { title: 'Scale Advantage vs Organizational Disadvantage', good: ['More customers', 'More signals', 'Compute and models', 'Distribution', 'Security and trust'], bad: ['More handoffs', 'Product distance', 'KPI conflict', 'Global roadmap', 'Escalation latency'], question: 'Can the learning advantage outrun the organizational latency?', caption: 'Author’s framework · Hyperscaler scale can enlarge both the learning pool and the friction of transmitting it.' },
  models: { title: 'Why Palantir May Be Different', cols: [['Hyperscaler', 'Product', 'Sales·SA·Support', 'Customer', 'FDE added later'], ['AI-native startup', 'Customer', 'FDE', 'Learning', 'Productization'], ['Palantir', 'Customer problem', 'FDE', 'Data + operations', 'Ontology·platform', 'Next customer']], labels: ['Product-first', 'FDE-first', 'FDE-native + accumulated platform'], caption: 'Author’s framework · These are historical starting points, not actual reporting lines.' },
  accumulation: { title: 'After the loop runs 1,000 times, what remains?', items: ['Customer 1 → reusable primitive', 'Customer 10 → deployment pattern', 'Customer 100 → platform capability', 'Customer N → accumulated learning'], caption: 'Conceptual illustration · This does not claim Gotham and Foundry, Ontology, Apollo, and AIP formed one simple linear product history.' },
  'ai-leverage': { title: 'AI may amplify FDE output rather than remove FDE', before: ['Customer', 'FDE', 'Connect data', 'Model operations', 'Workflow', 'Deploy'], after: ['Customer', 'FDE + AI', 'Existing Ontology·platform', 'Agent·application', 'Deploy'], caption: 'Hypothesis · AIP and AI FDE do not imply full human replacement. The diagram shows potential productivity gains on top of an accumulated platform.' },
  evidence: { title: 'What Would Change My Mind?', rows: [['Customer-to-Product Latency', 'Shorter feedback cycle'], ['Productization', 'Field work becomes a product primitive'], ['Reuse', 'Artifacts reused across customers'], ['Deployment compression', 'Similar deployments get faster'], ['Core product influence', 'FDE learning changes the roadmap'], ['Workaround ratio', 'Reusable product exceeds bespoke code'], ['Outcome KPI', 'Customer outcomes, not consumption alone']], caption: 'Author’s falsification checklist · These are not disclosed company KPIs or scores, but evidence worth watching.' },
};
---

<figure class={`loop-figure ${variant}`} aria-label={c[variant].title}>
  <p class="title">{c[variant].title}</p>

  {variant === 'hero' && <div class="ring">{c.hero.items.map((x, i) => <div><span>{i + 1}</span>{x}</div>)}</div>}
  {variant === 'latency' && <><div class="flow compact">{c.latency.items.map((x) => <div>{x}</div>)}</div><p class="metric">{c.latency.note}</p></>}
  {variant === 'impedance' && <div class="columns"><section><h3>AI-native</h3><div class="flow">{c.impedance.left.map((x) => <div>{x}</div>)}</div></section><section><h3>{ko ? '대규모 조직 · 예시' : 'Large organization · illustrative'}</h3><div class="flow boundaries">{c.impedance.right.map((x) => <div>{x}</div>)}</div></section></div>}
  {variant === 'loops' && <div class="columns"><section><h3>Problem Discovery</h3><div class="flow">{c.loops.left.map((x) => <div>{x}</div>)}</div><b class="risk">{c.loops.risk1}</b></section><section><h3>Product Learning</h3><div class="flow accent">{c.loops.right.map((x) => <div>{x}</div>)}</div><b class="risk">{c.loops.risk2}</b></section></div>}
  {variant === 'roles' && <div class="matrix"><span class="y">Product feedback · reuse ↑</span><span class="x">Problem definition → implementation</span><i class="sa">SA</i><i class="ps">ProServe</i><i class="fde">Ideal FDE</i><i class="fail">Hands-on SA</i></div>}
  {variant === 'workaround' && <div class="fork"><div class="root">Product gap</div><section class="good">{c.workaround.good.map((x) => <div>{x}</div>)}</section><section class="bad">{c.workaround.bad.map((x) => <div>{x}</div>)}</section></div>}
  {variant === 'scale' && <><div class="balance"><section><h3>Scale advantage</h3>{c.scale.good.map((x) => <span>{x}</span>)}</section><strong>VS</strong><section><h3>Organizational disadvantage</h3>{c.scale.bad.map((x) => <span>{x}</span>)}</section></div><p class="question">{c.scale.question}</p></>}
  {variant === 'models' && <div class="trio">{c.models.cols.map((col, i) => <section><h3>{col[0]}</h3>{col.slice(1).map((x) => <div>{x}</div>)}<b>{c.models.labels[i]}</b></section>)}</div>}
  {variant === 'accumulation' && <div class="stairs">{c.accumulation.items.map((x, i) => <div style={`--i:${i}`}>{x}</div>)}</div>}
  {variant === 'ai-leverage' && <div class="columns"><section><h3>{ko ? 'AI 이전' : 'Before AI'}</h3><div class="flow">{c['ai-leverage'].before.map((x) => <div>{x}</div>)}</div></section><section><h3>{ko ? 'AI와 함께' : 'With AI'}</h3><div class="flow accent">{c['ai-leverage'].after.map((x) => <div>{x}</div>)}</div></section></div>}
  {variant === 'evidence' && <div class="evidence-table">{c.evidence.rows.map((r) => <div><strong>{r[0]}</strong><span>{r[1]}</span></div>)}</div>}

  <figcaption>{c[variant].caption}</figcaption>
</figure>

<style>
  .loop-figure{margin:2rem 0;padding:1.2rem;border:1px solid var(--line);background:var(--paper-deep);font:500 .8rem/1.45 var(--sans);color:var(--ink)}.title{margin:0 0 1rem;font-weight:800}.loop-figure figcaption{margin-top:1rem;color:var(--muted);font-size:.73rem}.ring{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}.ring div,.flow div,.fork section div,.trio section div{padding:.65rem;border:1px solid var(--line);background:var(--paper)}.ring div{display:flex;gap:.55rem;align-items:center}.ring span{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--accent);color:var(--paper);font-size:.65rem}.flow{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem}.flow div{flex:1;min-width:78px;text-align:center}.flow div:not(:last-child)::after{content:'→';float:right;margin-right:-.95rem;color:var(--muted)}.compact div{min-width:92px}.metric,.question{margin:.8rem 0 0;padding:.65rem;border:1px dashed var(--accent);color:var(--accent);text-align:center;font-weight:800}.columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.columns section{padding:.85rem;border:1px solid var(--line);background:var(--paper)}.columns h3,.trio h3,.balance h3{margin:0 0 .7rem;font-size:.78rem}.boundaries div{border-left:3px solid #9b5038}.accent div{border-left:3px solid var(--accent)}.risk{display:block;margin-top:.7rem;color:#8a4634}.matrix{position:relative;height:310px;border-left:2px solid var(--ink);border-bottom:2px solid var(--ink);background:linear-gradient(90deg,transparent 49.8%,var(--line) 50%,transparent 50.2%),linear-gradient(transparent 49.8%,var(--line) 50%,transparent 50.2%)}.matrix .x,.matrix .y{position:absolute;color:var(--muted);font-size:.68rem}.matrix .x{right:0;bottom:-1.45rem}.matrix .y{left:.5rem;top:.45rem}.matrix i{position:absolute;padding:.45rem .6rem;border:1px solid var(--line);background:var(--paper);font-style:normal;font-weight:800}.sa{left:20%;top:58%}.ps{right:16%;bottom:18%}.fde{right:18%;top:16%;color:var(--accent)}.fail{left:47%;top:43%;color:#8a4634}.fork{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.root{grid-column:1/-1;padding:.7rem;background:var(--ink);color:var(--paper);text-align:center;font-weight:800}.fork section{padding:.7rem;border:1px solid var(--line)}.fork section div:not(:last-child),.trio section div:not(:last-child){margin-bottom:.4rem}.good{border-top:4px solid var(--accent)!important}.bad{border-top:4px solid #9b5038!important}.balance{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:center}.balance section{display:flex;flex-wrap:wrap;gap:.45rem;padding:.85rem;border:1px solid var(--line);background:var(--paper)}.balance span{padding:.4rem .55rem;border:1px solid var(--line);border-radius:999px}.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.trio section{padding:.8rem;border:1px solid var(--line);background:var(--paper)}.trio b{display:block;margin-top:.65rem;color:var(--accent)}.stairs{display:grid;gap:.55rem}.stairs div{width:calc(62% + var(--i) * 11%);padding:.7rem;border-left:4px solid var(--accent);background:var(--paper);border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.evidence-table{display:grid;border-top:1px solid var(--line)}.evidence-table div{display:grid;grid-template-columns:1fr 1.5fr;gap:1rem;padding:.65rem;border-bottom:1px solid var(--line);background:var(--paper)}.evidence-table span{color:var(--muted)}
  @media(max-width:680px){.loop-figure{padding:.9rem}.ring,.columns,.trio{grid-template-columns:1fr}.flow{display:grid;grid-template-columns:1fr}.flow div:not(:last-child)::after{content:'↓';float:none;display:block;margin:.2rem 0 -.8rem}.balance{grid-template-columns:1fr}.balance>strong{text-align:center}.matrix{height:260px}.fork{grid-template-columns:1fr}.root{grid-column:1}.stairs div{width:100%}.evidence-table div{grid-template-columns:1fr}.compact div{min-width:0}}
</style>
