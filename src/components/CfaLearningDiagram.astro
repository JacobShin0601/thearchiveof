---
interface Props { kind: 'journey' | 'learning' | 'expansion' }
const { kind } = Astro.props;
const captions = {
  journey: '그림 1. 리튬 가격 모델링에서 시작해 기업 공시의 금융 맥락을 배우고, AI와 금융을 함께 놓고 질문하게 된 과정.',
  learning: '그림 2. 필요한 문제를 빠르게 푸는 학습과 개념 사이의 연결을 넓히는 학습. 두 방식은 서로 오가며 사용할 수 있습니다.',
  expansion: '그림 3. 증설 발표를 공급 증가 신호로 읽는 데서 나아가, 자금·진행 단계·가격 조건을 통해 공급 실현 가능성을 묻는 일반화된 예시.',
};
const journey = ['리튬 가격 모델링', '기업 공시 읽기', '숫자의 의미에서 막힘', 'CFA 학습', '금융 맥락 이해', '더 나은 질문', 'AI × Finance'];
const context = [
  ['CapEx', '실제 투자 집행'], ['잉여현금흐름', '투자비 충당 가능성'], ['차입 여력', '추가 자금조달 조건'],
  ['프로젝트 진행', '계획과 실제 단계'], ['리튬 가격 환경', '경제성과 연기 가능성'], ['장기 계약 · 헤지', '현금흐름과 가격 위험'],
];
---
<figure class="cfa-diagram" aria-labelledby={`cfa-${kind}-caption`}>
  <p class="diagram-label" aria-hidden="true">{kind === 'journey' ? '01 / 배움의 경로' : kind === 'learning' ? '02 / 두 가지 학습' : '03 / 발표에서 실행 가능성으로'}</p>
  {kind === 'journey' && <ol class="journey" role="list">
    {journey.map((label, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{label}{index === 1 && <small>10-K · 10-Q · 실적 발표</small>}</span></li>)}
  </ol>}
  {kind === 'learning' && <>
    <div class="learning-grid">
      <div class="learning-card">
        <p class="card-title">필요할 때 AI에게 묻는 학습</p>
        <ol class="learning-steps"><li>모르는 개념 발견</li><li>질문</li><li>설명</li><li>코드</li><li>업무 적용</li></ol>
        <p class="note">현재 문제에 빠르게 적용합니다.<br />아직 모르는 영역은 지나치기 쉽습니다.</p>
      </div>
      <div class="learning-card">
        <p class="card-title">체계적 학습</p>
        <ul class="subjects" role="list"><li>회계</li><li>경제학</li><li>채권</li><li>포트폴리오</li><li>파생상품</li></ul>
        <p class="connection">개념 ↔ 맥락 ↔ 다른 개념</p>
        <p class="note">당장 필요하지 않은 연결도 배웁니다.<br />시간이 들고 적용까지 거리가 있을 수 있습니다.</p>
      </div>
    </div>
    <p class="takeaway">AI는 답을 빠르게 준다.<br />체계적 학습은 질문의 공간을 넓힌다.</p>
  </>}
  {kind === 'expansion' && <div class="expansion">
    <div class="signal"><span class="stage">공시 문장</span><p>“향후 생산능력을 확대한다”</p><small>Capacity expansion announced</small></div>
    <span class="arrow" aria-hidden="true">↓</span>
    <div class="signal"><span class="stage">텍스트에서 추출한 신호</span><p>공급 증가 신호</p></div>
    <span class="arrow" aria-hidden="true">↓</span>
    <div class="context"><p class="card-title">금융 맥락을 함께 확인</p><ul role="list">{context.map(([title, description]) => <li><strong>{title}</strong><span>{description}</span></li>)}</ul></div>
    <span class="arrow" aria-hidden="true">↓</span>
    <div class="signal"><span class="stage">다시 정의한 질문</span><p>실제 공급이 실현될 가능성은?</p></div>
    <span class="arrow" aria-hidden="true">↓</span>
    <div class="result"><p>더 나은 입력변수 후보 · 더 구체적인 모델 질문</p><small>성능 개선 여부는 별도로 검증합니다.</small></div>
  </div>}
  <figcaption id={`cfa-${kind}-caption`}>{captions[kind]}</figcaption>
</figure>
<style>
  .cfa-diagram { margin: 2.5rem 0; padding: clamp(18px, 4vw, 30px); border: 1px solid var(--line); background: var(--paper-deep); color: var(--ink); font-family: var(--sans); }
  .cfa-diagram .diagram-label { margin: 0 0 1.3rem; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; }
  .cfa-diagram ol, .cfa-diagram ul { margin: 0; padding: 0; }
  .cfa-diagram li { margin: 0; }
  .journey { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; list-style: none; }
  .journey li { display: flex; align-items: center; gap: 12px; border: 1px solid var(--line); background: var(--paper); padding: 14px; font-size: 14px; line-height: 1.65; }
  .journey li:last-child { grid-column: 1 / -1; border-color: var(--accent); color: var(--accent); font-weight: 700; }
  .step-number { color: var(--accent); font-size: 11px; font-weight: 700; }
  .cfa-diagram small { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
  .learning-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .learning-card { padding: 18px; background: var(--paper); border-top: 2px solid var(--accent); }
  .cfa-diagram .card-title { margin: 0 0 16px; font-size: 15px; font-weight: 700; }
  .cfa-diagram .learning-steps { padding-left: 20px; font-size: 14px; line-height: 2; }
  .subjects { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; }
  .subjects li { padding: 5px 9px; border: 1px solid var(--line); font-size: 13px; }
  .cfa-diagram .connection { margin: 16px 0; color: var(--accent); font-size: 13px; }
  .cfa-diagram .note { margin: 18px 0 0; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .cfa-diagram .takeaway { margin: 22px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.8; font-weight: 600; }
  .signal, .context, .result { padding: 16px; background: var(--paper); border: 1px solid var(--line); }
  .stage { font-size: 11px; color: var(--muted); }
  .cfa-diagram .signal p, .cfa-diagram .result p { margin: 5px 0; font-size: 16px; line-height: 1.7; }
  .arrow { display: block; text-align: center; color: var(--accent); line-height: 1.8; }
  .context ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; list-style: none; }
  .context li { border-left: 2px solid var(--line); padding-left: 10px; font-size: 13px; }
  .context li span { display: block; color: var(--muted); font-size: 12px; }
  .result { border-color: var(--accent); color: var(--accent); }
  .cfa-diagram figcaption { margin-top: 20px; color: var(--muted); font-size: 12px; line-height: 1.8; }
  @media (max-width: 600px) { .journey, .learning-grid, .context ul { grid-template-columns: 1fr; } }
</style>
