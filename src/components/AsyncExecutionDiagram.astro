---
interface Props { kind: 'latency' | 'throughput' | 'blocking' | 'interleaving' | 'compare'; }
const { kind } = Astro.props;
const captions: Record<Props['kind'], string> = {
  latency: '그림 1. 순차 실행과 동시 실행: 대기 구간을 겹치면 가장 느린 작업 시간에 가까워진다',
  throughput: '그림 2. 한 실행이 대기하는 동안 다른 실행을 진행해 처리량을 높인다',
  blocking: '그림 3. 블로킹 호출은 이벤트 루프 스레드를 붙잡고, 다른 작업의 진행을 막는다',
  interleaving: '그림 4. 비동기 I/O에서는 대기 중인 작업이 실행권을 돌려준다',
  compare: '그림 5. 동시성과 병렬성은 서로 다른 질문에 답한다',
}[kind];
---
<figure class="async-diagram" data-kind={kind}>
  <figcaption>{captions[kind]}</figcaption>
  {kind === 'latency' && <div class="lanes"><section class="lane-group"><h3>순차 실행 <span>약 6초</span></h3><div class="lane"><strong>문서 검색</strong><i>요청 · 대기 · 응답</i></div><div class="lane offset-1"><strong>웹 검색</strong><i>요청 · 대기 · 응답</i></div><div class="lane offset-2"><strong>DB 조회</strong><i>요청 · 대기 · 응답</i></div></section><section class="lane-group"><h3>동시 실행 <span>약 2초</span></h3><div class="lane"><strong>문서 검색</strong><i>요청 · 대기 · 응답</i></div><div class="lane"><strong>웹 검색</strong><i>요청 · 대기 · 응답</i></div><div class="lane"><strong>DB 조회</strong><i>요청 · 대기 · 응답</i></div></section></div>}
  {kind === 'throughput' && <ol class="run-stack"><li><strong>실행 A</strong><span>LLM 요청</span><i>대기</i><span>재개</span></li><li class="shift-1"><strong>실행 B</strong><span>DB 질의</span><i>대기</i><span>재개</span></li><li class="shift-2"><strong>실행 C</strong><span>Redis 읽기</span><i>대기</i><span>재개</span></li></ol>}
  {kind === 'blocking' && <div class="blocking"><div>외부 서비스 호출</div><b>↓</b><div class="blocked">이벤트 루프 스레드가 응답까지 대기</div><b>↓</b><div class="muted">그동안 같은 스레드의 다른 코루틴도 진행하지 못함</div></div>}
  {kind === 'interleaving' && <ol class="run-stack"><li><strong>작업 A</strong><span>LLM 요청</span><i>응답 대기 · 실행권 양보</i><span>재개</span></li><li class="shift-1"><strong>작업 B</strong><span>DB 질의</span><i>응답 대기 · 실행권 양보</i><span>재개</span></li><li class="shift-2"><strong>작업 C</strong><span>Redis 읽기</span><i>응답 대기 · 실행권 양보</i><span>재개</span></li></ol>}
  {kind === 'compare' && <div class="comparison"><section><h3>동시성</h3><p>여러 작업이 같은 시간 구간에 번갈아 진행되는가?</p><small>대표 사례: 비동기 I/O, 하나의 이벤트 루프</small></section><section><h3>병렬성</h3><p>여러 작업이 실제로 서로 다른 연산 자원에서 동시에 실행되는가?</p><small>대표 사례: 여러 CPU 코어, 별도 프로세스, GPU</small></section></div>}
</figure>
<style>
.async-diagram{margin:2rem 0;padding:1.25rem;border:1px solid var(--line);background:var(--paper-deep);color:var(--ink);font-family:var(--sans)}figcaption{margin-bottom:1rem;font-weight:700;line-height:1.5}.lanes,.comparison{display:grid;gap:1rem;grid-template-columns:repeat(2,minmax(0,1fr))}.lane-group,.comparison section{padding:1rem;border:1px solid var(--line);background:var(--paper)}.lane-group h3,.comparison h3{display:flex;justify-content:space-between;gap:.5rem;margin:0 0 .75rem;font-size:.95rem}.lane-group h3 span{color:var(--muted);font-size:.82rem;font-weight:500}.lane{display:grid;grid-template-columns:5.5rem minmax(0,1fr);gap:.5rem;align-items:center;margin-top:.5rem;font-size:.82rem}.lane i,.run-stack i{padding:.38rem .5rem;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 10%,var(--paper));font-style:normal;color:var(--muted)}.offset-1{margin-left:14%}.offset-2{margin-left:28%}.run-stack{display:grid;gap:.6rem;margin:0;padding:0;list-style:none}.run-stack li{display:grid;grid-template-columns:4.5rem minmax(4rem,.8fr) minmax(7rem,1.5fr) minmax(3rem,.6fr);gap:.45rem;align-items:center;padding:.7rem;border:1px solid var(--line);background:var(--paper);font-size:.82rem}.run-stack li>span{text-align:center}.shift-1{margin-left:8%}.shift-2{margin-left:16%}.blocking{display:grid;justify-items:center;gap:.55rem;text-align:center;font-size:.88rem}.blocking div{width:min(100%,32rem);padding:.75rem;border:1px solid var(--line);background:var(--paper)}.blocked{border-color:var(--accent)!important;font-weight:700}.muted{color:var(--muted)}.comparison p{margin:0;font-weight:600;line-height:1.5}.comparison small{display:block;margin-top:.65rem;color:var(--muted);line-height:1.5}@media(max-width:640px){.async-diagram{padding:1rem}.lanes,.comparison{grid-template-columns:1fr}.offset-1,.offset-2,.shift-1,.shift-2{margin-left:0}.run-stack li{grid-template-columns:4.5rem 1fr}.run-stack li i{grid-column:2}.run-stack li>span:last-child{grid-column:2;text-align:left}}@media(prefers-color-scheme:dark){.async-diagram{--paper:#202720;--paper-deep:#171d19;--ink:#edf1e9;--muted:#b8c3b6;--line:#465347;--accent:#a0ceac}}
</style>