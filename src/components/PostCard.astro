---
import type { CollectionEntry } from 'astro:content';
import { postPath, sectionPath, subsectionPath } from '../consts';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const date = post.data.publishedDate.toLocaleDateString(post.data.language === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class:list={['post-card', { featured }]}>
  {post.data.draft && <span class="draft-label">Preview draft</span>}
  <div class="post-meta">
    <a href={`/${sectionPath(post.data.section)}/`}>{post.data.section}</a>
    <span aria-hidden="true">/</span>
    <a href={`/${sectionPath(post.data.section)}/${subsectionPath(post.data.section, post.data.subsection)}/`}>{post.data.subsection}</a>
    <span aria-hidden="true">/</span>
    <span>{post.data.contentType}</span>
    <span aria-hidden="true">/</span>
    <time datetime={post.data.publishedDate.toISOString()}>{date}</time>
  </div>
  <h3><a href={postPath(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={postPath(post)} aria-label={post.data.language === 'ko' ? `${post.data.title} 읽기` : `Read ${post.data.title}`}>
    {post.data.language === 'ko' ? '글 읽기' : 'Read article'} <span>↗</span>
  </a>
</article>
