---
import type { CollectionEntry } from 'astro:content';
import { categoryPath, postPath } from '../consts';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const date = post.data.publishedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});
---

<article class:list={['post-card', { featured }]}>
  <div class="post-meta">
    <a href={`/${categoryPath(post.data.category)}/`}>{post.data.category}</a>
    <span aria-hidden="true">/</span>
    <time datetime={post.data.publishedDate.toISOString()}>{date}</time>
  </div>
  <h3><a href={postPath(post.id)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <a class="text-link" href={postPath(post.id)} aria-label={`Read ${post.data.title}`}>Read note <span>↗</span></a>
</article>
