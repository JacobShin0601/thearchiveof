---
interface Props {
  variant: 'productization' | 'leverage' | 'margin' | 'stack' | 'vc' | 'reflection-flywheel' | 'treadmills';
  language: 'ko' | 'en';
}

const { variant, language } = Astro.props;
const ko = language === 'ko';

const copy = ko ? {
  productization: {
    title: '현장 작업은 어디에 남는가?',
    left: ['새 프로젝트', '새 엔지니어 투입', '고객별 산출물', '다음 프로젝트에서 반복'],
    right: ['고객 배포', '예외와 패턴 학습', '제품 기능으로 일반화', '다음 배포의 시간·인력 감소'],
    caption: 'Conceptual · 둘의 차이는 현장에 사람이 들어가느냐보다, 현장에서 한 일이 다음 고객에게 얼마나 남느냐에 있다.',
  },
  leverage: {
    title: '매출과 FDE 인원은 같은 속도로 늘어나는가?',
    caption: 'Conceptual · Wonderful의 실측 추이가 아니다. 소프트웨어형 operating leverage가 나타나는지 판단하기 위한 두 가지 가설이다.',
  },
  margin: {
    title: '중요한 것은 오늘의 margin보다 방향일 수 있다',
    stages: ['Services-heavy 시작', '제품화된 delivery', 'Software leverage'],
    caption: 'Conceptual · Wonderful의 과거 gross-margin 시계열이 아니다. 현재 52%는 WSJ가 2026년 9월 보도한 단일 시점의 회사 전체 수치다.',
  },
  stack: {
    title: 'FDE가 value chain에서 놓이는 위치가 다르다',
    wonderful: ['고객 workflow', 'FDE', '재사용 가능한 platform', 'Enterprise AI OS'],
    reflection: ['Open model', 'Open core stack', 'AI Factory · FDE', 'Paid enterprise · sovereign solutions'],
    caption: 'Author’s framework · Wonderful의 FDE는 field learning을 platform에 남겨야 하고, Reflection의 FDE는 open model을 반복 가능한 commercial stack과 paid deployment로 연결해야 한다.',
  },
  vc: {
    title: '투자자가 가격에 넣고 있는 미래',
    wonderful: ['매출 성장', '제품화', 'margin expansion', 'deployment learning', 'operating leverage'],
    reflection: ['frontier capability', 'distribution', 'paid conversion', 'reusable commercial stack', 'capital leverage'],
    caption: 'Author’s framework · 정식 가치평가 공식이나 투자 의견이 아니라, 두 valuation에 내재했을 수 있는 가설을 분리한 그림이다.',
  },
  'reflection-flywheel': {
    title: 'Open intelligence가 economic capture로 이어지는가?',
    stages: ['Frontier-quality open model', 'Developer · enterprise adoption', 'Customization · deployment', 'Open core stack의 표준화', 'AI Factory · sovereign deployment', 'Paid platform · infrastructure · solutions', 'Usage · real-world feedback'],
    caption: 'Author’s framework · Reflection이 공개한 full-stack 구조를 투자 관점의 flywheel로 재구성했다. 각 단계의 conversion과 economics는 공개되지 않았다.',
  },
  treadmills: {
    title: '두 회사가 탈출해야 하는 treadmill',
    wonderful: ['More customers', 'More FDEs', 'More revenue', '다시 더 많은 고객'],
    reflection: ['Better model', 'More compute', 'Next better model', '다시 더 많은 compute'],
    leftResult: 'Labor treadmill',
    rightResult: 'Compute treadmill',
    caption: 'Conceptual · Wonderful은 productization으로 labor intensity를 낮춰야 하고, Reflection은 distribution·monetization·ecosystem compounding으로 모델 세대마다 경제적 자산을 남겨야 한다.',
  },
} : {
  productization: {
    title: 'Where does fieldwork accumulate?',
    left: ['New project', 'New engineers', 'Customer-specific output', 'Repeat for the next project'],
    right: ['Customer deployment', 'Learn edge cases', 'Generalize into product', 'Reduce time and labor next time'],
    caption: 'Conceptual · The key distinction is not whether people work on-site, but how much of their work remains reusable for the next customer.',
  },
  leverage: {
    title: 'Do revenue and FDE headcount scale at the same rate?',
    caption: 'Conceptual · These are not Wonderful’s measured curves. They are two hypotheses for testing whether software-like operating leverage appears.',
  },
  margin: {
    title: 'Direction may matter more than today’s margin',
    stages: ['Services-heavy start', 'Productized delivery', 'Software leverage'],
    caption: 'Conceptual · This is not Wonderful’s historical gross-margin series. The 52% marker is a single company-wide figure reported by the WSJ in September 2026.',
  },
  stack: {
    title: 'FDE sits at a different point in each value chain',
    wonderful: ['Customer workflow', 'FDE', 'Reusable platform', 'Enterprise AI OS'],
    reflection: ['Open model', 'Open core stack', 'AI Factory · FDE', 'Paid enterprise · sovereign solutions'],
    caption: 'Author’s framework · Wonderful’s FDEs must return field learning to the platform. Reflection’s must connect open models to a reusable commercial stack and paid deployments.',
  },
  vc: {
    title: 'The futures investors may be pricing in',
    wonderful: ['Revenue growth', 'Productization', 'Margin expansion', 'Deployment learning', 'Operating leverage'],
    reflection: ['Frontier capability', 'Distribution', 'Paid conversion', 'Reusable commercial stack', 'Capital leverage'],
    caption: 'Author’s framework · This is neither a formal valuation formula nor an investment view. It separates the hypotheses that may sit inside each valuation.',
  },
  'reflection-flywheel': {
    title: 'Can open intelligence become economic capture?',
    stages: ['Frontier-quality open model', 'Developer and enterprise adoption', 'Customization and deployment', 'Open core becomes a standard', 'AI Factory and sovereign deployment', 'Paid platform, infrastructure, and solutions', 'Usage and real-world feedback'],
    caption: 'Author’s framework · Reflection’s disclosed full stack is recast as an investment flywheel. Conversion and unit economics at each step are not public.',
  },
  treadmills: {
    title: 'The two treadmills these companies must escape',
    wonderful: ['More customers', 'More FDEs', 'More revenue', 'Back to more customers'],
    reflection: ['Better model', 'More compute', 'Next better model', 'Back to more compute'],
    leftResult: 'Labor treadmill',
    rightResult: 'Compute treadmill',
    caption: 'Conceptual · Wonderful must reduce labor intensity through productization. Reflection must leave distribution, monetization, and ecosystem assets behind after each model generation.',
  },
};

const labels = ko ? {
  si: 'Traditional SI', fde: 'FDE software hypothesis',
  people: 'FDE headcount', revenue: 'Revenue',
  services: 'Scenario A · 노동집약도 유지', software: 'Scenario B · operating leverage',
  lower: '낮음', higher: '높음', reported: '현재 보도치 52%',
} : {
  si: 'Traditional SI', fde: 'FDE software hypothesis',
  people: 'FDE headcount', revenue: 'Revenue',
  services: 'Scenario A · labor intensity persists', software: 'Scenario B · operating leverage',
  lower: 'Lower', higher: 'Higher', reported: 'Reported current point: 52%',
};
---

<figure class="fde-figure" aria-label={copy[variant].title}>
  <p class="figure-title">{copy[variant].title}</p>

  {variant === 'productization' && (
    <div class="two-paths">
      <section>
        <h3>{labels.si}</h3>
        {copy.productization.left.map((item, index) => <div class="step"><span>{index + 1}</span>{item}</div>)}
      </section>
      <section class="accent-path">
        <h3>{labels.fde}</h3>
        {copy.productization.right.map((item, index) => <div class="step"><span>{index + 1}</span>{item}</div>)}
      </section>
    </div>
  )}

  {variant === 'leverage' && (
    <div class="chart-wrap">
      <svg viewBox="0 0 720 390" role="img" aria-label={copy.leverage.title}>
        <path class="axis" d="M70 35 V325 H670"></path>
        <path class="headcount" d="M92 300 L625 90"></path>
        <path class="scenario-a" d="M92 300 L625 88"></path>
        <path class="scenario-b" d="M92 300 C250 278 360 218 450 145 S570 58 625 46"></path>
        <text x="12" y="45">{labels.revenue}</text>
        <text x="545" y="365">{labels.people}</text>
        <text class="a-label" x="405" y="238">{labels.services}</text>
        <text class="b-label" x="310" y="112">{labels.software}</text>
      </svg>
      <div class="legend"><span class="legend-a">{labels.services}</span><span class="legend-b">{labels.software}</span></div>
    </div>
  )}

  {variant === 'margin' && (
    <div class="margin-chart">
      <div class="margin-scale"><span>{labels.higher}</span><span>{labels.lower}</span></div>
      <svg viewBox="0 0 720 300" role="img" aria-label={copy.margin.title}>
        <path class="grid" d="M45 45 H680 M45 145 H680 M45 245 H680"></path>
        <path class="margin-line" d="M70 235 C220 230 265 184 360 163 S520 112 655 62"></path>
        <circle cx="245" cy="191" r="7"></circle>
        <text x="260" y="188">{labels.reported}</text>
      </svg>
      <div class="stages">{copy.margin.stages.map((item) => <span>{item}</span>)}</div>
    </div>
  )}

  {variant === 'stack' && (
    <div class="value-stacks">
      <section>
        <h3>Wonderful</h3>
        {copy.stack.wonderful.map((item) => <div>{item}</div>)}
      </section>
      <section class="reflection-stack">
        <h3>Reflection</h3>
        {copy.stack.reflection.map((item) => <div>{item}</div>)}
      </section>
    </div>
  )}

  {variant === 'vc' && (
    <div class="vc-columns">
      <section><h3>Wonderful</h3>{copy.vc.wonderful.map((item) => <span>{item}</span>)}</section>
      <section><h3>Reflection</h3>{copy.vc.reflection.map((item) => <span>{item}</span>)}</section>
    </div>
  )}

  {variant === 'reflection-flywheel' && (
    <div class="flywheel-grid">
      {copy['reflection-flywheel'].stages.map((item, index) => <div class="loop-step"><span>{index + 1}</span><strong>{item}</strong></div>)}
      <div class="loop-return">↺ {ko ? '더 나은 모델과 stack으로 환류' : 'Feeds the next model and stack'}</div>
    </div>
  )}

  {variant === 'treadmills' && (
    <div class="treadmill-grid">
      <section>
        <h3>Wonderful</h3>
        {copy.treadmills.wonderful.map((item) => <div class="treadmill-step">{item}<span>↓</span></div>)}
        <strong class="treadmill-result">{copy.treadmills.leftResult}</strong>
      </section>
      <section>
        <h3>Reflection</h3>
        {copy.treadmills.reflection.map((item) => <div class="treadmill-step">{item}<span>↓</span></div>)}
        <strong class="treadmill-result reflection-result">{copy.treadmills.rightResult}</strong>
      </section>
    </div>
  )}

  <figcaption>{copy[variant].caption}</figcaption>
</figure>

<style>
  .fde-figure{margin:2rem 0;padding:1.25rem;border:1px solid var(--line);background:var(--paper-deep);font-family:var(--sans);font-size:.82rem;line-height:1.5}.figure-title{margin:0 0 1.1rem;font-weight:800;color:var(--ink)}.fde-figure figcaption{margin-top:1rem;color:var(--muted);font-size:.74rem}.two-paths,.value-stacks,.vc-columns,.treadmill-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.two-paths section,.value-stacks section,.vc-columns section,.treadmill-grid section{padding:1rem;border:1px solid var(--line);background:var(--paper)}.fde-figure h3{margin:0 0 .8rem;font-size:.8rem}.step{display:flex;align-items:center;gap:.65rem;margin:.45rem 0;padding:.58rem;border:1px solid var(--line);background:var(--paper-deep)}.step span{display:grid;place-items:center;flex:none;width:22px;height:22px;border-radius:50%;background:var(--ink);color:var(--paper);font-size:.66rem}.accent-path .step span{background:var(--accent)}.accent-path .step:not(:last-child)::after,.value-stacks section div:not(:last-child)::after{content:'↓';margin-left:auto;color:var(--muted)}.chart-wrap svg,.margin-chart svg{display:block;width:100%;height:auto;background:var(--paper)}.axis,.grid{fill:none;stroke:var(--line);stroke-width:1.5}.headcount{fill:none;stroke:var(--line);stroke-width:7;stroke-dasharray:5 7}.scenario-a{fill:none;stroke:#9b5038;stroke-width:4}.scenario-b{fill:none;stroke:var(--accent);stroke-width:5}.chart-wrap text,.margin-chart text{fill:var(--muted);font:13px var(--sans)}.chart-wrap .a-label{fill:#9b5038}.chart-wrap .b-label{fill:var(--accent);font-weight:700}.legend{display:flex;flex-wrap:wrap;gap:.7rem 1.25rem;justify-content:center;margin-top:.8rem;color:var(--muted);font-size:.72rem}.legend span::before{content:'';display:inline-block;width:22px;height:3px;margin-right:.35rem;vertical-align:middle;background:#9b5038}.legend .legend-b::before{background:var(--accent)}.margin-chart{position:relative;padding-left:36px}.margin-scale{position:absolute;left:0;top:34px;bottom:35px;display:flex;flex-direction:column;justify-content:space-between;color:var(--muted);font-size:.65rem}.margin-line{fill:none;stroke:var(--accent);stroke-width:6}.margin-chart circle{fill:#9b5038}.stages{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:.55rem;text-align:center;color:var(--muted);font-size:.7rem}.value-stacks section div{display:flex;align-items:center;min-height:38px;margin:.45rem 0;padding:.5rem .65rem;border:1px solid var(--line);background:var(--paper-deep)}.value-stacks section div:not(:last-child)::after{margin-left:auto}.reflection-stack div{border-left:3px solid #9b5038!important}.value-stacks section:first-child div{border-left:3px solid var(--accent)}.vc-columns section{display:flex;flex-wrap:wrap;align-content:flex-start;gap:.5rem}.vc-columns h3{width:100%}.vc-columns span{padding:.42rem .65rem;border:1px solid var(--line);background:var(--paper-deep);border-radius:999px;color:var(--muted)}.vc-columns section:first-child span{border-color:color-mix(in srgb,var(--accent) 50%,var(--line))}.vc-columns section:last-child span{border-color:color-mix(in srgb,#9b5038 50%,var(--line))}.flywheel-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem}.loop-step{position:relative;min-height:90px;padding:.75rem;border:1px solid var(--line);background:var(--paper)}.loop-step span{display:block;margin-bottom:.45rem;color:var(--accent);font:700 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.loop-step strong{font-size:.76rem}.loop-return{grid-column:1/-1;padding:.65rem;border:1px dashed color-mix(in srgb,#9b5038 55%,var(--line));color:#8a4634;text-align:center;font-weight:700}.treadmill-step{display:flex;justify-content:space-between;gap:.5rem;margin:.45rem 0;padding:.55rem .65rem;background:var(--paper-deep);border:1px solid var(--line)}.treadmill-step span{color:var(--muted)}.treadmill-result{display:block;margin-top:.7rem;padding:.65rem;background:color-mix(in srgb,var(--accent) 10%,var(--paper));color:var(--accent);text-align:center}.reflection-result{background:color-mix(in srgb,#9b5038 10%,var(--paper));color:#8a4634}
  @media(max-width:640px){.fde-figure{padding:.9rem}.two-paths,.value-stacks,.vc-columns,.treadmill-grid{grid-template-columns:1fr}.flywheel-grid{grid-template-columns:1fr 1fr}.chart-wrap .a-label,.chart-wrap .b-label{display:none}.margin-chart{padding-left:0}.margin-scale{display:none}.margin-chart text{font-size:11px}.stages{font-size:.62rem}.step{padding:.5rem}}
</style>
