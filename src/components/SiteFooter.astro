---
import { SITE_TITLE } from '../consts';
import ArchiveMark from './ArchiveMark.astro';
const year = new Date().getFullYear();
interface Props { language?: 'ko' | 'en' }
const { language = 'ko' } = Astro.props;
---

<footer class="site-footer shell">
  <div class="footer-brand">
    <p class="footer-mark">
      <ArchiveMark variant="orbit" size={26} decorative />
      <span class="wordmark-the">The</span>
      <span class="footer-name">Archive of</span>
    </p>
    <p class="footer-method">Explain → Model → Test → Interpret</p>
  </div>
  <div class="footer-links">
    <a href={language === 'ko' ? '/rss.xml' : '/en/rss.xml'}>RSS</a>
    <a href={language === 'ko' ? '/topics/' : '/en/topics/'}>{language === 'ko' ? '토픽' : 'Topics'}</a>
    <a href={language === 'ko' ? '/series/' : '/en/series/'}>{language === 'ko' ? '시리즈' : 'Series'}</a>
    <a href={language === 'ko' ? '/archive/' : '/en/archive/'}>{language === 'ko' ? '전체 글' : 'Archive'}</a>
    <span>© {year} {SITE_TITLE}</span>
  </div>
</footer>
