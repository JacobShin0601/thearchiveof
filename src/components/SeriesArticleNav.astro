---
import type { CollectionEntry } from 'astro:content';
import { postPath, seriesPath } from '../consts';
import {
  appliedTrackDetailMeta,
  appliedTrackPath,
  isAppliedTrackDetailSeries,
  partMeta,
  seriesUsesParts,
  type SeriesPartId,
} from '../lib/series-sections';

interface Props {
  post: CollectionEntry<'posts'>;
  previousInSeries?: CollectionEntry<'posts'>;
  nextInSeries?: CollectionEntry<'posts'>;
  language: 'ko' | 'en';
}

const { post, previousInSeries, nextInSeries, language } = Astro.props;
const isKo = language === 'ko';
const seriesName = post.data.series;
const currentPart = post.data.seriesPart as SeriesPartId | undefined;
const nextPart = nextInSeries?.data.seriesPart as SeriesPartId | undefined;
const crossesStage =
  seriesUsesParts(seriesName)
  && currentPart
  && nextPart
  && nextPart !== currentPart;
const isLastInSeries = !nextInSeries;
const isAppliedTrack = isAppliedTrackDetailSeries(seriesName);
const appliedTrackParent = isAppliedTrack ? appliedTrackDetailMeta(seriesName!).parentSeries : undefined;
---

<nav class="series-nav" aria-label={`${seriesName} series`}>
  <p class="eyebrow">
    {isAppliedTrack && appliedTrackParent ? (
      <>
        Series ·{' '}
        <a href={seriesPath(appliedTrackParent, language)}>{appliedTrackParent}</a>
        {' / '}
        <a href={appliedTrackPath(seriesName!, language)}>
          {isKo ? 'Inference Serving · vLLM' : 'Inference Serving · vLLM'}
        </a>
      </>
    ) : (
      <>
        Series · <a href={seriesPath(seriesName!, language)}>{seriesName}</a>
      </>
    )}
  </p>
  {crossesStage && nextPart && (
    <p class="series-nav-stage">
      {isKo ? '다음 단계' : 'Next stage'}: {partMeta(nextPart).title[language]}
    </p>
  )}
  <div>
    {previousInSeries ? (
      <a href={postPath(previousInSeries)}>← {previousInSeries.data.title}</a>
    ) : (
      <span></span>
    )}
    {nextInSeries ? (
      <a href={postPath(nextInSeries)}>{nextInSeries.data.title} →</a>
    ) : (
      <span></span>
    )}
  </div>
  {isLastInSeries && seriesName && (
    <p class="series-nav-overview">
      <a href={isAppliedTrack ? appliedTrackPath(seriesName, language) : seriesPath(seriesName, language)}>
        {isKo ? '시리즈 전체 보기' : 'View full series'}
      </a>
    </p>
  )}
</nav>
