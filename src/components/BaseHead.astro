---
import { SITE_TITLE, SITE_URL } from '../consts';
import { resolveSocialImage } from '../lib/social-image';
import { integrations } from '../site.config';
import { personSchema } from '../lib/author';
import { INDEXABLE } from '../environment';
import { resolveSeoLinks } from '../lib/seo-links';

interface Props {
  title: string;
  description: string;
  canonical: URL | null;
  type: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  author?: string;
  section?: string;
  contentType?: string;
  tags?: string[];
  language?: 'ko' | 'en';
  breadcrumbs?: Array<{ name: string; url: string }>;
  alternateLanguageUrl?: string;
  indexable?: boolean;
  socialImage?: string;
}

const {
  title,
  description,
  canonical,
  type,
  publishedDate,
  updatedDate,
  author,
  section,
  contentType,
  tags = [],
  language = 'en',
  breadcrumbs = [],
  alternateLanguageUrl,
  indexable = true,
  socialImage: socialImagePath,
} = Astro.props;
const allowIndex = INDEXABLE && indexable;
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
const { canonicalUrl, alternateUrl, xDefaultUrl } = resolveSeoLinks({
  canonical,
  language,
  alternateLanguageUrl,
});
const socialImage = new URL(resolveSocialImage(socialImagePath), SITE_URL);
const socialImageAlt = type === 'article' ? title : `${SITE_TITLE} — Investing, AI & AX, Lab, Mathematics, Perspectives`;

const articleSchema = type === 'article' && canonicalUrl
  ? {
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      datePublished: publishedDate?.toISOString(),
      dateModified: (updatedDate ?? publishedDate)?.toISOString(),
      author: personSchema(author),
      image: socialImage,
      publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
      articleSection: section,
      keywords: tags.join(', '),
      genre: contentType,
      inLanguage: language,
    }
  : undefined;

const websiteSchema = type === 'website' && canonicalUrl
  ? {
      '@type': 'WebSite',
      name: SITE_TITLE,
      description,
      url: SITE_URL,
    }
  : undefined;

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.url, SITE_URL).toString(),
      })),
    }
  : undefined;

const schemaGraph = [articleSchema ?? websiteSchema, breadcrumbSchema].filter(Boolean);
const schema = schemaGraph.length > 0
  ? {
      '@context': 'https://schema.org',
      '@graph': schemaGraph,
    }
  : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="theme-color" content="#f2f0e9" />
<meta name="robots" content={allowIndex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
{!allowIndex && <meta name="googlebot" content="noindex, nofollow" />}
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
{allowIndex && integrations.googleSiteVerification && (
  <meta name="google-site-verification" content={integrations.googleSiteVerification} />
)}
{language === 'ko' && (
  <link rel="preload" href="/fonts/noto-serif-kr-korean-400.woff2" as="font" type="font/woff2" crossorigin />
)}
<link rel="icon" href="/favicon.svg?v=footer-a" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png?v=footer-a" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=footer-a" />
<link rel="manifest" href="/site.webmanifest" />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{canonicalUrl && <link rel="alternate" hreflang={language} href={canonicalUrl} />}
{alternateUrl && <link rel="alternate" hreflang={language === 'ko' ? 'en' : 'ko'} href={alternateUrl} />}
{xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={language === 'en' ? '/en/rss.xml' : '/rss.xml'} />
<title>{pageTitle}</title>

<meta property="og:type" content={type} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:width" content="1200" />}
{socialImage && <meta property="og:image:height" content="630" />}
{socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
