---
import { SITE_TITLE, SITE_URL } from '../consts';
import { integrations } from '../site.config';
import { INDEXABLE } from '../environment';

interface Props {
  title: string;
  description: string;
  canonical: URL;
  type: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  author?: string;
  section?: string;
  contentType?: string;
  tags?: string[];
  language?: 'ko' | 'en';
  breadcrumbs?: Array<{ name: string; url: string }>;
  alternateLanguageUrl?: string;
  indexable?: boolean;
}

const {
  title,
  description,
  canonical,
  type,
  publishedDate,
  updatedDate,
  author,
  section,
  contentType,
  tags = [],
  language = 'en',
  breadcrumbs = [],
  alternateLanguageUrl,
  indexable = true,
} = Astro.props;
const allowIndex = INDEXABLE && indexable;
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
const canonicalUrl = new URL(canonical.pathname, SITE_URL);
const socialImage = type === 'website' ? new URL('/og.png', SITE_URL) : undefined;

const articleSchema = type === 'article'
  ? {
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      datePublished: publishedDate?.toISOString(),
      dateModified: (updatedDate ?? publishedDate)?.toISOString(),
      author: { '@type': 'Person', name: author ?? 'Jacob Shin' },
      publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
      articleSection: section,
      keywords: tags.join(', '),
      genre: contentType,
      inLanguage: language,
    }
  : undefined;

const websiteSchema = type === 'website'
  ? {
      '@type': 'WebSite',
      name: SITE_TITLE,
      description,
      url: SITE_URL,
    }
  : undefined;

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.url, SITE_URL).toString(),
      })),
    }
  : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [articleSchema ?? websiteSchema, breadcrumbSchema].filter(Boolean),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="theme-color" content="#f2f0e9" />
<meta name="robots" content={allowIndex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
{!allowIndex && <meta name="googlebot" content="noindex, nofollow" />}
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
{allowIndex && integrations.googleSiteVerification && (
  <meta name="google-site-verification" content={integrations.googleSiteVerification} />
)}
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang={language} href={canonicalUrl} />
{alternateLanguageUrl && <link rel="alternate" hreflang={language === 'ko' ? 'en' : 'ko'} href={new URL(alternateLanguageUrl, SITE_URL)} />}
{language === 'ko' && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={language === 'en' ? '/en/rss.xml' : '/rss.xml'} />
<title>{pageTitle}</title>

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:width" content="1200" />}
{socialImage && <meta property="og:image:height" content="630" />}
{socialImage && <meta property="og:image:alt" content={`${SITE_TITLE} — Investing, AI & AX, Lab, Mathematics, Notes`} />}
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
