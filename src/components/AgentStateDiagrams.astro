---
interface Props {
  kind: 'placement' | 'write-read-path' | 'failure' | 'representations' | 'hot-state' | 'redis-keys' | 'read-view' | 'stale-write' | 'framework-map' | 'recovery-contract';
  language?: 'ko' | 'en';
  caption: string;
}

const { kind, language = 'ko', caption } = Astro.props;
const ko = language === 'ko';

const artifacts = ko
  ? [
      ['Durable run record', '소유권 · status · 결과 · 감사', 'PostgreSQL'],
      ['Hot projection', '현재 단계 · 진행률 · heartbeat', 'Redis'],
      ['Execution checkpoint', 'values · 다음 단계 · 완료 작업', 'PostgreSQL 등 내구성 저장소'],
      ['Process-local state', 'client · buffer · coroutine', 'Worker memory'],
    ]
  : [
      ['Durable run record', 'ownership · status · result · audit', 'PostgreSQL'],
      ['Hot projection', 'current step · progress · heartbeat', 'Redis'],
      ['Execution checkpoint', 'values · next steps · completed work', 'Durable store such as PostgreSQL'],
      ['Process-local state', 'clients · buffers · coroutines', 'Worker memory'],
    ];

const failures = ko
  ? [
      ['Worker crash', 'checkpoint에서 재개', 'run record · checkpoint'],
      ['Redis loss', 'projection 재생성', 'run record · checkpoint'],
      ['Stale worker', 'attempt / fencing으로 쓰기 거부', '최신 run record'],
      ['PostgreSQL outage', '성공 처리·queue ack 보류', 'Redis만으로 완료 금지'],
      ['Schema change', 'versioned loader로 이전 snapshot 변환', 'versioned checkpoint'],
    ]
  : [
      ['Worker crash', 'Resume from checkpoint', 'run record · checkpoint'],
      ['Redis loss', 'Rebuild the projection', 'run record · checkpoint'],
      ['Stale worker', 'Reject writes with attempt / fencing', 'latest run record'],
      ['PostgreSQL outage', 'Withhold success and queue ack', 'Redis cannot prove completion'],
      ['Schema change', 'Migrate with a versioned loader', 'versioned checkpoint'],
    ];
---

<figure class="state-diagram" aria-label={caption}>
  {kind === 'placement' && (
    <div class="placement">
      <header>
        <span>{ko ? '먼저 묻는다' : 'Ask first'}</span>
        <strong>{ko ? '이 값은 어떤 실패를 견뎌야 하는가?' : 'Which failures must this value survive?'}</strong>
      </header>
      <ol aria-label={ko ? '상태 artifact와 물리적 저장 위치' : 'State artifacts and physical storage'}>
        {artifacts.map(([name, meaning, location], index) => (
          <li>
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{name}</strong>
              <small>{meaning}</small>
            </div>
            <i aria-hidden="true">→</i>
            <b>{location}</b>
          </li>
        ))}
      </ol>
      <p>
        {ko
          ? 'Checkpoint는 제품명이 아니라 재개 가능한 snapshot이라는 의미다.'
          : 'A checkpoint is a resumable snapshot, not the name of a storage product.'}
      </p>
    </div>
  )}

  {kind === 'write-read-path' && (
    <div class="paths">
      <section>
        <span class="eyebrow">{ko ? '쓰기 경로' : 'Write path'}</span>
        <ol>
          <li><b>1</b><strong>Redis</strong><small>{ko ? '실행 중 progress' : 'in-flight progress'}</small></li>
          <li><b>2</b><strong>{ko ? 'Checkpoint store' : 'Checkpoint store'}</strong><small>{ko ? '안전한 재개 지점' : 'safe resume point'}</small></li>
          <li><b>3</b><strong>PostgreSQL</strong><small>{ko ? '최종 결과 commit' : 'commit terminal result'}</small></li>
          <li><b>4</b><strong>Redis</strong><small>{ko ? '종료 projection 정리' : 'reconcile terminal projection'}</small></li>
        </ol>
        <p>{ko ? '최종 결과 commit 전에는 성공으로 ack하지 않는다.' : 'Do not acknowledge success before the terminal result commits.'}</p>
      </section>
      <section>
        <span class="eyebrow">{ko ? '조회 경로' : 'Read path'}</span>
        <ol>
          <li><b>1</b><strong>PostgreSQL</strong><small>{ko ? '권한·durable status 확인' : 'authorization and durable status'}</small></li>
          <li><b>2</b><strong>Redis</strong><small>{ko ? '활성 run만 progress 보강' : 'enrich active runs with progress'}</small></li>
          <li><b>3</b><strong>API</strong><small>{ko ? 'terminal status는 DB 우선' : 'durable terminal status wins'}</small></li>
        </ol>
        <p>{ko ? 'Redis timeout이나 miss는 제한 모드이지 run 소실이 아니다.' : 'A Redis timeout or miss is degraded mode, not a missing run.'}</p>
      </section>
    </div>
  )}

  {kind === 'failure' && (
    <div class="failure">
      <div class="failure-head" aria-hidden="true">
        <span>{ko ? '실패' : 'Failure'}</span>
        <span>{ko ? '복구 행동' : 'Recovery action'}</span>
        <span>{ko ? '남아 있어야 할 근거' : 'Evidence that must remain'}</span>
      </div>
      <ul>
        {failures.map(([name, action, remains]) => (
          <li>
            <strong>{name}</strong>
            <span>{action}</span>
            <small>{remains}</small>
          </li>
        ))}
      </ul>
    </div>
  )}


  {kind === 'representations' && (
    <div class="representations">
      <article>
        <span>01 · PostgreSQL</span>
        <strong>Durable Run Record</strong>
        <p>{ko ? '누가 요청했고 어떻게 끝났는지 남기는 공식 기록' : 'The official record of ownership and outcome'}</p>
        <small>{ko ? 'run · identity · status · result · audit' : 'run · identity · status · result · audit'}</small>
      </article>
      <article>
        <span>02 · Redis</span>
        <strong>Hot Projection</strong>
        <p>{ko ? '화면과 운영 도구가 즉시 읽는 현재 상태' : 'The current view for UI and operations'}</p>
        <small>{ko ? 'current step · progress · heartbeat' : 'current step · progress · heartbeat'}</small>
      </article>
      <article>
        <span>03 · Durable store</span>
        <strong>Execution Checkpoint</strong>
        <p>{ko ? '새 Worker가 이어서 실행할 수 있는 안전한 재개 지점' : 'A safe resume point for a new worker'}</p>
        <small>{ko ? 'values · next nodes · completed work' : 'values · next nodes · completed work'}</small>
      </article>
    </div>
  )}

  {kind === 'hot-state' && (
    <div class="hot-state">
      <header><span>Redis Hash</span><code>agent:run:&#123;run_id&#125;:state</code></header>
      <dl>
        <div><dt>status</dt><dd>running</dd></div>
        <div><dt>current_step</dt><dd>apply_rules</dd></div>
        <div><dt>progress</dt><dd>65%</dd></div>
        <div><dt>attempt_id · version</dt><dd>4fe… · 18</dd></div>
        <div><dt>heartbeat_at</dt><dd>2026-10-04 04:10Z</dd></div>
        <div><dt>detail_json</dt><dd>{'{ policy, rules_checked }'}</dd></div>
      </dl>
    </div>
  )}

  {kind === 'redis-keys' && (
    <div class="redis-keys">
      <code>agent:run:&#123;run_id&#125;:state</code>
      <code>agent:run:&#123;run_id&#125;:lease</code>
      <code>agent:run:&#123;run_id&#125;:cancel</code>
      <p>{ko ? '같은 Run의 관련 key를 함께 다룰 때는 &#123;run_id&#125; hash tag가 같은 Cluster slot 배치를 돕는다.' : 'The {run_id} hash tag keeps related keys in the same Cluster slot.'}</p>
    </div>
  )}

  {kind === 'read-view' && (
    <div class="read-view">
      <div><b>1</b><strong>GET /runs/&#123;run_id&#125;</strong><small>{ko ? '요청 수신' : 'request'}</small></div>
      <div><b>2</b><strong>PostgreSQL</strong><small>{ko ? '권한 · 영속 status · 결과 확인' : 'authorization · durable status · result'}</small></div>
      <div><b>3</b><strong>Redis</strong><small>{ko ? '활성 Run에만 step · progress 보강' : 'active Run: add step · progress'}</small></div>
      <div><b>4</b><strong>Response</strong><small>{ko ? '종료 상태는 DB를 우선' : 'terminal status: DB wins'}</small></div>
    </div>
  )}

  {kind === 'stale-write' && (
    <div class="stale-write">
      <article class="latest"><span>현재 값</span><strong>Worker A · version 19</strong><b>progress 70%</b></article>
      <i aria-hidden="true">vs</i>
      <article class="stale"><span>늦게 도착</span><strong>Worker B · version 18</strong><b>progress 60%</b></article>
      <p>{ko ? 'version 또는 fencing token이 없으면 60%가 70%를 덮을 수 있다.' : 'Without a version or fencing token, 60% can overwrite 70%.'}</p>
    </div>
  )}

  {kind === 'framework-map' && (
    <div class="framework-map">
      <div><strong>{ko ? '이 글의 개념' : 'This article'}</strong><strong>LangGraph</strong></div>
      <div><span>{ko ? 'Run의 업무 기록' : 'Run business record'}</span><b>Application PostgreSQL tables</b></div>
      <div><span>{ko ? '재개 가능한 graph snapshot' : 'Resumable graph snapshot'}</span><b>Checkpointer</b></div>
      <div><span>{ko ? 'thread 밖 장기 메모리' : 'Long-term memory outside a thread'}</span><b>Store</b></div>
      <div><span>{ko ? '현재 progress 투영값' : 'Current progress projection'}</span><b>Application-managed Redis State</b></div>
      <div><span>{ko ? '프로세스 안의 임시 상태' : 'Process-local temporary State'}</span><b>Runtime memory</b></div>
    </div>
  )}

  {kind === 'recovery-contract' && (
    <div class="recovery-contract">
      <article><strong>PostgreSQL</strong><p>{ko ? '공식 기록' : 'Durable truth'}</p><small>run · identity · status · result · audit</small></article>
      <article><strong>Redis Hash</strong><p>{ko ? '실시간 투영값' : 'Hot projection'}</p><small>current step · progress · heartbeat</small></article>
      <article><strong>Checkpoint</strong><p>{ko ? '재개용 snapshot' : 'Resume snapshot'}</p><small>values · next nodes · completed work</small></article>
      <article><strong>Worker memory</strong><p>{ko ? '버려도 되는 실행 객체' : 'Disposable runtime objects'}</p><small>client · buffer · coroutine</small></article>
    </div>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .state-diagram {
    margin: 2.4rem 0;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--paper-deep);
    color: var(--ink);
    font-family: var(--sans);
  }

  .state-diagram figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .placement {
    display: grid;
    gap: 0.85rem;
  }

  .placement header {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem;
    border-left: 3px solid var(--accent);
    background: var(--paper);
  }

  .placement header span,
  .eyebrow {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .placement ol,
  .paths ol,
  .failure ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .placement ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .placement li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto minmax(7rem, 0.8fr);
    gap: 0.55rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--paper);
  }

  .placement li div {
    display: grid;
    gap: 0.15rem;
  }

  .number {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .placement strong,
  .placement b {
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .placement small {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .placement i {
    color: var(--accent);
    font-style: normal;
  }

  .placement > p {
    margin: 0;
    padding: 0.65rem;
    border: 1px dashed var(--accent);
    border-radius: 0.55rem;
    font-size: 0.8rem;
    text-align: center;
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .paths section {
    display: grid;
    gap: 0.7rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--paper);
  }

  .paths ol {
    display: grid;
    gap: 0.4rem;
  }

  .paths li {
    display: grid;
    grid-template-columns: 1.5rem minmax(6.5rem, 0.75fr) minmax(0, 1fr);
    gap: 0.45rem;
    align-items: center;
    padding: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .paths li b {
    color: var(--accent);
    font-size: 0.72rem;
  }

  .paths li strong {
    font-size: 0.8rem;
  }

  .paths li small {
    color: var(--muted);
    font-size: 0.74rem;
  }

  .paths p {
    margin: 0;
    padding: 0.55rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .failure {
    display: grid;
    gap: 0.35rem;
  }

  .failure-head,
  .failure li {
    display: grid;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(10rem, 1.2fr) minmax(9rem, 1fr);
    gap: 0.7rem;
    align-items: center;
  }

  .failure-head {
    padding: 0 0.7rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .failure li {
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background: var(--paper);
  }

  .failure li:nth-child(4) {
    border-style: dashed;
    border-width: 2px;
  }

  .failure strong {
    font-size: 0.8rem;
  }

  .failure span,
  .failure small {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .failure small {
    color: var(--muted);
  }


  .representations,
  .recovery-contract {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .representations article,
  .recovery-contract article,
  .stale-write article {
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--paper);
  }

  .representations span,
  .hot-state header span,
  .stale-write span {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .representations strong,
  .recovery-contract strong,
  .stale-write strong {
    font-size: 0.9rem;
  }

  .representations p,
  .recovery-contract p,
  .stale-write p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .representations small,
  .recovery-contract small {
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .hot-state {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--paper);
  }

  .hot-state header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .hot-state code,
  .redis-keys code {
    overflow-wrap: anywhere;
    color: var(--ink);
    font-size: 0.72rem;
  }

  .hot-state dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .hot-state dl div {
    display: grid;
    gap: 0.2rem;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .hot-state dl div:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .hot-state dt {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .hot-state dd {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
  }

  .redis-keys {
    display: grid;
    gap: 0.5rem;
  }

  .redis-keys code {
    padding: 0.7rem 0.8rem;
    border-left: 3px solid var(--accent);
    background: var(--paper);
  }

  .redis-keys p {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .read-view {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .read-view div {
    position: relative;
    display: grid;
    gap: 0.25rem;
    min-height: 5.7rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--paper);
  }

  .read-view div:not(:last-child)::after {
    position: absolute;
    right: -0.45rem;
    top: 50%;
    z-index: 1;
    color: var(--accent);
    content: '→';
    font-weight: 800;
  }

  .read-view b {
    color: var(--accent);
    font-size: 0.72rem;
  }

  .read-view strong { font-size: 0.78rem; }
  .read-view small { color: var(--muted); font-size: 0.7rem; line-height: 1.4; }

  .stale-write {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.65rem;
    align-items: center;
  }

  .stale-write article { min-height: 5.4rem; }
  .stale-write .latest { border-color: var(--accent); }
  .stale-write .stale { border-style: dashed; }
  .stale-write b { font-size: 0.8rem; }
  .stale-write > i { color: var(--muted); font-style: normal; font-size: 0.75rem; }
  .stale-write > p { grid-column: 1 / -1; padding: 0.6rem; border-left: 3px solid var(--accent); }

  .framework-map {
    display: grid;
    gap: 0.35rem;
  }

  .framework-map div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 1fr);
    gap: 0.65rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--paper);
  }

  .framework-map div:first-child {
    background: var(--paper-deep);
    color: var(--muted);
    font-size: 0.7rem;
  }

  .framework-map span,
  .framework-map b {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .framework-map b { font-weight: 700; }

  .recovery-contract {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .recovery-contract article {
    min-height: 6.4rem;
  }

  @media (max-width: 760px) {
    .placement ol,
    .paths,
    .representations,
    .recovery-contract {
      grid-template-columns: 1fr;
    }

    .read-view {
      grid-template-columns: 1fr;
    }

    .read-view div:not(:last-child)::after {
      right: auto;
      left: 1rem;
      top: auto;
      bottom: -0.72rem;
      content: '↓';
    }

    .framework-map div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .failure-head {
      display: none;
    }

    .failure li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .failure li span::before {
      content: '→ ';
      color: var(--accent);
      font-weight: 800;
    }
  }

  @media (max-width: 480px) {
    .state-diagram {
      padding: 0.85rem;
    }

    .placement li {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .placement li i {
      display: none;
    }

    .placement li b {
      grid-column: 2;
      padding-top: 0.3rem;
      border-top: 1px dashed var(--line);
    }

    .paths li {
      grid-template-columns: 1.5rem 1fr;
    }

    .hot-state header {
      display: grid;
    }

    .hot-state dl {
      grid-template-columns: 1fr;
    }

    .hot-state dl div:nth-child(odd) {
      border-right: 0;
    }

    .stale-write {
      grid-template-columns: 1fr;
    }

    .stale-write > i {
      justify-self: center;
    }

    .paths li small {
      grid-column: 2;
    }
  }

  @media (prefers-color-scheme: dark) {
    .state-diagram {
      --paper: #202720;
      --paper-deep: #171d19;
      --ink: #edf1e9;
      --muted: #b8c3b6;
      --line: #465347;
      --accent: #a0ceac;
    }
  }
</style>
