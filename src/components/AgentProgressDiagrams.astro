---
interface Props {
  kind: 'planes' | 'contract' | 'reconnect' | 'aggregation';
  language?: 'ko' | 'en';
  caption: string;
}

const { kind, language = 'ko', caption } = Astro.props;
const ko = language === 'ko';

const contractRows = ko
  ? [
      ['Identity', 'event_id · run_id · child_run_id'],
      ['Ordering', 'attempt · seq · occurred_at'],
      ['Meaning', 'type · stage · status · payload'],
      ['Exposure', 'visibility · sensitivity · schema_version'],
    ]
  : [
      ['Identity', 'event_id · run_id · child_run_id'],
      ['Ordering', 'attempt · seq · occurred_at'],
      ['Meaning', 'type · stage · status · payload'],
      ['Exposure', 'visibility · sensitivity · schema_version'],
    ];
---

<figure class="progress-diagram" aria-label={caption}>
  {kind === 'planes' && (
    <div class="planes">
      <header><span>{ko ? '전달면' : 'Plane'}</span><span>{ko ? '무엇을 말하나' : 'What it means'}</span><span>{ko ? '수명' : 'Lifetime'}</span></header>
      <section class="token"><strong>Token stream</strong><p>{ko ? '모델이 지금 생성한 텍스트 조각' : 'Text fragments the model emits now'}</p><code>token.delta</code><i>{ko ? '일시적 · 합칠 수 있음' : 'ephemeral · coalescible'}</i></section>
      <section class="progress"><strong>Progress events</strong><p>{ko ? '실행 상태가 실제로 바뀐 사실' : 'Facts about execution state changes'}</p><code>step.started · approval.required</code><i>{ko ? '내구성 · 재생 가능' : 'durable · replayable'}</i></section>
      <section class="result"><strong>Result</strong><p>{ko ? '확정된 최종 산출물과 terminal state' : 'Committed output and terminal state'}</p><code>run.completed → result_ref</code><i>{ko ? '정본 · 조회 가능' : 'canonical · queryable'}</i></section>
      <footer>{ko ? '연결이 살아 있다는 사실도, token이 흐른다는 사실도, 작업 완료를 뜻하지 않는다.' : 'A live connection and flowing tokens are neither proof that work is progressing nor that it is complete.'}</footer>
    </div>
  )}

  {kind === 'contract' && (
    <div class="contract">
      <div class="envelope">
        <span>ProgressEvent v1</span>
        {contractRows.map(([label, fields]) => <section><strong>{label}</strong><code>{fields}</code></section>)}
      </div>
      <div class="gate">
        <strong>{ko ? 'Public projection' : 'Public projection'}</strong>
        <p>{ko ? '허용된 event type과 payload만 UI로 투영' : 'Only allowed event types and payloads reach the UI'}</p>
        <code>visibility == "user"</code>
      </div>
      <div class="ui"><span>{ko ? '상태 배지' : 'Status'}</span><span>{ko ? '단계 타임라인' : 'Timeline'}</span><span>{ko ? '승인 요청' : 'Approval'}</span><span>{ko ? '최종 결과' : 'Result'}</span></div>
    </div>
  )}

  {kind === 'reconnect' && (
    <div class="reconnect">
      <div class="timeline"><span><b>41</b> step.started</span><span><b>42</b> tool.completed</span><em>{ko ? '연결 끊김' : 'disconnect'}</em><span><b>43</b> step.completed</span><span><b>44</b> run.completed</span></div>
      <div class="resume"><code>Last-Event-ID: 42</code><i>→</i><strong>{ko ? '43부터 durable event 재생' : 'Replay durable events from 43'}</strong></div>
      <div class="rules"><span>{ko ? '중복은 event_id로 제거' : 'Deduplicate by event_id'}</span><span>{ko ? '빈 구간은 snapshot으로 복구' : 'Repair gaps from a snapshot'}</span><span>{ko ? 'terminal 이후 late event 무시' : 'Ignore late events after terminal'}</span></div>
      <footer>{ko ? 'SSE 재연결은 transport 기능이다. 정확한 복구는 durable log와 idempotent reducer가 만든다.' : 'SSE reconnection is transport behavior; correct recovery comes from a durable log and an idempotent reducer.'}</footer>
    </div>
  )}

  {kind === 'aggregation' && (
    <div class="aggregation">
      <div class="parent"><span>Parent run</span><strong>{ko ? '3개 중 1개 완료 · 1개 승인 대기' : '1 of 3 done · 1 awaiting approval'}</strong><code>status = waiting_for_approval</code></div>
      <div class="branches"><i></i><i></i><i></i></div>
      <div class="children"><section><b>Research</b><strong>completed</strong><code>weight 0.35</code></section><section><b>Data</b><strong>waiting</strong><code>weight 0.40</code></section><section><b>Risk</b><strong>queued</strong><code>weight 0.25</code></section></div>
      <div class="projection"><span>{ko ? '확정된 milestone만 집계' : 'Aggregate committed milestones'}</span><span>{ko ? '새 작업 발견 시 rebase event' : 'Emit rebase when work expands'}</span><span>{ko ? '모르면 % 대신 단계 표시' : 'Use phases, not fake %, when unknown'}</span></div>
    </div>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .progress-diagram{margin:2.5rem 0;padding:1.2rem;border:1px solid var(--line);border-radius:.9rem;background:var(--paper-deep);color:var(--ink);font-family:var(--sans);font-size:.9rem;line-height:1.5}.progress-diagram figcaption{margin-top:1rem;color:var(--muted);font-size:.84rem;line-height:1.55}.progress-diagram code{overflow-wrap:anywhere;color:var(--ink);font-size:.69rem}.planes{display:grid;gap:.45rem}.planes header,.planes section{display:grid;grid-template-columns:.85fr 1.45fr .8fr;gap:.7rem;align-items:center}.planes header{padding:0 .75rem;color:var(--muted);font-size:.62rem;font-weight:800;text-transform:uppercase}.planes section{padding:.7rem .8rem;border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:.45rem;background:var(--paper)}.planes section p{margin:0;color:var(--muted);font-size:.7rem}.planes section i{font-style:normal;color:var(--muted);font-size:.66rem}.planes .token{border-left-style:dashed}.planes .result{border-left-width:7px}.planes footer,.reconnect footer{padding:.65rem;border-left:3px solid var(--accent);background:var(--paper);color:var(--muted);font-size:.71rem}
  .contract{display:grid;grid-template-columns:1.25fr auto 1fr;gap:.6rem;align-items:center}.envelope{display:grid;gap:.35rem;padding:.65rem;border:2px solid var(--accent);border-radius:.6rem;background:var(--paper)}.envelope>span{color:var(--accent);font-size:.65rem;font-weight:800;text-transform:uppercase}.envelope section{display:grid;grid-template-columns:.55fr 1.45fr;gap:.5rem;padding:.4rem;border-top:1px solid var(--line)}.envelope strong{font-size:.69rem}.gate{display:grid;gap:.35rem;max-width:10rem;padding:.7rem;border:1px dashed var(--accent);background:var(--paper);text-align:center}.gate:after{content:'→';color:var(--accent);font-size:1rem}.gate p{margin:0;color:var(--muted);font-size:.65rem}.ui{display:grid;grid-template-columns:1fr 1fr;gap:.4rem}.ui span{padding:.6rem .4rem;border:1px solid var(--line);background:var(--paper);font-size:.66rem;text-align:center}
  .reconnect{display:grid;gap:.7rem}.timeline{display:grid;grid-template-columns:1fr 1fr auto 1fr 1fr;gap:.35rem;align-items:center}.timeline span{display:grid;gap:.2rem;padding:.55rem;border:1px solid var(--line);background:var(--paper);font-size:.62rem}.timeline b{color:var(--accent)}.timeline em{padding:.45rem;color:var(--accent);font-size:.63rem;font-style:normal;font-weight:800;text-align:center}.resume{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.7rem;padding:.7rem;border:2px solid var(--accent);border-radius:.55rem;background:var(--paper)}.resume i{color:var(--accent);font-style:normal}.resume strong{font-size:.7rem}.rules,.projection{display:flex;flex-wrap:wrap;justify-content:center;gap:.35rem}.rules span,.projection span{padding:.4rem .55rem;border:1px dashed var(--line);background:var(--paper);font-size:.64rem}
  .aggregation{display:grid;gap:.35rem;text-align:center}.parent{display:grid;gap:.2rem;max-width:28rem;margin:auto;padding:.65rem 1rem;border:2px solid var(--accent);border-radius:.55rem;background:var(--paper)}.parent span{color:var(--accent);font-size:.62rem;font-weight:800;text-transform:uppercase}.branches{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;max-width:80%;height:1rem;margin:auto}.branches i{border-left:1px solid var(--accent);border-top:1px solid var(--accent)}.branches i:last-child{border-right:1px solid var(--accent)}.children{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}.children section{display:grid;gap:.25rem;padding:.7rem;border:1px solid var(--line);background:var(--paper)}.children b{font-size:.69rem}.children strong{color:var(--accent);font-size:.66rem}.projection{margin-top:.35rem}
  @media(max-width:700px){.planes header{display:none}.planes section{grid-template-columns:1fr}.contract{grid-template-columns:1fr}.gate{max-width:none}.gate:after{content:'↓'}.timeline{grid-template-columns:1fr}.timeline em{border-top:1px dashed var(--accent);border-bottom:1px dashed var(--accent)}.children{grid-template-columns:1fr}.branches{display:none}}
  @media(max-width:480px){.progress-diagram{padding:.8rem}.ui{grid-template-columns:1fr}.envelope section{grid-template-columns:1fr}.resume{align-items:stretch;flex-direction:column}.resume i{transform:rotate(90deg)}}
  @media(prefers-color-scheme:dark){.progress-diagram{--paper:#202720;--paper-deep:#171d19;--ink:#edf1e9;--muted:#b8c3b6;--line:#465347;--accent:#a0ceac}}
</style>
