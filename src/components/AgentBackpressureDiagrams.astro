---
interface Props {
  kind: 'collapse' | 'gates' | 'fairness' | 'control';
  language?: 'ko' | 'en';
  caption: string;
}

const { kind, language = 'ko', caption } = Astro.props;
const ko = language === 'ko';

const gates = ko
  ? [
      ['Identity', 'tenant · user · plan'],
      ['Idempotency', '같은 요청 재사용'],
      ['Quota', 'rate · token · cost'],
      ['Capacity', 'concurrency · queue age'],
      ['Commit', 'run + reservation + outbox'],
    ]
  : [
      ['Identity', 'tenant · user · plan'],
      ['Idempotency', 'reuse duplicate request'],
      ['Quota', 'rate · tokens · cost'],
      ['Capacity', 'concurrency · queue age'],
      ['Commit', 'run + reservation + outbox'],
    ];

const tenants = ko
  ? [
      ['Tenant A', 'interactive', 3],
      ['Tenant B', 'batch', 5],
      ['Tenant C', 'interactive', 2],
    ]
  : [
      ['Tenant A', 'interactive', 3],
      ['Tenant B', 'batch', 5],
      ['Tenant C', 'interactive', 2],
    ];
---

<figure class="pressure-diagram" aria-label={caption}>
  {kind === 'collapse' && (
    <div class="collapse">
      <div class="rates"><section><span>λ</span><strong>{ko ? '도착률' : 'Arrival rate'}</strong><b>12 jobs/s</b></section><i>›</i><section><span>μ</span><strong>{ko ? '처리율' : 'Service rate'}</strong><b>8 jobs/s</b></section></div>
      <div class="queue"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
      <ol>
        <li>{ko ? 'queue age 증가' : 'queue age rises'}</li><li>{ko ? 'deadline 초과' : 'deadlines expire'}</li><li>{ko ? 'retry 증폭' : 'retries amplify load'}</li><li>{ko ? 'downstream 포화' : 'downstream saturates'}</li>
      </ol>
      <footer>{ko ? 'Queue는 capacity가 아니다. 처리율보다 빠른 유입을 잠시 지연시킬 뿐이다.' : 'A queue is not capacity. It only delays arrivals that exceed the service rate.'}</footer>
    </div>
  )}

  {kind === 'gates' && (
    <div class="gates">
      <ol>{gates.map(([name, detail], index) => <li><span>0{index + 1}</span><strong>{name}</strong><code>{detail}</code></li>)}</ol>
      <div class="decisions"><section class="accept"><b>202</b><strong>{ko ? 'Accepted' : 'Accepted'}</strong><small>{ko ? 'durable ownership 시작' : 'durable ownership begins'}</small></section><section><b>429</b><strong>{ko ? 'Quota 제한' : 'Quota exceeded'}</strong><small>Retry-After</small></section><section><b>503</b><strong>{ko ? '일시적 포화' : 'Temporary overload'}</strong><small>Retry-After</small></section></div>
    </div>
  )}

  {kind === 'fairness' && (
    <div class="fairness">
      <div class="tenant-queues">{tenants.map(([name, lane, count]) => <section><header><strong>{name}</strong><code>{lane}</code></header><div>{Array.from({ length: Number(count) }).map(() => <span></span>)}</div></section>)}</div>
      <div class="scheduler"><span>{ko ? '공정한 Scheduler' : 'Fair scheduler'}</span><strong>{ko ? 'tenant weight · priority · aging · cost unit' : 'tenant weight · priority · aging · cost unit'}</strong></div>
      <div class="slots"><span>{ko ? '실행 slot' : 'Execution slots'}</span><i>A</i><i>B</i><i>C</i><i>A</i></div>
      <footer>{ko ? '큰 tenant 하나의 backlog가 다른 tenant의 interactive run을 막지 않게 한다.' : 'One large tenant backlog must not block another tenant’s interactive run.'}</footer>
    </div>
  )}

  {kind === 'control' && (
    <div class="control">
      <div class="loop"><section><span>01</span><strong>{ko ? '관찰' : 'Observe'}</strong><code>lag · oldest_age · saturation</code></section><i>→</i><section><span>02</span><strong>{ko ? '판단' : 'Decide'}</strong><code>quota · priority · deadline</code></section><i>→</i><section><span>03</span><strong>{ko ? '제어' : 'Control'}</strong><code>admit · delay · degrade · shed</code></section><i>→</i><section><span>04</span><strong>{ko ? '확장' : 'Scale'}</strong><code>min ≤ replicas ≤ max</code></section></div>
      <div class="boundary"><strong>{ko ? 'Downstream safe envelope' : 'Downstream safe envelope'}</strong><span>DB pool</span><span>provider RPS</span><span>tokens/min</span><span>cost/min</span></div>
      <footer>{ko ? 'Replica는 downstream이 허용하는 범위까지만 늘린다. 경계를 넘으면 더 빠른 장애가 된다.' : 'Add replicas only inside the downstream envelope; beyond it, scaling accelerates failure.'}</footer>
    </div>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .pressure-diagram{margin:2.5rem 0;padding:1.2rem;border:1px solid var(--line);border-radius:.9rem;background:var(--paper-deep);color:var(--ink);font-family:var(--sans);font-size:.9rem;line-height:1.5}.pressure-diagram figcaption{margin-top:1rem;color:var(--muted);font-size:.84rem;line-height:1.55}.pressure-diagram code{overflow-wrap:anywhere;color:var(--ink);font-size:.7rem}.collapse{display:grid;gap:.7rem}.rates{display:flex;align-items:center;justify-content:center;gap:.8rem}.rates section{display:grid;grid-template-columns:auto 1fr;gap:.15rem .55rem;min-width:11rem;padding:.75rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper)}.rates section>span{grid-row:1/3;display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:var(--accent);color:var(--paper-deep);font-weight:800}.rates b{color:var(--muted);font-size:.7rem}.rates>i{color:var(--accent);font-size:1.6rem;font-style:normal}.queue{display:flex;gap:.25rem;overflow:hidden;padding:.6rem;border:1px dashed var(--line);background:var(--paper)}.queue span{flex:0 0 8%;height:1.4rem;border-radius:.2rem;background:var(--accent)}.queue span:nth-last-child(-n+4){opacity:.45}.collapse ol{display:grid;grid-template-columns:repeat(4,1fr);gap:.35rem;margin:0;padding:0;list-style:none}.collapse li{padding:.55rem;border:1px solid var(--line);background:var(--paper);color:var(--muted);font-size:.68rem;text-align:center}.collapse footer,.fairness footer,.control footer{padding:.65rem;border-left:3px solid var(--accent);background:var(--paper);color:var(--muted);font-size:.71rem}
  .gates{display:grid;gap:.7rem}.gates ol{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.35rem;margin:0;padding:0;list-style:none}.gates li{position:relative;display:grid;gap:.25rem;padding:.7rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper)}.gates li:not(:last-child):after{content:'→';position:absolute;right:-.48rem;top:42%;z-index:1;color:var(--accent)}.gates li>span{color:var(--accent);font-size:.61rem;font-weight:800}.gates li strong{font-size:.73rem}.decisions{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}.decisions section{display:grid;grid-template-columns:auto 1fr;gap:.1rem .55rem;padding:.65rem;border:1px dashed var(--line);background:var(--paper)}.decisions b{grid-row:1/3;color:var(--accent);font-size:1.1rem}.decisions strong{font-size:.7rem}.decisions small{color:var(--muted);font-size:.62rem}.decisions .accept{border-style:solid;border-top:3px solid var(--accent)}
  .fairness{display:grid;grid-template-columns:1.3fr .9fr;gap:.6rem}.tenant-queues{display:grid;gap:.4rem}.tenant-queues section{display:grid;grid-template-columns:minmax(7rem,.65fr) 1fr;align-items:center;gap:.45rem;padding:.55rem;border:1px solid var(--line);background:var(--paper)}.tenant-queues header{display:grid}.tenant-queues strong{font-size:.7rem}.tenant-queues div{display:flex;gap:.25rem}.tenant-queues div span{width:1.1rem;height:1.1rem;border-radius:.18rem;background:var(--accent)}.scheduler{display:grid;place-content:center;gap:.35rem;padding:.8rem;border:2px solid var(--accent);border-radius:.55rem;background:var(--paper);text-align:center}.scheduler span{font-size:.72rem;font-weight:800}.scheduler strong{color:var(--muted);font-size:.63rem}.slots{grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:.35rem;padding:.55rem;border:1px dashed var(--line);background:var(--paper)}.slots>span{margin-right:.4rem;color:var(--muted);font-size:.68rem}.slots i{display:grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;background:var(--accent);color:var(--paper-deep);font-size:.68rem;font-style:normal;font-weight:800}.fairness footer{grid-column:1/-1}
  .control{display:grid;gap:.7rem}.loop{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:.35rem}.loop section{display:grid;gap:.25rem;padding:.7rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper)}.loop section span{color:var(--accent);font-size:.61rem;font-weight:800}.loop section strong{font-size:.72rem}.loop>i{color:var(--accent);font-style:normal}.boundary{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem;padding:.65rem;border:1px dashed var(--accent);background:var(--paper)}.boundary strong{width:100%;text-align:center;font-size:.7rem}.boundary span{padding:.25rem .5rem;border:1px solid var(--line);color:var(--muted);font-size:.65rem}
  @media(max-width:760px){.gates ol{grid-template-columns:repeat(2,1fr)}.gates li:after{display:none}.fairness{grid-template-columns:1fr}.slots,.fairness footer{grid-column:1}.loop{grid-template-columns:1fr}.loop>i{transform:rotate(90deg);text-align:center}}
  @media(max-width:520px){.pressure-diagram{padding:.8rem}.rates{display:grid}.rates>i{transform:rotate(90deg);text-align:center}.collapse ol,.decisions,.gates ol{grid-template-columns:1fr}.tenant-queues section{grid-template-columns:1fr}.queue span{flex-basis:12%}}
  @media(prefers-color-scheme:dark){.pressure-diagram{--paper:#202720;--paper-deep:#171d19;--ink:#edf1e9;--muted:#b8c3b6;--line:#465347;--accent:#a0ceac}}
</style>
