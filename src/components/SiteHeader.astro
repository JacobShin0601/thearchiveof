---
import { SECTIONS } from '../consts';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  language?: 'ko' | 'en';
  alternateLanguageUrl?: string;
}
const { language = 'ko', alternateLanguageUrl } = Astro.props;
const sectionPrefix = language === 'ko' ? '' : '/en';
---

<header class="site-header shell">
  <a class="wordmark" href={language === 'ko' ? '/' : '/en/'} aria-label="The Archive home">
    <span class="wordmark-the">The</span>
    <span>Archive</span>
  </a>
  <nav class="desktop-navigation" aria-label={language === 'ko' ? '주요 메뉴' : 'Primary navigation'}>
    <ul>
      {SECTIONS.map((section) => <li><a href={`${sectionPrefix}/${section.slug}/`}>{section.name}</a></li>)}
      <li><a href={language === 'ko' ? '/archive/' : '/en/archive/'}>{language === 'ko' ? '전체 글' : 'Archive'}</a></li>
      <li><a href={language === 'ko' ? '/about/' : '/en/about/'}>{language === 'ko' ? '소개' : 'About'}</a></li>
      <li><LanguageSwitch language={language} alternateLanguageUrl={alternateLanguageUrl} /></li>
    </ul>
  </nav>
  <details class="mobile-navigation">
    <summary>{language === 'ko' ? '메뉴' : 'Menu'}</summary>
    <nav aria-label={language === 'ko' ? '모바일 주요 메뉴' : 'Mobile primary navigation'}>
      <ul>
        {SECTIONS.map((section) => <li><a href={`${sectionPrefix}/${section.slug}/`}>{section.name}</a></li>)}
        <li><a href={language === 'ko' ? '/archive/' : '/en/archive/'}>{language === 'ko' ? '전체 글' : 'Archive'}</a></li>
        <li><a href={language === 'ko' ? '/about/' : '/en/about/'}>{language === 'ko' ? '소개' : 'About'}</a></li>
        <li><LanguageSwitch language={language} alternateLanguageUrl={alternateLanguageUrl} /></li>
      </ul>
    </nav>
  </details>
</header>
