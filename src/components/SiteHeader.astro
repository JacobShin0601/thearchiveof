---
import { SECTIONS } from '../consts';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  language?: 'ko' | 'en';
  alternateLanguageUrl?: string;
}
const { language = 'ko', alternateLanguageUrl } = Astro.props;
const sectionPrefix = language === 'ko' ? '' : '/en';
---

<header class="site-header shell">
  <a class="wordmark" href={language === 'ko' ? '/' : '/en/'} aria-label="The Archive of home">
    <svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" fill="#f2f0e9"/>
      <rect x="4" y="4" width="24" height="24" rx="3.2" fill="#f2f0e9" stroke="#1c201d" stroke-width="1.45"/>
      <path d="M4 7.15C4 5.4 5.4 4 7.15 4H24.85C26.6 4 28 5.4 28 7.15V9.1H4V7.15Z" fill="#335f4b"/>
      <path fill="#1c201d" fill-rule="evenodd" d="M16 11.05 21.25 22.55h-1.92l-1.08-2.62h-4.5l-1.08 2.62H10.75L16 11.05Zm0 3.28-1.58 3.82h3.16L16 14.33Z"/>
      <rect x="11.15" y="23.55" width="9.7" height="0.72" fill="#c9c6bc"/>
      <rect x="11.15" y="25.1" width="9.7" height="0.72" fill="#c9c6bc"/>
    </svg>
    <span class="wordmark-the">The</span>
    <span>Archive of</span>
  </a>
  <nav class="desktop-navigation" aria-label={language === 'ko' ? '주요 메뉴' : 'Primary navigation'}>
    <ul>
      {SECTIONS.map((section) => <li><a href={`${sectionPrefix}/${section.slug}/`}>{section.name}</a></li>)}
      <li><a href={language === 'ko' ? '/archive/' : '/en/archive/'}>{language === 'ko' ? '전체 글' : 'Archive'}</a></li>
      <li><a href={language === 'ko' ? '/about/' : '/en/about/'}>{language === 'ko' ? '소개' : 'About'}</a></li>
      <li><LanguageSwitch language={language} alternateLanguageUrl={alternateLanguageUrl} /></li>
    </ul>
  </nav>
  <details class="mobile-navigation">
    <summary>{language === 'ko' ? '메뉴' : 'Menu'}</summary>
    <nav aria-label={language === 'ko' ? '모바일 주요 메뉴' : 'Mobile primary navigation'}>
      <ul>
        {SECTIONS.map((section) => <li><a href={`${sectionPrefix}/${section.slug}/`}>{section.name}</a></li>)}
        <li><a href={language === 'ko' ? '/archive/' : '/en/archive/'}>{language === 'ko' ? '전체 글' : 'Archive'}</a></li>
        <li><a href={language === 'ko' ? '/about/' : '/en/about/'}>{language === 'ko' ? '소개' : 'About'}</a></li>
        <li><LanguageSwitch language={language} alternateLanguageUrl={alternateLanguageUrl} /></li>
      </ul>
    </nav>
  </details>
</header>
