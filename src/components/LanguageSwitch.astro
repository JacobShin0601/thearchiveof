---
interface Props {
  language: 'ko' | 'en';
  alternateLanguageUrl?: string;
}
const { language, alternateLanguageUrl } = Astro.props;
const fallback = language === 'ko' ? '/en/' : '/';
---

<div class="language-switch" role="group" aria-label={language === 'ko' ? '언어 선택' : 'Language selection'}>
  {language === 'ko'
    ? <span aria-current="true" lang="ko">KO</span>
    : <a href={alternateLanguageUrl ?? fallback} hreflang="ko" lang="ko" aria-label="한국어">KO</a>}
  {language === 'en'
    ? <span aria-current="true" lang="en">EN</span>
    : <a href={alternateLanguageUrl ?? fallback} hreflang="en" lang="en" aria-label="English">EN</a>}
</div>

<script>
  import { track } from '../scripts/track';

  document.querySelectorAll('.language-switch a').forEach((link) => {
    link.addEventListener('click', () => {
      const language = document.documentElement.lang === 'en' ? 'en' : 'ko';
      const article = document.querySelector<HTMLElement>('[data-article-key]');
      track('language_switch', {
        language,
        articleSlug: article?.dataset.articleKey,
        component: 'language-switch',
      });
    });
  });
</script>
