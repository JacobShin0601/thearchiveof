---
import {
  SALESFORCE_CURRENT_PRICE,
  salesforceQuarterlyGrowth,
  salesforceScenarios,
  salesforceSbcImpliedGrowth,
} from '../data/salesforce-valuation';

interface Props {
  variant: 'flywheel' | 'growth' | 'crpo' | 'ai-waterfall' | 'fcf-quality' | 'valuation' | 'heatmap' | 'implied-growth';
  language?: 'ko' | 'en';
}

const { variant, language = 'ko' } = Astro.props;
const ko = language === 'ko';
const latest = salesforceQuarterlyGrowth.at(-1)!;
const maxGrowth = 0.18;
const chartX = (index: number) => 45 + index * 48;
const chartY = (value: number) => 178 - (value / maxGrowth) * 135;
const points = (key: 'revenueGrowth' | 'crpoGrowth') =>
  salesforceQuarterlyGrowth.map((row, index) => `${chartX(index)},${chartY(row[key])}`).join(' ');
const heatDiscounts = [0.08, 0.09, 0.10, 0.11, 0.12];
const heatGrowth = [0.02, 0.04, 0.06, 0.08, 0.10];
const heatValue = (growth: number, discount: number) => {
  const start = 15.048;
  const years = [1, 2, 3, 4, 5];
  const pv = years.reduce((sum, year) => sum + start * (1 + growth) ** year / (1 + discount) ** year, 0);
  const terminal = start * (1 + growth) ** 5 * 1.025 / (discount - 0.025) / (1 + discount) ** 5;
  return (pv + terminal) * 1000 / 823;
};
---

<figure class="sf-figure">
  {variant === 'flywheel' && (
    <>
      <figcaption><strong>{ko ? 'Salesforce의 AI 플라이휠에는 두 방향이 있다' : 'Salesforce’s AI flywheel runs in two directions'}</strong><span>{ko ? '추가 사용량과 좌석 잠식은 동시에 일어날 수 있다.' : 'Incremental usage and seat cannibalization can happen at the same time.'}</span></figcaption>
      <svg viewBox="0 0 760 300" role="img" aria-label={ko ? 'CRM 고객, 기업 데이터, Data 360, Agentforce, 추가 매출과 좌석 잠식의 관계' : 'Relationship among CRM customers, enterprise data, Data 360, Agentforce, incremental revenue, and seat cannibalization'}>
        <defs><marker id="sf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" /></marker></defs>
        <g class="flow positive-flow"><path d="M135 95H245M350 95H460M565 95H665"/><path d="M665 125C665 215 145 215 145 135"/></g>
        <g class="node"><rect x="25" y="55" width="110" height="80" rx="16"/><text x="80" y="88">CRM</text><text x="80" y="108">{ko ? '고객' : 'customers'}</text></g>
        <g class="node"><rect x="245" y="55" width="105" height="80" rx="16"/><text x="297" y="88">Data</text><text x="297" y="108">360</text></g>
        <g class="node accent"><rect x="460" y="55" width="105" height="80" rx="16"/><text x="512" y="88">Agentforce</text></g>
        <g class="node"><rect x="665" y="55" width="70" height="80" rx="16"/><text x="700" y="84">AI</text><text x="700" y="104">{ko ? '사용량' : 'usage'}</text></g>
        <g class="negative-flow"><path d="M512 135C512 240 200 255 83 140"/></g>
        <text class="positive-label" x="388" y="220">{ko ? '+ 사용량·업셀·신규 업무' : '+ usage, upsell, new work'}</text>
        <text class="negative-label" x="360" y="275">{ko ? '− 좌석·기존 라이선스 잠식' : '− seats and license cannibalization'}</text>
      </svg>
    </>
  )}

  {(variant === 'growth' || variant === 'crpo') && (
    <>
      <figcaption><strong>{variant === 'growth' ? (ko ? '보고 성장률과 본업 성장률은 같지 않다' : 'Reported growth is not the same as underlying growth') : (ko ? 'cRPO는 매출보다 먼저 움직였지만 완벽한 예언자는 아니다' : 'cRPO moved first, but it is not a perfect forecast')}</strong><span>{ko ? '회사 공시 수치. 점선은 Informatica 매출을 단순 제외한 저자 추정치다.' : 'Company-reported figures. The dotted series is an author estimate excluding disclosed Informatica revenue.'}</span></figcaption>
      <svg viewBox="0 0 560 235" role="img" aria-label={ko ? '최근 10개 분기 매출 성장률과 cRPO 성장률' : 'Revenue and cRPO growth over the last ten quarters'}>
        {[0.05, 0.10, 0.15].map((value) => <g class="grid"><line x1="35" x2="530" y1={chartY(value)} y2={chartY(value)}/><text x="4" y={chartY(value) + 4}>{Math.round(value * 100)}%</text></g>)}
        <polyline class="line revenue" points={points('revenueGrowth')} />
        <polyline class="line crpo" points={points('crpoGrowth')} />
        <polyline class="line estimate" points={salesforceQuarterlyGrowth.slice(7).map((row, index) => `${chartX(index + 7)},${chartY(row.estimatedExInformaticaGrowth ?? row.revenueGrowth)}`).join(' ')} />
        {salesforceQuarterlyGrowth.map((row, index) => <text class="axis" x={chartX(index)} y="215" transform={`rotate(-35 ${chartX(index)} 215)`}>{row.period.replace('FY', 'F')}</text>)}
        <g class="legend"><circle cx="270" cy="18" r="4" class="revenue-dot"/><text x="280" y="22">Revenue</text><circle cx="360" cy="18" r="4" class="crpo-dot"/><text x="370" y="22">cRPO</text><line x1="438" x2="458" y1="18" y2="18" class="estimate"/><text x="464" y="22">Ex-Inf. est.</text></g>
      </svg>
      <p class="figure-note">FY27 Q2: Revenue {(latest.revenueGrowth * 100).toFixed(0)}% · cRPO {(latest.crpoGrowth * 100).toFixed(0)}% · {ko ? 'Informatica 단순 제외 추정' : 'simple ex-Informatica estimate'} {((latest.estimatedExInformaticaGrowth ?? 0) * 100).toFixed(1)}%</p>
    </>
  )}

  {variant === 'ai-waterfall' && (
    <>
      <figcaption><strong>{ko ? 'AI 매출보다 중요한 것은 순경제적 기여다' : 'Net economic contribution matters more than gross AI revenue'}</strong><span>{ko ? '$5B의 5년차 순증 AI 매출을 둔 저자 예시. 회사 가이던스가 아니다.' : 'Author illustration using $5B of year-five incremental AI revenue; not company guidance.'}</span></figcaption>
      <div class="waterfall">
        <div style="--h:100%"><strong>$5.00B</strong><span>{ko ? 'Gross AI revenue' : 'Gross AI revenue'}</span></div>
        <div class="negative" style="--h:15%"><strong>−$0.75B</strong><span>{ko ? 'CRM 잠식 15%' : 'CRM cannibalization 15%'}</span></div>
        <div class="negative" style="--h:38.25%"><strong>−$1.91B</strong><span>{ko ? 'AI 비용·세금 등' : 'AI cost, tax, etc.'}</span></div>
        <div class="total" style="--h:46.75%"><strong>$2.34B</strong><span>{ko ? 'Net FCF contribution' : 'Net FCF contribution'}</span></div>
      </div>
    </>
  )}

  {variant === 'fcf-quality' && (
    <>
      <figcaption><strong>{ko ? '현금흐름의 양과 질을 나눠서 본다' : 'Separate the amount of cash flow from its quality'}</strong><span>{ko ? 'FY27 FCF는 회사 가이던스 중간값을 적용한 저자 추정. SBC는 상반기 연율화.' : 'FY27 FCF is an author estimate at the guidance midpoint; SBC is annualized from the first half.'}</span></figcaption>
      <div class="bridge-cards"><div><small>Reported FCF</small><strong>$15.05B</strong><span>FY27E</span></div><b>−</b><div><small>{ko ? '연율화 SBC' : 'Annualized SBC'}</small><strong>$3.53B</strong><span>{ko ? '경제적 비용 100% 가정' : '100% economic-cost lens'}</span></div><b>=</b><div class="highlight"><small>{ko ? '보수적 owner earnings' : 'Conservative owner earnings'}</small><strong>$11.52B</strong><span>{ko ? '세금 효과 단순화' : 'tax effects simplified'}</span></div></div>
    </>
  )}

  {variant === 'valuation' && (
    <>
      <figcaption><strong>{ko ? 'Salesforce의 오늘 적정가치는 얼마인가' : 'What is Salesforce worth today?'}</strong><span>{ko ? '5년 FCFE 근사 DCF. 현재가는 2026년 10월 7일 정규장 종가.' : 'Five-year FCFE-proxy DCF. Market price is the October 7, 2026 regular-session close.'}</span></figcaption>
      <div class="bars">{salesforceScenarios.map((scenario) => <div><span>{scenario.name}</span><i style={`--w:${scenario.fairValuePerShare / 500 * 100}%`}></i><strong>${scenario.fairValuePerShare.toFixed(0)}</strong></div>)}<div class="market"><span>{ko ? '현재가' : 'Market'}</span><i style={`--w:${SALESFORCE_CURRENT_PRICE / 500 * 100}%`}></i><strong>${SALESFORCE_CURRENT_PRICE.toFixed(2)}</strong></div></div>
    </>
  )}

  {variant === 'heatmap' && (
    <>
      <figcaption><strong>{ko ? '성장률보다 할인율에 더 민감할 때가 있다' : 'Sometimes the discount rate matters more than growth'}</strong><span>{ko ? '영구성장률 2.5%, 823M 주 고정. 단위: 주당 달러.' : '2.5% terminal growth and 823M shares. Dollars per share.'}</span></figcaption>
      <div class="table-scroll"><table><thead><tr><th>{ko ? 'FCF CAGR \ 할인율' : 'FCF CAGR \ discount'}</th>{heatDiscounts.map((rate) => <th>{(rate * 100).toFixed(0)}%</th>)}</tr></thead><tbody>{heatGrowth.map((growth) => <tr><th>{(growth * 100).toFixed(0)}%</th>{heatDiscounts.map((discount) => { const value = heatValue(growth, discount); return <td class={value > SALESFORCE_CURRENT_PRICE * 1.1 ? 'above' : value < SALESFORCE_CURRENT_PRICE * .9 ? 'below' : 'near'}>${value.toFixed(0)}</td>; })}</tr>)}</tbody></table></div>
    </>
  )}

  {variant === 'implied-growth' && (
    <>
      <figcaption><strong>{ko ? '현재 가격이 요구하는 FCF 성장률' : 'FCF growth required by today’s price'}</strong><span>{ko ? '할인율 10%, 영구성장률 2.5%. SBC를 경제적 비용으로 볼수록 요구 성장률이 높아진다.' : '10% discount rate and 2.5% terminal growth. The required rate rises as more SBC is treated as an economic cost.'}</span></figcaption>
      <div class="implied">{salesforceSbcImpliedGrowth.map((row) => <div><span>SBC {Math.round(row.sbcAdjustmentRatio * 100)}%</span><i style={`--w:${Math.max(row.impliedGrowth, .001) / .07 * 100}%`}></i><strong>{(row.impliedGrowth * 100).toFixed(row.impliedGrowth < .001 ? 2 : 1)}%</strong></div>)}</div>
    </>
  )}
</figure>

<style>
  .sf-figure{--ink:#23304a;--accent:#5368d7;--teal:#168b80;--red:#b05b57;--line:#d9deea;margin:2rem 0;padding:clamp(1rem,3vw,1.55rem);border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#fbfcff,#f3f5fb);color:var(--ink);font-family:var(--sans);overflow:hidden}.sf-figure figcaption{display:flex;flex-direction:column;gap:.28rem;margin-bottom:1rem}.sf-figure figcaption strong{font:700 clamp(1.05rem,2.5vw,1.35rem)/1.25 var(--serif)}.sf-figure figcaption span,.figure-note{color:#687083;font-size:.77rem}.sf-figure svg{display:block;width:100%;height:auto}.flow path,.positive-flow path,.negative-flow path{fill:none;stroke:currentColor;stroke-width:3;marker-end:url(#sf-arrow)}.positive-flow{color:var(--teal)}.negative-flow{color:var(--red)}.node rect{fill:#fff;stroke:#cbd2e2;stroke-width:2}.node.accent rect{fill:#e9ecff;stroke:var(--accent)}.node text{text-anchor:middle;fill:var(--ink);font:700 16px var(--sans)}.positive-label,.negative-label{text-anchor:middle;font:700 14px var(--sans)}.positive-label{fill:var(--teal)}.negative-label{fill:var(--red)}.grid line{stroke:#e0e4ed;stroke-width:1}.grid text,.axis,.legend text{fill:#737b8c;font:11px var(--sans)}.line{fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.line.revenue{stroke:var(--accent)}.line.crpo{stroke:var(--teal)}.line.estimate{stroke:var(--red);stroke-dasharray:5 5}.revenue-dot{fill:var(--accent)}.crpo-dot{fill:var(--teal)}.waterfall{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;align-items:end;min-height:235px}.waterfall>div{display:flex;height:calc(var(--h) * 1.7);min-height:70px;flex-direction:column;justify-content:flex-end;border-radius:10px 10px 2px 2px;background:var(--accent);padding:.7rem;color:#fff}.waterfall .negative{background:var(--red)}.waterfall .total{background:var(--teal)}.waterfall strong{font:700 1.2rem var(--serif)}.waterfall span{font-size:.7rem}.bridge-cards{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.6rem;align-items:center}.bridge-cards>div{display:flex;min-height:120px;flex-direction:column;justify-content:center;border:1px solid var(--line);border-radius:12px;background:#fff;padding:1rem}.bridge-cards>b{font-size:1.5rem}.bridge-cards strong{margin:.25rem 0;font:700 1.5rem var(--serif)}.bridge-cards small,.bridge-cards span{color:#6c7485;font-size:.72rem}.bridge-cards .highlight{background:var(--ink);color:#fff}.bars,.implied{display:grid;gap:.65rem}.bars>div,.implied>div{display:grid;grid-template-columns:75px 1fr 75px;gap:.7rem;align-items:center}.bars i,.implied i{height:16px;border-radius:999px;background:linear-gradient(90deg,var(--accent),#8d9aec);width:var(--w)}.bars .market i{background:var(--teal)}.bars span,.implied span{font-size:.74rem;font-weight:700}.bars strong,.implied strong{font-variant-numeric:tabular-nums}.implied i{background:linear-gradient(90deg,var(--teal),var(--accent))}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:separate;border-spacing:4px;font-size:.75rem;text-align:center}th,td{padding:.55rem;border-radius:6px}th{color:#687083}td{font-weight:700}.above{background:#dcefe9}.near{background:#f5e9bd}.below{background:#f0dddd}@media(max-width:620px){.waterfall{grid-template-columns:repeat(2,1fr);min-height:0}.waterfall>div{height:110px}.bridge-cards{grid-template-columns:1fr}.bridge-cards>b{text-align:center}.bars>div,.implied>div{grid-template-columns:65px 1fr 58px}.sf-figure{padding:1rem}}
  :global(html.dark) .sf-figure{--ink:#e7eaf3;--line:#41485b;background:linear-gradient(145deg,#222734,#1b202b);color:#e7eaf3}.dark .node rect{fill:#242a38;stroke:#515b70}.dark .node.accent rect{fill:#303757}.dark .node text{fill:#eef0f7}.dark .grid line{stroke:#3b4251}.dark .bridge-cards>div{background:#262c39}.dark .bridge-cards .highlight{background:#111620}.dark th{color:#aeb5c6}.dark .above{background:#254b43}.dark .near{background:#554b29}.dark .below{background:#543938}
</style>
