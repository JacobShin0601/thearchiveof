---
interface Props {
  kind: 'workflow' | 'needs' | 'context';
  id: string;
  caption: string;
  language?: 'ko' | 'en';
}

const { kind, id, caption, language = 'ko' } = Astro.props;
const isKo = language === 'ko';

const workflow = isKo
  ? [
      { title: 'Traditional', steps: ['사람', '수집', '분석', '보고서·승인'] },
      { title: 'AI-assisted', steps: ['사람', 'AI 도움', '수집·분석·초안', '검토·승인'] },
      { title: 'AX / redesigned', accent: true, steps: ['Agent가 지속 수집·분석', '이상징후만 전달', '사람 판단·승인', '피드백'] },
    ]
  : [
      { title: 'Traditional', steps: ['Person', 'Collect', 'Analyze', 'Report · approve'] },
      { title: 'AI-assisted', steps: ['Person', 'AI help', 'Collect · analyze · draft', 'Review · approve'] },
      { title: 'AX / redesigned', accent: true, steps: ['Agent collects and analyzes continuously', 'Escalates only anomalies', 'Person judges and approves', 'Feedback'] },
    ];

const needs = isKo
  ? [
      { kicker: 'Compression', title: 'Human capability → Machine speed', items: ['자료 취합과 문서 비교', '반복 리서치와 초안 작성', '여러 시스템의 정보 정리'] },
      { kicker: 'Expansion', title: 'Human cognition → Augmented cognition', items: ['과거 결정과 현재 이슈 연결', '반론·리스크·시나리오 제안', '새로운 가설과 질문 생성'] },
    ]
  : [
      { kicker: 'Compression', title: 'Human capability → Machine speed', items: ['Gathering materials and comparing documents', 'Repeated research and drafting', 'Organizing information across systems'] },
      { kicker: 'Expansion', title: 'Human cognition → Augmented cognition', items: ['Connecting past decisions to current issues', 'Proposing counterarguments, risks, and scenarios', 'Generating new hypotheses and questions'] },
    ];
---

<figure class="ax-diagram" aria-labelledby={id}>
  <figcaption id={id}>{caption}</figcaption>
  {kind === 'workflow' && (
    <div class="workflow-grid">
      {workflow.map((row) => (
        <div class={row.accent ? 'accent' : undefined}>
          <strong>{row.title}</strong>
          {row.steps.map((step, index) => (
            <>
              {index > 0 && <i>→</i>}
              <span>{step}</span>
            </>
          ))}
        </div>
      ))}
    </div>
  )}
  {kind === 'needs' && (
    <div class="needs-grid">
      {needs.map((column) => (
        <section>
          <p class="kicker">{column.kicker}</p>
          <h3>{column.title}</h3>
          <ul>{column.items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}
    </div>
  )}
  {kind === 'context' && (
    <div class="context-stack"><div>Foundation model</div><div>+ Company documents</div><div>+ Permissions</div><div>+ Past decisions</div><div>+ Workflow context</div><div>+ Human feedback</div><strong>= Enterprise context</strong></div>
  )}
</figure>

<style>
  .ax-diagram{margin:2.5rem 0;padding:1.25rem;border:1px solid var(--border-color,#d7d7d7);border-radius:1rem;background:color-mix(in srgb,var(--card-bg,#fff) 92%,#6d5dfc 8%)}
  figcaption{font-weight:700;margin-bottom:1rem}.workflow-grid{display:grid;gap:.7rem}.workflow-grid>div{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;padding:.8rem;border-radius:.7rem;background:var(--background,#fff)}.workflow-grid strong{width:100%;font-size:.82rem;letter-spacing:.04em;text-transform:uppercase}.workflow-grid i{color:#8a83ba;font-style:normal}.workflow-grid .accent{border:1px solid #7569e8;background:color-mix(in srgb,var(--background,#fff) 86%,#7569e8 14%)}.needs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.needs-grid section{padding:1rem;border-radius:.8rem;background:var(--background,#fff)}.needs-grid h3{font-size:1rem;margin:.2rem 0 .8rem}.needs-grid ul{margin:0;padding-left:1.2rem}.kicker{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:#7569e8;font-weight:700}.context-stack{display:grid;gap:.35rem;max-width:34rem;margin:auto}.context-stack div,.context-stack strong{padding:.7rem 1rem;border-radius:.55rem;background:var(--background,#fff);border:1px solid var(--border-color,#ddd)}.context-stack strong{text-align:center;background:#7569e8;color:white;border-color:#7569e8}@media(max-width:600px){.needs-grid{grid-template-columns:1fr}.ax-diagram{padding:1rem}.workflow-grid>div{font-size:.9rem}}
</style>
