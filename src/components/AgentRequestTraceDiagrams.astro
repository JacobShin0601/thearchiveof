---
interface Props {
  kind: 'sequence' | 'ownership' | 'projection' | 'failure';
  language?: 'ko' | 'en';
  caption: string;
}

const { kind, language = 'ko', caption } = Astro.props;
const ko = language === 'ko';

const sequence = ko
  ? [
      ['1', '접수', '브라우저 → API', '인증·권한·입력 검증', '이 단계에서는 아직 실행하지 않는다.'],
      ['2', '기록', 'API → PostgreSQL', 'run과 outbox를 함께 기록', '서버가 다시 시작돼도 요청을 찾을 수 있다.'],
      ['3', '전달', '릴레이 → Redis Stream', '실행에 필요한 식별자만 발행', '전달에 실패해도 다시 시도할 수 있다.'],
      ['4', '실행', '워커 attempt → LangGraph', '이번 시도의 실행 권한 확인', '중복 전달돼도 바로 다시 실행하지 않는다.'],
      ['5', '확정', 'PostgreSQL → Redis → XACK', '결과를 먼저 확정하고 ack는 마지막', '장애 뒤에도 최종 상태를 다시 찾을 수 있다.'],
    ]
  : [
      ['1', 'Admit', 'Browser → API', 'Authenticate, authorize, validate', 'Do not execute yet.'],
      ['2', 'Persist', 'API → PostgreSQL', 'Write run and outbox together', 'The request survives a restart.'],
      ['3', 'Dispatch', 'Relay → Redis Stream', 'Publish only execution identifiers', 'A failed handoff can be retried.'],
      ['4', 'Execute', 'Worker attempt → LangGraph', 'Confirm this attempt’s authority', 'A duplicate delivery does not rerun work.'],
      ['5', 'Settle', 'PostgreSQL → Redis → XACK', 'Commit result first; ack last', 'Terminal state remains recoverable.'],
    ];

const owners = ko
  ? [
      ['API', '접수 담당', '사용자 식별 · 권한 확인 · 입력 검증', 'run과 outbox를 남기면 API의 일은 끝난다.'],
      ['Queue', '전달 담당', '미전달 → pending', '아직 확인되지 않은 전달을 기억한다.'],
      ['Worker attempt', '실행 담당', '그래프 · 도구 · checkpoint', 'lease와 fence 아래에서 한 번의 시도를 수행한다.'],
      ['PostgreSQL', '최종 결과 담당', '종료 상태 · 결과 · 감사 기록', '재연결과 재전달을 판단하는 최종 기준이다.'],
    ]
  : [
      ['API', 'Admission owner', 'identity · authorization · validation', 'Its responsibility ends after persisting run and outbox.'],
      ['Queue', 'Delivery owner', 'undelivered → pending', 'It remembers delivery that is not yet acknowledged.'],
      ['Worker attempt', 'Execution owner', 'graph · tool · checkpoint', 'It performs one attempt under a lease and fence.'],
      ['PostgreSQL', 'Result owner', 'terminal status · result · audit', 'It is the final authority for reconnect and redelivery.'],
    ];

const failures = ko
  ? [
      ['기록 전', '아무 run도 남지 않는다', '요청이 실패했다는 응답을 보내고, 새 요청을 받는다.'],
      ['기록 후 · 전달 전', 'run과 outbox가 남는다', '릴레이 또는 reconciler가 큐에 다시 발행한다.'],
      ['결과 확정 후 · ack 전', '최종 결과가 남는다', '새 워커는 다시 실행하지 않고 XACK만 한다.'],
      ['SSE 연결 종료', '실행과 이벤트가 남는다', 'cursor로 놓친 이벤트를 다시 읽고, 범위를 넘으면 snapshot을 다시 읽는다.'],
    ]
  : [
      ['Before persistence', 'No run remains', 'Return failure and allow a fresh request.'],
      ['After persistence · before dispatch', 'Run and outbox remain', 'A relay or reconciler publishes to the queue.'],
      ['After result · before ack', 'Terminal result remains', 'A new worker ACKs without re-executing.'],
      ['SSE disconnect', 'Execution and events remain', 'Replay by cursor; reread snapshot when needed.'],
    ];
---

<figure class="request-trace" aria-label={caption}>
  {kind === 'sequence' && (
    <ol class="trace-flow">
      {sequence.map(([number, phase, path, action, detail], index) => (
        <li>
          <article>
            <span class="step">{number}</span>
            <div>
              <strong>{phase}</strong>
              <small>{path}</small>
            </div>
            <p>{action}</p>
            <em>{detail}</em>
          </article>
          {index < sequence.length - 1 && <span class="flow-arrow" aria-hidden="true">↓</span>}
        </li>
      ))}
    </ol>
  )}

  {kind === 'ownership' && (
    <ol class="owner-flow">
      {owners.map(([owner, role, state, detail], index) => (
        <li>
          <article>
            <span class="owner-number">0{index + 1}</span>
            <small>{role}</small>
            <strong>{owner}</strong>
            <code>{state}</code>
            <p>{detail}</p>
          </article>
          {index < owners.length - 1 && <span class="handoff" aria-hidden="true">책임이 다음 주체에게 넘어간다 ↓</span>}
        </li>
      ))}
    </ol>
  )}

  {kind === 'projection' && (
    <div class="projection">
      <section class="source">
        <span>RUNTIME</span>
        <strong>실행 중 생성된 값</strong>
        <p>그래프 내부 상태를 그대로 브라우저에 보내지 않는다.</p>
      </section>
      <div class="projection-arrow" aria-hidden="true">↓ 애플리케이션 형식으로 변환</div>
      <div class="projection-branches">
        <section>
          <span>화면 상태</span>
          <strong>UI snapshot</strong>
          <code>status · progress · current_step</code>
          <p>Redis Hash에 저장해 화면을 빠르게 복원한다.</p>
        </section>
        <section>
          <span>이벤트 시간순 기록</span>
          <strong>Event timeline</strong>
          <code>step_started · approval · completed</code>
          <p>Redis Stream에 추가해 SSE를 다시 연결할 때 쓴다.</p>
        </section>
      </div>
      <div class="projection-arrow" aria-hidden="true">↓</div>
      <section class="destination">
        <strong>FastAPI SSE → Browser</strong>
        <p>브라우저는 실행을 맡지 않고, snapshot과 event를 받아 화면에 반영한다.</p>
      </section>
    </div>
  )}

  {kind === 'failure' && (
    <ol class="failure-flow">
      {failures.map(([window, record, recovery], index) => (
        <li>
          <span>{index + 1}</span>
          <div>
            <small>멈춘 지점</small>
            <strong>{window}</strong>
          </div>
          <div>
            <small>남는 기준</small>
            <p>{record}</p>
          </div>
          <div>
            <small>복구</small>
            <p>{recovery}</p>
          </div>
        </li>
      ))}
    </ol>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .request-trace{margin:2.25rem 0;padding:1rem;border:1px solid var(--line);border-radius:.9rem;background:var(--paper-deep);color:var(--ink);font-family:var(--sans);line-height:1.5}
  .request-trace figcaption{margin-top:.85rem;color:var(--muted);font-size:.8rem;line-height:1.55}.request-trace code{overflow-wrap:anywhere;color:var(--ink);font-size:.72rem}
  .trace-flow,.owner-flow,.failure-flow{display:grid;gap:.45rem;margin:0;padding:0;list-style:none}
  .trace-flow li,.owner-flow li{display:grid;gap:.45rem}.trace-flow article{display:grid;grid-template-columns:auto minmax(7rem,.78fr) minmax(9rem,1fr) minmax(0,1.15fr);gap:.55rem .8rem;align-items:center;padding:.75rem;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:.55rem;background:var(--paper)}
  .step{display:grid;place-items:center;width:1.65rem;height:1.65rem;border-radius:50%;background:var(--accent);color:var(--paper-deep);font-size:.72rem;font-weight:800}.trace-flow strong{display:block;font-size:.8rem}.trace-flow small,.trace-flow em{color:var(--muted);font-size:.69rem;font-style:normal}.trace-flow p{margin:0;font-size:.74rem}.flow-arrow,.projection-arrow{text-align:center;color:var(--accent);font-size:.88rem;font-weight:800}
  .owner-flow article{display:grid;grid-template-columns:auto minmax(7rem,.8fr) minmax(9rem,1fr) minmax(0,1.2fr);gap:.5rem .75rem;align-items:center;padding:.75rem;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:.55rem;background:var(--paper)}.owner-number{color:var(--accent);font-size:.72rem;font-weight:800}.owner-flow small{color:var(--accent);font-size:.68rem;font-weight:800}.owner-flow strong{font-size:.82rem}.owner-flow p{margin:0;color:var(--muted);font-size:.71rem}.handoff{padding-left:1.1rem;color:var(--muted);font-size:.7rem}
  .projection{display:grid;gap:.55rem}.projection section{display:grid;gap:.28rem;padding:.8rem;border:1px solid var(--line);border-radius:.55rem;background:var(--paper)}.projection span{color:var(--accent);font-size:.67rem;font-weight:800;letter-spacing:.04em}.projection strong{font-size:.84rem}.projection p{margin:0;color:var(--muted);font-size:.72rem}.projection-branches{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.projection-branches section{border-top:3px solid var(--accent)}.destination{text-align:center}
  .failure-flow li{display:grid;grid-template-columns:auto minmax(7rem,.8fr) minmax(8rem,1fr) minmax(10rem,1.3fr);gap:.55rem .75rem;align-items:center;padding:.75rem;border:1px solid var(--line);border-radius:.55rem;background:var(--paper)}.failure-flow li>span{display:grid;place-items:center;width:1.35rem;height:1.35rem;border-radius:50%;background:var(--accent);color:var(--paper-deep);font-size:.64rem;font-weight:800}.failure-flow small{display:block;color:var(--accent);font-size:.64rem;font-weight:800}.failure-flow strong{font-size:.78rem}.failure-flow p{margin:.1rem 0 0;color:var(--muted);font-size:.7rem}
  @media(max-width:760px){.trace-flow article,.owner-flow article{grid-template-columns:auto 1fr}.trace-flow article>p,.trace-flow article>em,.owner-flow article>code,.owner-flow article>p{grid-column:2}.failure-flow li{grid-template-columns:auto 1fr}.failure-flow li>div{grid-column:2}.failure-flow li>span{grid-row:1/4}}
  @media(max-width:520px){.request-trace{padding:.8rem}.projection-branches{grid-template-columns:1fr}.trace-flow article,.owner-flow article,.failure-flow li{padding:.7rem}.handoff{padding-left:.4rem}.trace-flow p,.owner-flow p,.failure-flow p{font-size:.72rem}}
  @media(prefers-color-scheme:dark){.request-trace{--paper:#202720;--paper-deep:#171d19;--ink:#edf1e9;--muted:#b8c3b6;--line:#465347;--accent:#a0ceac}}
</style>
