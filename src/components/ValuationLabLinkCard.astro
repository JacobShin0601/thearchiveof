---
interface Props {
  href: string;
  company: string;
  language?: 'ko' | 'en';
  focusKo: string;
  focusEn: string;
  tone?: 'green' | 'navy';
}
const { href, company, language = 'ko', focusKo, focusEn, tone = 'green' } = Astro.props;
const ko = language === 'ko';
---

<aside class={`valuation-lab-card valuation-lab-card--${tone}`} aria-label={ko ? '관련 가치평가 실험' : 'Related valuation experiment'}>
  <div class="valuation-lab-card__mark" aria-hidden="true">↗</div>
  <div class="valuation-lab-card__body">
    <p class="valuation-lab-card__kicker">RESEARCH → VALUATION LAB</p>
    <h3>{ko ? `${company} 가정을 직접 바꿔 보기` : `Stress-test ${company} yourself`}</h3>
    <p>{ko ? focusKo : focusEn}</p>
    <a href={href}>{ko ? '인터랙티브 가치평가 Lab 열기' : 'Open the interactive valuation Lab'} <span aria-hidden="true">→</span></a>
  </div>
</aside>

<style>
  .valuation-lab-card{--card-accent:#234c32;--card-kicker:#52705a;--card-border:#d5dfd1;--card-start:#f3f7f1;--card-end:#fbfcfa;display:grid;grid-template-columns:auto 1fr;gap:1rem;margin:2rem 0;padding:1.15rem 1.25rem;border:1px solid var(--card-border);border-radius:18px;background:linear-gradient(135deg,var(--card-start),var(--card-end));box-shadow:0 8px 24px rgba(31,62,39,.06)}.valuation-lab-card--navy{--card-accent:#173047;--card-kicker:#496d85;--card-border:#ccd9e1;--card-start:#f1f6f9;--card-end:#fafcfd}
  .valuation-lab-card__mark{display:grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:10px;background:var(--card-accent);color:#fff;font-size:1.2rem;font-weight:700}.valuation-lab-card__body{min-width:0}.valuation-lab-card__kicker{margin:0 0 .35rem;color:var(--card-kicker);font:700 .68rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.valuation-lab-card h3{margin:0;font-size:1.15rem;line-height:1.3}.valuation-lab-card p:not(.valuation-lab-card__kicker){margin:.45rem 0 .8rem;color:#5b665c;font-size:.92rem;line-height:1.6}.valuation-lab-card a{color:var(--card-accent);font-weight:700;text-decoration-thickness:1px;text-underline-offset:3px}.valuation-lab-card a:hover{filter:brightness(.72)}.valuation-lab-card a span{display:inline-block;margin-left:.2rem;transition:transform .2s ease}.valuation-lab-card a:hover span{transform:translateX(3px)}
  @media(max-width:540px){.valuation-lab-card{padding:1rem;gap:.75rem}.valuation-lab-card h3{font-size:1.05rem}.valuation-lab-card p:not(.valuation-lab-card__kicker){font-size:.88rem}}
</style>
