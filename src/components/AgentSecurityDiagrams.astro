---
interface Props {
  kind: 'boundaries' | 'decision' | 'credentials' | 'untrusted';
  language?: 'ko' | 'en';
  caption: string;
}

const { kind, language = 'ko', caption } = Astro.props;
const ko = language === 'ko';

const decisionSteps = ko
  ? [
      ['Authentication', '누가 요청했나?', 'user · workload identity'],
      ['Authorization', '이 action을 할 수 있나?', 'tenant · role · resource · scope'],
      ['Approval', '지금 이 exact action에 동의했나?', 'payload digest · expiry · reviewer'],
      ['Execution', '어떤 credential로 실행하나?', 'short-lived · audience-bound'],
    ]
  : [
      ['Authentication', 'Who made the request?', 'user · workload identity'],
      ['Authorization', 'May they perform this action?', 'tenant · role · resource · scope'],
      ['Approval', 'Was this exact action approved now?', 'payload digest · expiry · reviewer'],
      ['Execution', 'Which credential executes it?', 'short-lived · audience-bound'],
    ];
---

<figure class="security-diagram" aria-label={caption}>
  {kind === 'boundaries' && (
    <div class="boundaries">
      <div class="request"><strong>{ko ? 'User / Child Run' : 'User / Child Run'}</strong><code>identity · tenant · delegated scope</code></div>
      <i>↓</i>
      <div class="model"><span>{ko ? 'Untrusted decision maker' : 'Untrusted decision maker'}</span><strong>LLM / Planner</strong><code>proposes tool + arguments</code></div>
      <i>↓</i>
      <div class="enforcement"><section><strong>{ko ? 'Policy engine' : 'Policy engine'}</strong><code>authorize(action, resource, context)</code></section><section><strong>{ko ? 'Approval gate' : 'Approval gate'}</strong><code>digest · reviewer · expiry</code></section><section><strong>{ko ? 'Credential broker' : 'Credential broker'}</strong><code>scope · audience · TTL</code></section></div>
      <i>↓</i>
      <div class="tools"><span>Search</span><span>Database</span><span>Email</span><span>Code sandbox</span></div>
      <footer>{ko ? 'LLM은 action을 제안할 수 있지만 권한을 만들거나 credential을 선택하지 않는다.' : 'The LLM may propose an action; it cannot create permission or choose credentials.'}</footer>
    </div>
  )}

  {kind === 'decision' && (
    <div class="decision">
      {decisionSteps.map(([name, question, evidence], index) => <section><span>0{index + 1}</span><strong>{name}</strong><p>{question}</p><code>{evidence}</code></section>)}
      <footer><code>deny by default</code><i></i><code>allow exact action</code><i></i><code>audit outcome</code></footer>
    </div>
  )}

  {kind === 'credentials' && (
    <div class="credentials">
      <section class="unsafe"><span>{ko ? '위험' : 'Unsafe'}</span><strong>{ko ? '공용 장기 credential' : 'Shared long-lived credential'}</strong><code>worker env → every tool → every tenant</code><p>{ko ? '넓은 scope · 긴 TTL · 유출 시 큰 blast radius' : 'broad scope · long TTL · large blast radius'}</p></section>
      <i>→</i>
      <section class="safe"><span>{ko ? '권장' : 'Preferred'}</span><strong>{ko ? '실행 시점의 단기 token' : 'Just-in-time short-lived token'}</strong><code>run + tool + resource + audience + expiry</code><p>{ko ? 'parent 권한과 policy의 교집합만 발급' : 'intersection of parent grant and policy'}</p></section>
      <footer>{ko ? 'Credential은 prompt, checkpoint, event payload와 log에 들어가지 않는다.' : 'Credentials never belong in prompts, checkpoints, event payloads, or logs.'}</footer>
    </div>
  )}

  {kind === 'untrusted' && (
    <div class="untrusted">
      <div class="sources"><span>Web</span><span>Email</span><span>PDF</span><span>Tool output</span></div>
      <i>↓</i>
      <div class="taint"><strong>{ko ? 'UNTRUSTED CONTENT' : 'UNTRUSTED CONTENT'}</strong><code>content cannot grant authority</code></div>
      <i>↓</i>
      <div class="proposal"><strong>{ko ? 'Model proposal' : 'Model proposal'}</strong><code>send_email(recipient, body)</code></div>
      <i>↓</i>
      <div class="checks"><span>{ko ? 'schema 검증' : 'schema validation'}</span><span>{ko ? 'resource policy' : 'resource policy'}</span><span>{ko ? 'egress policy' : 'egress policy'}</span><span>{ko ? 'approval digest' : 'approval digest'}</span></div>
      <footer>{ko ? '외부 문서가 “이 지시를 따르라”고 말해도 trust label과 tool scope는 바뀌지 않는다.' : 'External content cannot change trust labels or tool scope by saying “follow these instructions.”'}</footer>
    </div>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .security-diagram{margin:2.5rem 0;padding:1.2rem;border:1px solid var(--line);border-radius:.9rem;background:var(--paper-deep);color:var(--ink);font-family:var(--sans);font-size:.9rem;line-height:1.5}.security-diagram figcaption{margin-top:1rem;color:var(--muted);font-size:.84rem;line-height:1.55}.security-diagram code{overflow-wrap:anywhere;color:var(--ink);font-size:.7rem}.boundaries{display:grid;gap:.35rem;text-align:center}.boundaries>i,.untrusted>i{color:var(--accent);font-style:normal}.request,.model{display:grid;gap:.2rem;max-width:25rem;margin:auto;padding:.65rem 1rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper)}.model{border-style:dashed}.model span{color:var(--accent);font-size:.62rem;font-weight:800;text-transform:uppercase}.enforcement{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem;padding:.55rem;border:2px solid var(--accent);border-radius:.6rem}.enforcement section{display:grid;gap:.25rem;padding:.55rem;background:var(--paper)}.enforcement strong{font-size:.7rem}.tools,.sources,.checks{display:flex;flex-wrap:wrap;justify-content:center;gap:.35rem}.tools span,.sources span,.checks span{padding:.35rem .55rem;border:1px solid var(--line);background:var(--paper);font-size:.66rem}.boundaries footer,.credentials footer,.untrusted footer{padding:.65rem;border-left:3px solid var(--accent);background:var(--paper);color:var(--muted);font-size:.71rem}
  .decision{display:grid;grid-template-columns:repeat(4,1fr);gap:.45rem}.decision section{position:relative;display:grid;gap:.25rem;padding:.7rem;border:1px solid var(--line);border-top:3px solid var(--accent);border-radius:.5rem;background:var(--paper)}.decision section:not(:nth-child(4)):after{content:'→';position:absolute;right:-.5rem;top:44%;z-index:1;color:var(--accent)}.decision section>span{color:var(--accent);font-size:.61rem;font-weight:800}.decision strong{font-size:.72rem}.decision p{margin:0;color:var(--muted);font-size:.66rem}.decision footer{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:.45rem;align-items:center;padding:.55rem;border:1px dashed var(--line);background:var(--paper)}.decision footer i{height:1px;background:var(--accent)}
  .credentials{display:grid;grid-template-columns:1fr auto 1fr;gap:.6rem;align-items:center}.credentials section{display:grid;gap:.35rem;padding:.8rem;border:1px solid var(--line);border-radius:.55rem;background:var(--paper)}.credentials section>span{color:var(--accent);font-size:.64rem;font-weight:800;text-transform:uppercase}.credentials section p{margin:0;color:var(--muted);font-size:.67rem}.credentials .unsafe{border-style:dashed}.credentials .safe{border:2px solid var(--accent)}.credentials>i{color:var(--accent);font-style:normal}.credentials footer{grid-column:1/-1}
  .untrusted{display:grid;gap:.35rem;text-align:center}.taint,.proposal{display:grid;gap:.2rem;max-width:24rem;margin:auto;padding:.65rem 1rem;border:1px solid var(--line);background:var(--paper)}.taint{border:1px dashed var(--accent)}.taint strong{color:var(--accent);font-size:.7rem}.proposal{border-radius:.5rem}.checks{padding:.55rem;border:2px solid var(--accent);border-radius:.55rem}
  @media(max-width:700px){.enforcement,.decision{grid-template-columns:1fr}.decision section:after{display:none}.decision footer{grid-column:1;grid-template-columns:1fr;text-align:center}.decision footer i{width:1px;height:.6rem;margin:auto}.credentials{grid-template-columns:1fr}.credentials>i{transform:rotate(90deg);text-align:center}.credentials footer{grid-column:1}}
  @media(max-width:480px){.security-diagram{padding:.8rem}.enforcement{padding:.35rem}.request,.model,.taint,.proposal{max-width:none}}
  @media(prefers-color-scheme:dark){.security-diagram{--paper:#202720;--paper-deep:#171d19;--ink:#edf1e9;--muted:#b8c3b6;--line:#465347;--accent:#a0ceac}}
</style>
