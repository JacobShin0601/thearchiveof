---
// Aggregate joint bins; each entry is [Kakao bin, Naver bin, restaurant count].
// Bins are half-open intervals of 0.5, with 5 included in the final bin.
const points = [[3,5,1],[3,6,6],[3,7,1],[4,6,32],[4,7,8],[5,6,52],[5,7,32],[6,5,2],[6,6,43],[6,7,95],[7,6,6],[7,7,64]];
const x = (i: number) => 55 + ((i + .5) / 8) * 300;
const y = (i: number) => 245 - ((i + .5) / 8) * 200;
---
<figure class="paired-chart" aria-labelledby="paired-chart-title">
  <figcaption id="paired-chart-title"><strong>같은 식당, 다른 점수</strong><span>두 점수가 모두 유효한 342곳 · 2026년 8월 자료</span></figcaption>
  <svg viewBox="0 0 400 290" role="img" aria-labelledby="paired-svg-title paired-svg-desc">
    <title id="paired-svg-title">카카오와 제공자 수록 네이버 점수의 공동 분포</title>
    <desc id="paired-svg-desc">카카오 점수를 가로축, 네이버 수록 점수를 세로축으로 0.5점 간격으로 묶었습니다. 점의 크기는 식당 수를 나타냅니다. 정확한 1대 1 비교 개수는 그림 아래에 표기했습니다.</desc>
    {[1,2,3,4,5].map(t => <g><line x1={55+(t-1)*75} x2={55+(t-1)*75} y1="45" y2="245" class="grid" /><text x={55+(t-1)*75} y="262" text-anchor="middle">{t}</text><line x1="55" x2="355" y1={245-(t-1)*50} y2={245-(t-1)*50} class="grid" /><text x="44" y={249-(t-1)*50} text-anchor="end">{t}</text></g>)}
    <line x1="55" y1="245" x2="355" y2="45" class="diagonal" />
    {points.map(([a,b,n]) => <g><circle cx={x(a)} cy={y(b)} r={Math.max(4, Math.sqrt(n) * 2.2)} class="dot"><title>{`카카오 ${1+a*.5}~${1+(a+1)*.5}점, 네이버 ${1+b*.5}~${1+(b+1)*.5}점: ${n}곳`}</title></circle><text x={x(a)} y={y(b)+3} class="count" text-anchor="middle">{n}</text></g>)}
    <text x="205" y="284" text-anchor="middle">카카오 점수</text><text x="17" y="144" transform="rotate(-90 17 144)" text-anchor="middle">제공자 수록 네이버 점수</text>
  </svg>
  <p>같은 식당별로 정확한 점수를 비교하면 네이버 수록 점수가 더 높은 곳 308곳, 카카오가 더 높은 곳 33곳, 같은 곳 1곳입니다. 점은 개인정보가 아닌 0.5점 구간별 식당 수이며 점 크기는 그 수에 비례해 커집니다. 구간 안에서는 대각선 위아래를 정확히 구분할 수 없습니다.</p>
  <small>출처: <a href="https://seoulrestaurants.com/data/">Seoul Restaurants Open Data</a>. 점수의 원천·매칭 정확성 미확인, 선정된 표본이며 실제 품질이나 원인을 뜻하지 않습니다.</small>
</figure>
<style>
  .paired-chart { margin: 2rem 0; padding: 1.35rem; border: 1px solid var(--border, #d8d8d8); border-radius: 12px; }
  figcaption strong, figcaption span { display:block; } figcaption span, small { font-size:.86rem; color:var(--muted,#666); margin-top:.3rem; }
  svg { width:100%; height:auto; margin: 1rem 0 .2rem; } svg text { font: 10px sans-serif; fill:var(--muted,#555); } .grid { stroke:#dedede; stroke-width:1; } .diagonal { stroke:#876355; stroke-width:1.5; stroke-dasharray:5 4; } .dot { fill:#315f68; fill-opacity:.75; stroke:#fff; stroke-width:1; } svg .count { fill:white; font-size:8px; font-weight:bold; }
  p { font-size:.9rem; margin:.6rem 0; } @media(max-width:400px) { .paired-chart { padding:1rem; } }
</style>
