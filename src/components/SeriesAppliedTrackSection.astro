---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import {
  AGENT_ENGINEERING_APPLIED_TRACKS,
  appliedTrackDetailMeta,
  appliedTrackPath,
} from '../lib/series-sections';

interface Props {
  detailSeriesName: (typeof AGENT_ENGINEERING_APPLIED_TRACKS)[number];
  trackPosts: CollectionEntry<'posts'>[];
  language: 'ko' | 'en';
}

const { detailSeriesName, trackPosts, language } = Astro.props;
const meta = appliedTrackDetailMeta(detailSeriesName);
const isKo = language === 'ko';
const trackHref = appliedTrackPath(detailSeriesName, language);
const countLabel = isKo ? `${trackPosts.length}편` : `${trackPosts.length} article${trackPosts.length === 1 ? '' : 's'}`;
---

<section class="series-section-block series-applied-track" aria-labelledby="series-applied-track">
  <header class="series-section-heading">
    <p class="eyebrow">{isKo ? 'Applied Track' : 'Applied Track'}</p>
    <h2 id="series-applied-track">{meta.trackTitle[language]}</h2>
    <p class="series-section-dek">{meta.sectionDek[language]}</p>
  </header>
  <a class="applied-track-card" href={trackHref}>
    <p class="applied-track-eyebrow">{isKo ? `Applied Track · ${countLabel}` : `Applied Track · ${countLabel.toUpperCase()}`}</p>
    <p class="applied-track-title">{meta.trackTitle[language]}</p>
    <p class="applied-track-dek">
      {isKo
        ? '내부 GPU에서 모델을 선택하고, 튜닝하고, 병목을 진단하는 실전 과정'
        : 'Choose, tune, and troubleshoot models served on internal GPUs.'}
    </p>
  </a>
  {trackPosts.length > 0 ? (
    <div class="post-grid series-section-grid">
      {trackPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <p class="empty-state">
      {isKo ? '이 트랙의 글이 준비 중입니다.' : 'Articles for this track are being prepared.'}
    </p>
  )}
</section>

<style>
  .applied-track-card {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    background: var(--paper-deep);
    text-decoration: none;
    color: inherit;
  }
  .applied-track-card:hover {
    border-color: var(--accent);
  }
  .applied-track-eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .applied-track-title {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .applied-track-dek {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
