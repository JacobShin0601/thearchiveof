<section class="analytics-dashboard" data-analytics-dashboard>
  <div class="access-panel">
    <div>
      <p class="eyebrow">Private aggregate feed</p>
      <h2>읽기 토큰으로 연결</h2>
      <p>토큰은 이 탭의 메모리에서만 사용하며 저장하지 않습니다. 원시 IP, 전체 User-Agent, 방문자 식별자는 이 화면에 제공되지 않습니다.</p>
    </div>
    <form data-access-form>
      <label>
        <span>Analytics read token</span>
        <input name="token" type="password" autocomplete="off" spellcheck="false" required />
      </label>
      <label>
        <span>비교 기간</span>
        <select name="days">
          <option value="7">최근 7일</option>
          <option value="30" selected>최근 30일</option>
          <option value="90">최근 90일</option>
        </select>
      </label>
      <button type="submit">불러오기</button>
    </form>
    <p class="status" data-status role="status">토큰을 입력하면 집계 데이터를 불러옵니다.</p>
  </div>

  <div class="dashboard-content" data-content hidden>
    <header class="dashboard-meta">
      <div>
        <p class="eyebrow">Cloudflare zone analytics + first-party events</p>
        <h2>독자, AI 크롤, AI 유입, 판단 후보</h2>
      </div>
      <p data-freshness></p>
    </header>

    <nav class="section-nav" aria-label="대시보드 구역">
      <a href="#signals">신호</a>
      <a href="#readers">독자</a>
      <a href="#ai-crawl">AI 크롤</a>
      <a href="#ai-referral">AI 유입</a>
      <a href="#strategy">판단 후보</a>
    </nav>

    <section id="signals" class="panel-block">
      <div class="panel-heading">
        <div><p class="eyebrow">Signal layers</p><h3>Human / Search / AI</h3></div>
        <p>같은 기간의 신호를 겹치지 않게 분리합니다. Visits만으로 사람을 단정하지 마세요.</p>
      </div>
      <dl class="signal-grid">
        <div>
          <dt>Human visits</dt>
          <dd data-signal="human">—</dd>
          <small data-signal-note="human">Useful·Lab 이벤트와 함께 봅니다.</small>
        </div>
        <div>
          <dt>Search crawl</dt>
          <dd data-signal="search">—</dd>
          <small data-signal-note="search">Googlebot, Bingbot 등 검색 인덱싱</small>
        </div>
        <div>
          <dt>AI crawl</dt>
          <dd data-signal="ai">—</dd>
          <small data-signal-note="ai">training / user-fetch / agent</small>
        </div>
      </dl>
    </section>

    <section id="readers" class="panel-block">
      <div class="panel-heading">
        <div><p class="eyebrow">Readers</p><h3>독자</h3></div>
        <p>사람 visits와 HTTP 요청을 분리해서 봅니다.</p>
      </div>
      <dl class="metric-grid">
        <div><dt>Visits</dt><dd data-metric="visits">—</dd><small data-change="visits">—</small></div>
        <div><dt>HTTP requests</dt><dd data-metric="requests">—</dd><small data-change="requests">—</small></div>
        <div><dt>Transferred</dt><dd data-metric="bytes">—</dd><small data-change="bytes">—</small></div>
      </dl>
      <div class="trend-panel">
        <div class="panel-heading">
          <div><p class="eyebrow">Daily trend</p><h3>Visits</h3></div>
        </div>
        <svg data-trend viewBox="0 0 900 260" role="img" aria-label="일별 visits 추이"></svg>
      </div>
      <div class="table-grid">
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Discovery</p><h3>상위 글</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>글</th><th>언어</th><th>Visits</th><th>Useful</th><th>Impact</th></tr></thead>
              <tbody data-top-articles></tbody>
            </table>
          </div>
        </section>
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Geography</p><h3>상위 국가</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>국가</th><th>Visits</th><th>Requests</th></tr></thead>
              <tbody data-countries></tbody>
            </table>
          </div>
        </section>
      </div>
    </section>

    <section id="ai-crawl" class="panel-block">
      <div class="panel-heading">
        <div><p class="eyebrow">AI crawl</p><h3>AI 크롤</h3></div>
        <p data-crawler-success>알려진 크롤러만 카탈로그 키로 집계합니다.</p>
      </div>
      <div class="table-grid">
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Operators</p><h3>크롤러</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Crawler</th><th>Operator</th><th>Category</th><th>Requests</th><th>Bytes</th></tr></thead>
              <tbody data-crawlers></tbody>
            </table>
          </div>
        </section>
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Paths</p><h3>많이 읽힌 경로</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>경로</th><th>Crawler</th><th>Requests</th></tr></thead>
              <tbody data-crawler-paths></tbody>
            </table>
          </div>
        </section>
      </div>
    </section>

    <section id="ai-referral" class="panel-block">
      <div class="panel-heading">
        <div><p class="eyebrow">AI referral</p><h3>AI 유입</h3></div>
        <p data-referrer-status>ChatGPT, Perplexity, Gemini, Copilot, Claude referrer.</p>
      </div>
      <div class="table-grid" data-referrer-tables>
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Sources</p><h3>서비스</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Source</th><th>Visits</th><th>Requests</th></tr></thead>
              <tbody data-referrer-sources></tbody>
            </table>
          </div>
        </section>
        <section>
          <div class="panel-heading"><div><p class="eyebrow">Landing</p><h3>도착 글</h3></div></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Source</th><th>경로</th><th>Visits</th></tr></thead>
              <tbody data-referrer-paths></tbody>
            </table>
          </div>
        </section>
      </div>
    </section>

    <section id="strategy" class="panel-block">
      <div class="panel-heading">
        <div><p class="eyebrow">Strategy</p><h3>판단 후보</h3></div>
        <p>규칙 기반 후보만 보여 줍니다. 발행 전략은 직접 결정하세요.</p>
      </div>
      <div class="candidate-list" data-candidates></div>
      <div class="table-wrap wide">
        <table>
          <thead>
            <tr>
              <th>글</th>
              <th>언어</th>
              <th>Visits</th>
              <th>AI crawl</th>
              <th>AI referral</th>
              <th>Useful</th>
              <th>Impact</th>
              <th>Code run</th>
              <th>Lang switch</th>
              <th>검토</th>
            </tr>
          </thead>
          <tbody data-strategy-articles></tbody>
        </table>
      </div>
    </section>

    <aside class="reading-note">
      <strong>해석 규칙</strong>
      <p>Requests는 페이지뷰가 아닙니다. Human visits, Search crawl, AI crawl을 먼저 분리한 뒤 Useful·Impact를 보세요. Impact는 Useful×3 + code_run×2 + language_switch 참고값이며 SEO 순위가 아닙니다. 표본이 작을 때는 방향성만 읽습니다.</p>
    </aside>
  </div>
</section>

<script>
  type MetricValue = { current: number; previous: number; change: number | null };
  type DailyRow = { day: string; requests: number; visits: number; bytes: number };
  type ArticleRow = {
    path: string;
    title: string;
    language: string;
    visits: number;
    crawlerRequests: number;
    aiReferrerVisits: number;
    useful: number;
    reviewState: string;
    events: { code_run: number; language_switch: number };
    impact: { score: number; usefulRate: number; label: string };
  };
  type Candidate = {
    type: string;
    action: string;
    reason: string;
    title?: string;
    path?: string;
    topic?: string;
    smallSample: boolean;
    note: string;
  };
  type AnalyticsPayload = {
    ok: boolean;
    error?: string;
    metadata: {
      windowStart: string;
      windowEnd: string;
      refreshedAt: string;
      capabilities?: { referrers?: { available: boolean; detail: string } };
    };
    overview: { visits: MetricValue; requests: MetricValue; bytes: MetricValue };
    signals: {
      human: { visits: number; note: string };
      search: { requests: number; bytes: number };
      ai: { requests: number; bytes: number; training: number; userFetch: number; agent: number };
    };
    daily: DailyRow[];
    readers: {
      countries: Array<{ country: string; visits: number; requests: number }>;
      topArticles: ArticleRow[];
    };
    aiCrawl: {
      crawlers: Array<{ crawler: string; operator: string; category: string; requests: number; bytes: number }>;
      topPaths: Array<{ path: string; crawler: string; requests: number }>;
      statuses: { successShare: number | null };
    };
    aiReferral: {
      available: boolean;
      unavailableReason: string | null;
      sources: Array<{ source: string; visits: number; requests: number }>;
      topPaths: Array<{ source: string; path: string; visits: number }>;
    };
    strategy: { articles: ArticleRow[]; candidates: Candidate[] };
  };

  const root = document.querySelector<HTMLElement>('[data-analytics-dashboard]');
  const form = root?.querySelector<HTMLFormElement>('[data-access-form]');
  const status = root?.querySelector<HTMLElement>('[data-status]');
  const content = root?.querySelector<HTMLElement>('[data-content]');

  const number = new Intl.NumberFormat('ko-KR');
  const compact = new Intl.NumberFormat('ko-KR', { notation: 'compact', maximumFractionDigits: 1 });

  function setText(selector: string, value: string) {
    const element = root?.querySelector(selector);
    if (element) element.textContent = value;
  }

  function changeLabel(change: number | null) {
    if (change == null) return '직전 기간 0 · 비교 불가';
    const sign = change > 0 ? '+' : '';
    return `직전 기간 대비 ${sign}${(change * 100).toFixed(1)}%`;
  }

  function impactLabel(row: ArticleRow) {
    const impact = row.impact ?? { score: 0, usefulRate: 0, label: 'weak' };
    const rate = `${(impact.usefulRate * 100).toFixed(0)}%`;
    return `${impact.score} · ${impact.label} · useful ${rate}`;
  }

  function metric(name: string, value: MetricValue, formatter: Intl.NumberFormat = number) {
    setText(`[data-metric="${name}"]`, formatter.format(value.current));
    setText(`[data-change="${name}"]`, changeLabel(value.change));
  }

  function renderSignals(signals: AnalyticsPayload['signals'], visitChange: MetricValue) {
    setText('[data-signal="human"]', number.format(signals.human.visits));
    setText('[data-signal-note="human"]', `${changeLabel(visitChange.change)} · ${signals.human.note}`);
    setText('[data-signal="search"]', number.format(signals.search.requests));
    setText('[data-signal-note="search"]', `검색 크롤 요청 · ${compact.format(signals.search.bytes)} transferred`);
    setText('[data-signal="ai"]', number.format(signals.ai.requests));
    setText(
      '[data-signal-note="ai"]',
      `training ${number.format(signals.ai.training)} · user-fetch ${number.format(signals.ai.userFetch)} · agent ${number.format(signals.ai.agent)}`,
    );
  }

  function renderTrend(rows: DailyRow[]) {
    const svg = root?.querySelector<SVGElement>('[data-trend]');
    if (!(svg instanceof SVGElement)) return;
    svg.replaceChildren();
    if (!rows.length) {
      const empty = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      empty.setAttribute('x', '450'); empty.setAttribute('y', '130'); empty.setAttribute('text-anchor', 'middle');
      empty.textContent = '아직 표시할 데이터가 없습니다.';
      svg.append(empty); return;
    }
    const width = 900; const height = 260; const pad = 34;
    const max = Math.max(1, ...rows.map((row) => row.visits));
    const points = rows.map((row, index) => {
      const x = rows.length === 1 ? width / 2 : pad + index * ((width - pad * 2) / (rows.length - 1));
      const y = height - pad - (row.visits / max) * (height - pad * 2);
      return `${x},${y}`;
    }).join(' ');
    const baseline = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    baseline.setAttribute('x1', String(pad)); baseline.setAttribute('x2', String(width - pad));
    baseline.setAttribute('y1', String(height - pad)); baseline.setAttribute('y2', String(height - pad));
    baseline.setAttribute('class', 'baseline');
    const polyline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
    polyline.setAttribute('points', points); polyline.setAttribute('class', 'trend-line');
    const start = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    start.setAttribute('x', String(pad)); start.setAttribute('y', String(height - 8)); start.textContent = rows[0].day;
    const end = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    end.setAttribute('x', String(width - pad)); end.setAttribute('y', String(height - 8)); end.setAttribute('text-anchor', 'end');
    end.textContent = rows[rows.length - 1]!.day;
    svg.append(baseline, polyline, start, end);
  }

  function renderRows<Row>(selector: string, rows: Row[], cells: Array<(row: Row) => string>) {
    const body = root?.querySelector(selector);
    if (!(body instanceof HTMLElement)) return;
    body.replaceChildren();
    if (!rows.length) {
      const row = document.createElement('tr'); const cell = document.createElement('td');
      cell.colSpan = cells.length; cell.textContent = '데이터 없음'; row.append(cell); body.append(row); return;
    }
    for (const item of rows) {
      const row = document.createElement('tr');
      for (const cellValue of cells) {
        const cell = document.createElement('td'); cell.textContent = cellValue(item); row.append(cell);
      }
      body.append(row);
    }
  }

  function reviewLabel(state: string) {
    if (state === 'overdue') return '기한 지남';
    if (state === 'upcoming') return '30일 이내';
    if (state === 'scheduled') return '예약됨';
    return '미예약';
  }

  function actionLabel(action: string) {
    if (action === 'expand') return '확장';
    if (action === 'refresh') return '갱신';
    if (action === 'defend') return '방어';
    if (action === 'fix') return '수정';
    return action;
  }

  function renderCandidates(candidates: Candidate[]) {
    const host = root?.querySelector('[data-candidates]');
    if (!(host instanceof HTMLElement)) return;
    host.replaceChildren();
    if (!candidates.length) {
      const empty = document.createElement('p');
      empty.className = 'empty-candidates';
      empty.textContent = '현재 규칙에 걸린 후보가 없습니다.';
      host.append(empty);
      return;
    }
    for (const candidate of candidates) {
      const card = document.createElement('article');
      card.className = 'candidate-card';
      const eyebrow = document.createElement('p');
      eyebrow.className = 'eyebrow';
      eyebrow.textContent = `${actionLabel(candidate.action)} · ${candidate.type}`;
      const title = document.createElement('h4');
      title.textContent = candidate.title || candidate.topic || candidate.path || candidate.type;
      const reason = document.createElement('p');
      reason.textContent = candidate.reason;
      const note = document.createElement('small');
      note.textContent = candidate.note;
      card.append(eyebrow, title, reason, note);
      host.append(card);
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const token = String(data.get('token') ?? '').trim();
    const days = String(data.get('days') ?? '30');
    if (!token || !status || !content) return;
    status.textContent = '집계 데이터를 불러오는 중…';
    try {
      const response = await fetch(`/api/ops/analytics?days=${encodeURIComponent(days)}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const payload = await response.json() as AnalyticsPayload;
      if (!response.ok || !payload.ok) throw new Error(payload.error ?? `HTTP ${response.status}`);

      metric('visits', payload.overview.visits);
      metric('requests', payload.overview.requests);
      metric('bytes', payload.overview.bytes, compact);
      renderSignals(payload.signals, payload.overview.visits);
      renderTrend(payload.daily);

      renderRows('[data-top-articles]', payload.readers.topArticles, [
        (row) => row.title || row.path,
        (row) => row.language,
        (row) => number.format(row.visits),
        (row) => number.format(row.useful),
        (row) => impactLabel(row),
      ]);
      renderRows('[data-countries]', payload.readers.countries, [
        (row) => row.country,
        (row) => number.format(row.visits),
        (row) => number.format(row.requests),
      ]);

      const success = payload.aiCrawl.statuses.successShare;
      setText('[data-crawler-success]', success == null
        ? '알려진 크롤러 성공 응답 비율을 아직 계산할 수 없습니다.'
        : `알려진 크롤러 성공 응답 비율 ${(success * 100).toFixed(1)}%`);
      renderRows('[data-crawlers]', payload.aiCrawl.crawlers, [
        (row) => row.crawler,
        (row) => row.operator,
        (row) => row.category,
        (row) => number.format(row.requests),
        (row) => compact.format(row.bytes),
      ]);
      renderRows('[data-crawler-paths]', payload.aiCrawl.topPaths, [
        (row) => row.path,
        (row) => row.crawler,
        (row) => number.format(row.requests),
      ]);

      const referrerTables = root?.querySelector<HTMLElement>('[data-referrer-tables]');
      if (payload.aiReferral.available) {
        setText('[data-referrer-status]', 'AI 서비스 referrer visits와 도착 경로입니다.');
        if (referrerTables) referrerTables.hidden = false;
        renderRows('[data-referrer-sources]', payload.aiReferral.sources, [
          (row) => row.source,
          (row) => number.format(row.visits),
          (row) => number.format(row.requests),
        ]);
        renderRows('[data-referrer-paths]', payload.aiReferral.topPaths, [
          (row) => row.source,
          (row) => row.path,
          (row) => number.format(row.visits),
        ]);
      } else {
        setText('[data-referrer-status]', payload.aiReferral.unavailableReason ?? '리퍼러 차원을 사용할 수 없습니다.');
        if (referrerTables) referrerTables.hidden = true;
      }

      renderCandidates(payload.strategy.candidates);
      renderRows('[data-strategy-articles]', payload.strategy.articles, [
        (row) => row.title || row.path,
        (row) => row.language,
        (row) => number.format(row.visits),
        (row) => number.format(row.crawlerRequests),
        (row) => number.format(row.aiReferrerVisits),
        (row) => number.format(row.useful),
        (row) => impactLabel(row),
        (row) => number.format(row.events.code_run),
        (row) => number.format(row.events.language_switch),
        (row) => reviewLabel(row.reviewState),
      ]);

      setText('[data-freshness]', `집계 ${payload.metadata.windowStart}–${payload.metadata.windowEnd} · 동기화 ${payload.metadata.refreshedAt}`);
      content.hidden = false;
      status.textContent = '연결됨. 토큰은 저장되지 않았습니다.';
    } catch (error) {
      content.hidden = true;
      status.textContent = `불러오지 못했습니다: ${error instanceof Error ? error.message : 'unknown error'}`;
    }
  });
</script>

<style>
  .analytics-dashboard { margin-top: 42px; }
  .access-panel, .trend-panel, .table-grid > section, .reading-note, .panel-block, .candidate-card {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 96%, var(--ink));
  }
  .access-panel { display: grid; grid-template-columns: 1.1fr 1fr; gap: 28px; padding: 28px; }
  .access-panel h2, .dashboard-meta h2, .panel-heading h3, .candidate-card h4 {
    margin: 8px 0 0; font-family: var(--serif); font-weight: 400;
  }
  .access-panel h2 { font-size: 28px; }
  .access-panel p { color: var(--muted); font-size: 13px; line-height: 1.6; }
  .access-panel form { display: grid; grid-template-columns: 1fr 140px auto; gap: 10px; align-items: end; }
  .access-panel label span { display: block; margin-bottom: 7px; color: var(--muted); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
  .access-panel input, .access-panel select, .access-panel button {
    width: 100%; min-height: 42px; border: 1px solid var(--ink); border-radius: 0;
    background: var(--paper); color: var(--ink); font: inherit;
  }
  .access-panel input, .access-panel select { padding: 0 10px; }
  .access-panel button { padding: 0 16px; background: var(--ink); color: var(--paper); cursor: pointer; }
  .status { grid-column: 1 / -1; margin: 0; }
  .dashboard-content { margin-top: 64px; }
  .dashboard-meta { display: flex; justify-content: space-between; gap: 30px; align-items: end; margin-bottom: 24px; }
  .dashboard-meta h2 { max-width: 780px; font-size: clamp(32px, 5vw, 58px); line-height: .95; letter-spacing: -.04em; }
  .dashboard-meta > p { max-width: 320px; color: var(--muted); font-size: 11px; text-align: right; }
  .section-nav { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 28px; }
  .section-nav a {
    padding: 8px 12px; border: 1px solid var(--line); color: var(--ink); text-decoration: none;
    font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
  }
  .panel-block { padding: 24px; margin-bottom: 22px; }
  .metric-grid, .signal-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 0 22px; }
