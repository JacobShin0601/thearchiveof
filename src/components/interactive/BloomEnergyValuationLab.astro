---
interface Props { language?: 'ko' | 'en' }
const { language = 'ko' } = Astro.props;
const ko = language === 'ko';
---
<section class="bloom-lab" data-bloom-lab data-language={language}>
  <header><div><p>THE ARCHIVE / VALUATION LAB</p><h3>Bloom Energy Corporation Valuation Lab</h3><span>{ko ? '발표된 GW가 아니라 인도 GW·마진·희석을 거친 보통주 가치를 점검합니다.' : 'Test common-equity value after delivered GW, margins, and dilution—not headline contract capacity.'}</span></div><b>FCFF · REVERSE</b></header>
  <div class="toolbar"><span>{ko ? '프리셋' : 'Presets'}</span><button data-preset="bear">Bear</button><button data-preset="base" class="active">Base</button><button data-preset="bull">Bull</button><button data-reset>{ko ? '초기화' : 'Reset'}</button></div>
  <div class="cards" aria-live="polite"><div><span>{ko ? '기준 종가' : 'Decision close'}</span><strong>$236.30</strong><small>2026-10-15</small></div><div class="primary"><span>{ko ? '적정가치' : 'Fair value'}</span><strong data-out="fair">—</strong><small data-out="premium">—</small></div><div><span>{ko ? '2030 매출' : '2030 revenue'}</span><strong data-out="revenue">—</strong><small>{ko ? '모델 산출' : 'Model output'}</small></div><div><span>{ko ? '2030 EBIT 마진' : '2030 EBIT margin'}</span><strong data-out="margin">—</strong><small>{ko ? '모델 산출' : 'Model output'}</small></div></div>
  <section class="reverse"><div><p>REVERSE VALUATION</p><h4>{ko ? '현재가를 정당화하려면 2030년에 몇 GW를 팔아야 할까?' : 'How many GW must Bloom deliver in 2030 to support today’s price?'}</h4><span data-out="reverse"></span></div><strong data-out="required">—</strong></section>
  <div class="grid"><section class="controls"><p>01 / {ko ? '핵심 가정' : 'CORE ASSUMPTIONS'}</p><label><span>{ko ? '출하량 스케일' : 'Delivery scale'} <output data-value="delivery"></output></span><input name="delivery" type="range" min="50" max="200" step="5" value="100"></label><label><span>{ko ? '제품 매출총이익률' : 'Product gross margin'} <output data-value="margin"></output></span><input name="margin" type="range" min="15" max="45" step="1" value="28"></label><label><span>{ko ? '영업비용률' : 'Operating expense ratio'} <output data-value="opex"></output></span><input name="opex" type="range" min="10" max="28" step="1" value="18"></label><label><span>{ko ? '할인율' : 'Discount rate'} <output data-value="discount"></output></span><input name="discount" type="range" min="7" max="14" step=".5" value="9.5"></label><details><summary>{ko ? '고급 설정' : 'Advanced settings'}</summary><label><span>{ko ? 'MW당 장비 매출' : 'Equipment revenue / MW'} <output data-value="asp"></output></span><input name="asp" type="range" min="1.5" max="3" step=".05" value="2.1"></label><label><span>{ko ? '희석 주식 수' : 'Diluted shares'} <output data-value="shares"></output></span><input name="shares" type="range" min="220" max="280" step="1" value="235"></label><label><span>{ko ? '영구성장률' : 'Terminal growth'} <output data-value="terminal"></output></span><input name="terminal" type="range" min="1" max="4" step=".25" value="2.5"></label></details><small>{ko ? 'Bull의 4.0GW는 현재 발표된 2GW 생산능력을 넘어서므로 추가 증설을 전제합니다.' : 'The 4.0GW Bull case exceeds announced 2GW capacity and assumes further expansion.'}</small></section><section class="bridge"><p>02 / {ko ? '현금흐름 브리지' : 'CASH-FLOW BRIDGE'}</p><dl><div><dt>{ko ? '제품 + 설치 매출' : 'Product + installation revenue'}</dt><dd data-out="product">—</dd></div><div><dt>{ko ? '서비스 + 전력 매출' : 'Service + electricity revenue'}</dt><dd data-out="service">—</dd></div><div><dt>EBIT</dt><dd data-out="ebit">—</dd></div><div><dt>FCFF</dt><dd data-out="fcff">—</dd></div><div><dt>{ko ? '보통주 가치' : 'Common equity value'}</dt><dd data-out="equity">—</dd></div></dl><small>{ko ? 'FCFF = NOPAT + 감가상각 − CAPEX − 운전자본 증가. 고객 선수금 증가를 영구 현금흐름으로 복사하지 않습니다.' : 'FCFF = NOPAT + D&A − CAPEX − increase in working capital. Customer-deposit growth is not copied into perpetuity.'}</small></section></div>
  <section class="heatmap"><p>03 / {ko ? '민감도' : 'SENSITIVITY'}</p><h4>{ko ? '2030 매출 × EBIT 마진의 주당 가치' : '2030 revenue × EBIT margin per-share sensitivity'}</h4><div><table><thead><tr><th>{ko ? '매출 / EBIT' : 'Revenue / EBIT'}</th><th>10%</th><th>15%</th><th>20%</th><th>25%</th></tr></thead><tbody data-heatmap></tbody></table></div></section>
  <footer>{ko ? '기준일 2026-10-15 · Q2 2026 10-Q/A·Q2 실적·Oracle·Brookfield·AEP 공시를 출발점으로 한 교육용 모델입니다. 옵션·금융 프레임워크·프로젝트 총액은 Bloom 매출로 넣지 않았습니다.' : 'As of 2026-10-15 · Educational model anchored in Q2 2026 10-Q/A, results, and Oracle, Brookfield, and AEP disclosures. Options, financing frameworks, and total project investment are not entered as Bloom revenue.'}</footer>
</section>
<script>
  import { BLOOM_CURRENT_PRICE, bloomScenarios, calculateBloomDcf, solveBloomDeliveryScale } from '../../data/bloom-energy-valuation';
  document.querySelectorAll<HTMLElement>('[data-bloom-lab]').forEach((root) => {
    const ko = root.dataset.language !== 'en';
    const preset = { bear:{ margin:23,opex:20,discount:11,asp:2.1,shares:235,terminal:2 }, base:{ margin:28,opex:18,discount:9.5,asp:2.1,shares:235,terminal:2.5 }, bull:{ margin:34,opex:16,discount:9,asp:2.2,shares:245,terminal:3 } } as const;
    let active: keyof typeof preset = 'base';
    const get=(n:string)=>root.querySelector<HTMLInputElement>('[name="'+n+'"]')!;
    const n=(x:string)=>Number(get(x).value);
    const out=(x:string,v:string)=>{const el=root.querySelector<HTMLElement>('[data-out="'+x+'"]');if(el)el.textContent=v};
    const bn=(x:number)=>'$'+(x/1000).toFixed(1)+'B';
    const calc=()=>{const s=bloomScenarios[active],scale=n('delivery')/100;return calculateBloomDcf({...s,deliveredGw:s.deliveredGw.map((v)=>v*scale) as typeof s.deliveredGw,productGrossMargin:n('margin')/100,operatingExpenseRatio:n('opex')/100,discountRate:n('discount')/100,equipmentRevenuePerMw:n('asp'),dilutedShares:n('shares'),terminalGrowth:n('terminal')/100})};
    const render=()=>{const r=calc(),last=r.projections.at(-1)!;const labels={delivery:n('delivery')+'%',margin:n('margin')+'%',opex:n('opex')+'%',discount:n('discount').toFixed(1)+'%',asp:'$'+n('asp').toFixed(2)+'M',shares:n('shares')+'M',terminal:n('terminal').toFixed(2)+'%'};Object.entries(labels).forEach(([k,v])=>{const el=root.querySelector<HTMLOutputElement>('[data-value="'+k+'"]');if(el)el.value=v});out('fair','$'+r.fairValuePerShare.toFixed(0));out('premium',ko?(r.upside<0?'기준가 대비 '+(-r.upside*100).toFixed(0)+'% 할인':'기준가 대비 '+(r.upside*100).toFixed(0)+'% 상승여력'):(r.upside<0?(-r.upside*100).toFixed(0)+'% below reference':(r.upside*100).toFixed(0)+'% upside'));out('revenue',bn(last.revenue));out('margin',(last.ebit/last.revenue*100).toFixed(1)+'%');out('product',bn(last.productRevenue+last.installationRevenue));out('service',bn(last.serviceRevenue+last.electricityRevenue));out('ebit',bn(last.ebit));out('fcff',bn(last.fcff));out('equity',bn(r.equityValue));const reverse=solveBloomDeliveryScale({targetPrice:BLOOM_CURRENT_PRICE,assumptions:{...r}});if(reverse){out('required',reverse.deliveredGw2030.toFixed(1)+' GW');out('reverse',ko?'현재 단가·마진·할인율이 그대로라면 2030년 인도량은 약 '+reverse.deliveredGw2030.toFixed(1)+'GW가 필요합니다. 현재 입력 '+last.deliveredGw.toFixed(1)+'GW보다 '+(reverse.scale*100-100).toFixed(0)+'% 높습니다.':'At current unit economics, 2030 delivery must reach '+reverse.deliveredGw2030.toFixed(1)+'GW, '+(reverse.scale*100-100).toFixed(0)+'% above this input.')}else{out('required',ko?'범위 밖':'Out of range');out('reverse',ko?'현재 슬라이더 범위로는 기준가를 역산할 수 없습니다.':'The reference price is outside this slider range.')};const body=root.querySelector<HTMLTableSectionElement>('[data-heatmap]')!;body.replaceChildren(...[5,7.5,10,12.5].map((rev)=>{const tr=document.createElement('tr'),th=document.createElement('th');th.textContent='$'+rev.toFixed(1)+'B';tr.append(th);[.1,.15,.2,.25].forEach((m)=>{const td=document.createElement('td'),proxy=rev*1000*m*(1-r.taxRate)/Math.max(.01,r.discountRate-r.terminalGrowth)/(1+r.discountRate)**4/r.dilutedShares;td.textContent='$'+proxy.toFixed(0);if(proxy>=BLOOM_CURRENT_PRICE)td.className='above';tr.append(td)});return tr}))};
    const set=(name:keyof typeof preset)=>{active=name;Object.entries(preset[name]).forEach(([k,v])=>get(k).value=String(v));root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b)=>b.classList.toggle('active',b.dataset.preset===name));render()};
    root.querySelectorAll<HTMLInputElement>('input').forEach((i)=>i.addEventListener('input',()=>{root.querySelectorAll('[data-preset]').forEach((b)=>b.classList.remove('active'));render()}));root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b)=>b.addEventListener('click',()=>set(b.dataset.preset as keyof typeof preset)));root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click',()=>set('base'));render();
  });
</script>
<style>
.bloom-lab{--ink:#17263b;--muted:#607085;--line:#d6e0e8;--blue:#155d9b;box-sizing:border-box;margin:2rem 0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:20px;background:#f5f9fc;color:var(--ink);font-family:var(--sans)}.bloom-lab *{box-sizing:border-box;min-width:0}.bloom-lab header,.grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem}.bloom-lab header p,.controls>p,.bridge>p,.heatmap>p{margin:0 0 .35rem;color:var(--blue);font-size:.72rem;font-weight:700;letter-spacing:.09em}.bloom-lab h3{margin:.2rem 0 .5rem;font-size:clamp(1.3rem,3vw,1.8rem)}.bloom-lab header span,small,footer{color:var(--muted);line-height:1.5}.bloom-lab header b{padding:.4rem .6rem;border:1px solid #a9bfd0;border-radius:999px;color:var(--blue);font-size:.72rem;white-space:nowrap}.toolbar{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;margin:1.2rem 0}.bloom-lab button{border:1px solid var(--line);border-radius:999px;padding:.45rem .7rem;background:#fff;color:var(--ink);font:inherit;cursor:pointer}.bloom-lab button.active{border-color:var(--blue);background:var(--blue);color:#fff}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem}.cards>div,.controls,.bridge,.heatmap{padding:1rem;border:1px solid var(--line);border-radius:12px;background:#fff}.cards .primary{border-color:var(--blue);background:#eaf5fc}.cards span,.cards small{display:block;font-size:.74rem}.cards strong{display:block;margin:.35rem 0;font-size:1.35rem;font-variant-numeric:tabular-nums}.reverse{display:flex;justify-content:space-between;gap:1rem;margin:1rem 0;padding:1rem;border-left:4px solid var(--blue);background:#e8f3fb}.reverse p{margin:0 0 .35rem;color:var(--blue);font-size:.72rem;font-weight:700}.reverse h4{margin:.2rem 0}.reverse strong{align-self:center;color:var(--blue);font-size:clamp(1.4rem,4vw,2rem);white-space:nowrap}.grid{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}label{display:block;margin:.85rem 0}label span{display:flex;justify-content:space-between;gap:.5rem;font-size:.84rem}output{color:var(--blue);font-variant-numeric:tabular-nums}input{width:100%;accent-color:var(--blue)}summary{cursor:pointer;color:var(--blue);font-weight:700}dl{margin:0}dl div{display:flex;justify-content:space-between;gap:.5rem;padding:.55rem 0;border-bottom:1px solid var(--line)}dt,dd{margin:0}dd{font-weight:700;font-variant-numeric:tabular-nums;text-align:right}.heatmap{margin-top:1rem}.heatmap>div{overflow-x:auto}table{width:100%;min-width:470px;border-collapse:collapse}th,td{padding:.55rem;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}th:first-child{text-align:left}td.above{background:#d9edf9;color:#0d4b7d;font-weight:700}footer{display:block;margin-top:1rem;font-size:.78rem}@media(max-width:700px){.bloom-lab header,.grid{grid-template-columns:1fr}.bloom-lab header b{justify-self:start}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.cards strong{font-size:1.12rem}.reverse{display:block}.reverse strong{display:block;margin-top:.65rem}}@media(max-width:390px){.bloom-lab{padding:.85rem}.cards>div,.controls,.bridge,.heatmap{padding:.75rem}.cards span,.cards small{font-size:.68rem}}
</style>
