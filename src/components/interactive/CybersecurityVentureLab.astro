---
interface Props { language?: 'ko' | 'en'; }
const { language = 'ko' } = Astro.props;
const en = language === 'en';
---
<section class="venture-lab" data-venture-lab data-language={language} aria-labelledby="venture-lab-title">
  <header class="intro">
    <div><p>THE ARCHIVE / PRIVATE MARKETS LAB</p><h3 id="venture-lab-title">{en ? 'From productization to venture returns' : '제품화가 VC 수익률로 이어지는 조건'}</h3><span>{en ? 'An illustrative common-equivalent model. It does not describe either company’s financing, ARR, margin, or cap table.' : '모든 값은 예시 가정입니다. 어느 회사의 투자 조건·ARR·마진·자본구조를 나타내지 않습니다.'}</span></div>
    <span class="assumption">{en ? 'Illustrative only' : '가정 기반'}</span>
  </header>

  <div class="tabs" role="tablist" aria-label={en ? 'Business archetype' : '사업 구조 선택'}>
    <button role="tab" aria-selected="true" data-archetype="gateway">{en ? 'Data-control gateway' : '데이터 통제 게이트웨이'}</button>
    <button role="tab" aria-selected="false" data-archetype="bas">{en ? 'BAS productization' : 'BAS 제품화'}</button>
  </div>
  <p class="archetype-note" data-archetype-note>{en ? 'The gateway case asks whether reusable integrations can replace one-off delivery work.' : '연동 재사용이 고객별 구축을 얼마나 대체하는지를 시험합니다.'}</p>

  <div class="preset" role="group" aria-label={en ? 'Scenario presets' : '시나리오 프리셋'}><span>{en ? 'Scenario' : '시나리오'}</span><button data-preset="bear">Bear</button><button class="active" data-preset="base">Base</button><button data-preset="bull">Bull</button></div>

  <div class="results" aria-live="polite">
    <div class="hero"><span>{en ? 'Maximum pre-money for target IRR' : '목표 IRR 기준 최대 투자 전 기업가치'}</span><strong data-out="maxPreMoney">—</strong><small data-out="feasibility"></small></div>
    <div><span>IRR / MOIC</span><strong data-out="irr">—</strong><small data-out="moic">—</small></div>
    <div><span>{en ? 'Terminal revenue' : '종료연도 매출'}</span><strong data-out="revenue">—</strong><small data-out="mix">—</small></div>
    <div><span>{en ? 'Blended gross margin' : '혼합 총이익률'}</span><strong data-out="gm">—</strong><small data-out="exitValue">—</small></div>
  </div>
  <section class="valuation-compare" aria-live="polite">
    <div><span>{en ? 'Revenue-based EV' : '매출배수 기준 EV'}</span><strong data-out="revenueEv">—</strong><small data-out="impliedEbitdaMultiple">—</small></div>
    <div><span>{en ? 'EBITDA-based EV' : 'EBITDA 배수 기준 EV'}</span><strong data-out="ebitdaEv">—</strong><small data-out="ebitdaStatus">—</small></div>
    <p>{en ? 'These are two exit lenses, not two values to add together. The revenue method remains the return calculation; the EBITDA method makes its embedded profitability expectation visible.' : '두 값은 합산하는 것이 아니라 서로 다른 Exit 관점이다. 투자자 수익률은 매출배수 기준으로 계산하고, EBITDA 기준은 그 가정에 담긴 수익성 기대를 보여 준다.'}</p>
  </section>

  <div class="controls">
    <section><h4>{en ? '01 / Investor terms' : '01 / 투자 조건'}</h4>
      <label><span>{en ? 'Entry pre-money' : '진입 시 투자 전 기업가치'} <output data-value="entryPreMoney"></output></span><input name="entryPreMoney" type="range" min="0" max="5000" step="100" value="1200" /></label>
      <label><span>{en ? 'Investment' : '투자금'} <output data-value="investment"></output></span><input name="investment" type="range" min="50" max="500" step="10" value="200" /></label>
      <label><span>{en ? 'Future dilution' : '후속 투자·스톡옵션 희석'} <output data-value="cumulativeDilution"></output></span><input name="cumulativeDilution" type="range" min="0" max="70" step="5" value="30" /></label>
      <label><span>{en ? 'Target IRR' : '목표 IRR'} <output data-value="targetIrr"></output></span><input name="targetIrr" type="range" min="15" max="60" step="5" value="30" /></label>
      <label><span>{en ? 'Exit revenue multiple' : 'Exit EV/Revenue'} <output data-value="exitRevenueMultiple"></output></span><input name="exitRevenueMultiple" type="range" min="1" max="15" step="1" value="6" /></label>
      <label><span>{en ? 'Exit EBITDA multiple' : 'Exit EV/EBITDA'} <output data-value="exitEbitdaMultiple"></output></span><input name="exitEbitdaMultiple" type="range" min="6" max="30" step="1" value="18" /></label>
    </section>
    <section><h4>{en ? '02 / Commercial engine' : '02 / 매출 구조'}</h4>
      <label><span>{en ? 'New customers (year 1)' : '신규 고객 (1년차)'} <output data-value="newCustomers"></output></span><input name="newCustomers" type="range" min="5" max="60" step="1" value="24" /></label>
      <label><span>{en ? 'Annual customer growth' : '연간 신규 고객 증가율'} <output data-value="annualCustomerGrowth"></output></span><input name="annualCustomerGrowth" type="range" min="0" max="70" step="5" value="35" /></label>
      <label><span>{en ? 'Renewal + expansion factor' : '갱신·확대율'} <output data-value="retentionAndExpansion"></output></span><input name="retentionAndExpansion" type="range" min="80" max="120" step="1" value="104" /></label>
      <label><span>{en ? 'Subscription/product mix' : '구독·제품 매출 비중'} <output data-value="productRevenueMix"></output></span><input name="productRevenueMix" type="range" min="0" max="100" step="5" value="70" /></label>
      <label><span>{en ? 'Reusable delivery cost per customer' : '고객당 반복 구축·지원비'} <output data-value="deliveryCostPerCustomer"></output></span><input name="deliveryCostPerCustomer" type="range" min="0" max="3" step=".1" value=".5" /></label>
      <label><span>{en ? 'Partner distribution cost' : '파트너 판매·지원 비용'} <output data-value="partnerCommissionRate"></output></span><input name="partnerCommissionRate" type="range" min="0" max="30" step="1" value="10" /></label>
    </section>
  </div>

  <section class="bridge"><h4>{en ? '03 / The moat-to-return bridge' : '03 / 해자가 수익률로 이어지는 경로'}</h4>
    <div><article><b>{en ? 'Reusable workflow' : '재사용 가능한 업무 흐름'}</b><span>{en ? 'Higher product mix / lower delivery burden' : '제품 매출 비중 증가 / 반복 구축·지원비 감소'}</span></article><i>→</i><article><b>{en ? 'Gross profit' : '총이익'}</b><span data-out="grossProfit">—</span></article><i>→</i><article><b>{en ? 'Exit equity value' : 'Exit 시점 지분가치'}</b><span data-out="equityValue">—</span></article><i>→</i><article><b>VC return</b><span data-out="proceeds">—</span></article></div>
    <p>{en ? 'The model deliberately does not turn a “moat score” into a valuation. It models a path through customer economics, margin, an assumed exit multiple, and ownership.' : '이 모델은 ‘해자 점수’를 곧바로 기업가치로 바꾸지 않습니다. 고객 경제성, 마진, 가정한 Exit 배수, 투자자 지분으로 이어지는 경로만 계산합니다.'}</p>
  </section>

  <section class="sensitivity"><h4>{en ? '04 / Sensitivity: product mix × exit multiple' : '04 / 민감도: 제품 매출 비중 × Exit 배수'}</h4><div class="table-wrap"><table><thead data-sensitivity-head></thead><tbody data-sensitivity-body></tbody></table></div></section>
  <section class="formula"><h4>{en ? 'Model limits and formula' : '모델의 한계와 계산식'}</h4><p>{en ? 'Revenue EV = exit revenue × EV/revenue. EBITDA EV = exit EBITDA × EV/EBITDA, only when EBITDA is positive. Exit proceeds = max(Exit EV − net debt, 0) × investment / post-money × (1 − dilution). The common-equivalent model excludes liquidation preferences, participation rights, option-pool timing, taxes, and transaction costs.' : '매출 기준 EV = 종료연도 매출 × EV/Revenue, EBITDA 기준 EV = 종료 EBITDA × EV/EBITDA이며 EBITDA가 양수일 때만 유효하다. Exit 회수금 = max(Exit EV − 순부채, 0) × 투자금 / Post-money × (1 − 희석). 보통주 등가 단순 모델이며 청산우선권·참여권·옵션풀 시점·세금·거래비용은 반영하지 않습니다.'}</p></section>
</section>

<script>
  import { calculateCybersecurityVenture, cybersecurityVentureScenarios } from '../../data/cybersecurity-venture-valuation';
  import { track } from '../../scripts/track';
  document.querySelectorAll<HTMLElement>('[data-venture-lab]').forEach((root) => {
    const en = root.dataset.language === 'en'; let archetype: 'gateway' | 'bas' = 'gateway'; let tracked = false;
    const get = (name: string) => root.querySelector<HTMLInputElement>(`[name="${name}"]`)!;
    const number = (name: string) => Number(get(name).value);
    const won = (n: number) => en ? `KRW ${(n / 10).toFixed(n % 10 ? 1 : 0)}bn` : `${Math.round(n).toLocaleString('ko-KR')}억`;
    const pct = (n: number) => `${(n * 100).toFixed(1)}%`;
    const text = (name: string, value: string) => { const node = root.querySelector<HTMLElement>(`[data-out="${name}"]`); if (node) node.textContent = value; };
    const assumption = () => ({ ...cybersecurityVentureScenarios[archetype].base, entryPreMoney:number('entryPreMoney'), investment:number('investment'), cumulativeDilution:number('cumulativeDilution')/100, targetIrr:number('targetIrr')/100, exitRevenueMultiple:number('exitRevenueMultiple'), exitEbitdaMultiple:number('exitEbitdaMultiple'), newCustomers:number('newCustomers'), annualCustomerGrowth:number('annualCustomerGrowth')/100, retentionAndExpansion:number('retentionAndExpansion')/100, productRevenueMix:number('productRevenueMix')/100, deliveryCostPerCustomer:number('deliveryCostPerCustomer'), partnerCommissionRate:number('partnerCommissionRate')/100 });
    const renderSensitivity = (base: ReturnType<typeof assumption>) => { const multiples = [3, 5, 7, 9]; const mixes = [.4, .6, .8]; const head = root.querySelector<HTMLTableRowElement>('[data-sensitivity-head]')!; head.replaceChildren(Object.assign(document.createElement('tr'), { innerHTML: `<th>${en ? 'Product mix' : '제품 비중'} \\ EV/Revenue</th>${multiples.map((m) => `<th>${m.toFixed(0)}×</th>`).join('')}` })); const body = root.querySelector<HTMLTableSectionElement>('[data-sensitivity-body]')!; body.replaceChildren(...mixes.map((mix) => { const row = document.createElement('tr'); row.innerHTML = `<th>${pct(mix)}</th>${multiples.map((multiple) => { const r = calculateCybersecurityVenture({ ...base, productRevenueMix: mix, exitRevenueMultiple: multiple }); return `<td class="${r.irr !== null && r.irr >= r.targetIrr ? 'pass' : 'fail'}">${r.irr === null ? '—' : pct(r.irr)}</td>`; }).join('')}`; return row; })); };
    const render = () => { const base = assumption(); const r = calculateCybersecurityVenture(base); const labels: Record<string, string> = { entryPreMoney:won(base.entryPreMoney), investment:won(base.investment), cumulativeDilution:pct(base.cumulativeDilution), targetIrr:pct(base.targetIrr), exitRevenueMultiple:`${base.exitRevenueMultiple.toFixed(1)}×`, exitEbitdaMultiple:`${base.exitEbitdaMultiple.toFixed(1)}×`, newCustomers:String(base.newCustomers), annualCustomerGrowth:pct(base.annualCustomerGrowth), retentionAndExpansion:`${(base.retentionAndExpansion * 100).toFixed(0)}%`, productRevenueMix:pct(base.productRevenueMix), deliveryCostPerCustomer:won(base.deliveryCostPerCustomer), partnerCommissionRate:pct(base.partnerCommissionRate) }; root.querySelectorAll<HTMLInputElement>('input').forEach((node) => { const out = root.querySelector<HTMLOutputElement>(`[data-value="${node.name}"]`); if (out) out.value = labels[node.name]; }); text('maxPreMoney', r.targetIsFeasible ? won(r.maximumPreMoney) : (en ? 'Not feasible' : '충족 불가')); text('feasibility', r.targetIsFeasible ? (en ? `at ${pct(r.targetIrr)} target IRR` : `목표 IRR ${pct(r.targetIrr)} 기준`) : (en ? 'Terminal equity value cannot support the target return.' : '설정한 종료 지분가치로 목표수익률을 충족할 수 없습니다.')); text('irr', r.irr === null ? '—' : pct(r.irr)); text('moic', r.moic === null ? (en ? 'No positive proceeds' : '양(+) 회수금 없음') : `${r.moic.toFixed(1)}× MOIC`); text('revenue', won(r.terminalRevenue)); text('mix', `${en ? 'Exit cohorts' : '종료연도 고객 코호트'} ${r.terminalCustomers.toFixed(0)} · ${en ? 'Product' : '제품'} ${won(r.subscriptionRevenue)} · ${en ? 'Services' : '서비스'} ${won(r.servicesRevenue)}`); text('gm', pct(r.blendedGrossMargin)); text('exitValue', `Exit EV ${won(r.exitEnterpriseValue)}`); text('revenueEv', won(r.exitEnterpriseValue)); text('impliedEbitdaMultiple', r.impliedExitEbitdaMultiple === null ? (en ? 'EBITDA is not positive' : 'EBITDA가 양수가 아님') : (en ? `implied ${r.impliedExitEbitdaMultiple.toFixed(1)}× EBITDA` : `내재 EV/EBITDA ${r.impliedExitEbitdaMultiple.toFixed(1)}×`)); text('ebitdaEv', r.exitEnterpriseValueFromEbitda === null ? '—' : won(r.exitEnterpriseValueFromEbitda)); text('ebitdaStatus', r.exitEnterpriseValueFromEbitda === null ? (en ? 'Not meaningful while EBITDA is negative' : 'EBITDA가 음수이면 의미 있는 배수 비교가 어렵습니다') : `${r.exitEbitdaMultiple.toFixed(1)}× EBITDA`); text('grossProfit', won(r.grossProfit)); text('equityValue', won(r.exitEquityValue)); text('proceeds', won(r.exitProceeds)); renderSensitivity(base); };
    const setPreset = (name: 'bear'|'base'|'bull') => { const s = cybersecurityVentureScenarios[archetype][name]; Object.entries(s).forEach(([key, value]) => { const node = root.querySelector<HTMLInputElement>(`[name="${key}"]`); if (!node || typeof value !== 'number') return; node.value = String(['cumulativeDilution','targetIrr','annualCustomerGrowth','productRevenueMix'].includes(key) ? value * 100 : key === 'retentionAndExpansion' ? value * 100 : value); }); root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.classList.toggle('active', b.dataset.preset === name)); render(); };
    root.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.addEventListener('input', () => { root.querySelectorAll('[data-preset]').forEach((b) => b.classList.remove('active')); render(); if (!tracked) { track('code_run', { articleSlug:'cybersecurity-venture-productization-lab', language:en?'en':'ko', component:'cybersecurity-venture-lab-v1' }); tracked = true; } }));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => button.addEventListener('click', () => setPreset(button.dataset.preset as 'bear'|'base'|'bull')));
    root.querySelectorAll<HTMLButtonElement>('[data-archetype]').forEach((button) => button.addEventListener('click', () => { archetype = button.dataset.archetype as typeof archetype; root.querySelectorAll('[data-archetype]').forEach((b) => b.setAttribute('aria-selected', String(b === button))); const note = root.querySelector('[data-archetype-note]')!; note.textContent = archetype === 'gateway' ? (en ? 'The gateway case asks whether reusable integrations can replace one-off delivery work.' : '연동 재사용이 고객별 구축을 얼마나 대체하는지를 시험합니다.') : (en ? 'The BAS case asks whether research and delivery become a repeatable product.' : '공격 연구와 컨설팅이 반복 가능한 제품 매출로 전환되는지를 시험합니다.'); setPreset('base'); }));
    setPreset('base');
  });
</script>

<style>
 .venture-lab{--ink:#173047;--accent:#2f6a78;--line:#ccd9e1;--soft:#f3f8fa;--muted:#60707a;margin:2rem 0;border:1px solid var(--line);border-radius:20px;padding:clamp(1rem,3vw,2rem);background:#fbfdfe;color:var(--ink);font-family:var(--sans)}.intro{display:flex;justify-content:space-between;gap:1rem}.intro p{margin:0;color:#49708a;font:700 .68rem/1.3 ui-monospace,monospace;letter-spacing:.1em}.intro h3{margin:.25rem 0 .55rem;font:700 clamp(1.5rem,3vw,2.15rem)/1.15 var(--serif)}.intro span:not(.assumption){display:block;max-width:760px;color:var(--muted);font-size:.88rem;line-height:1.55}.assumption{height:max-content;white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:#edf5f7;padding:.35rem .6rem;color:#285c6d;font-size:.72rem;font-weight:800}.tabs,.preset{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.3rem}.tabs button,.preset button{min-height:38px;border:1px solid var(--line);border-radius:8px;background:#fff;padding:.45rem .7rem;color:var(--ink);font:700 .76rem var(--sans);cursor:pointer}.tabs button[aria-selected=true],.preset button.active{background:var(--ink);border-color:var(--ink);color:#fff}.archetype-note{margin:.65rem 0 0;color:var(--muted);font-size:.82rem}.preset{align-items:center}.preset span{color:var(--muted);font-size:.74rem;font-weight:800}.results{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-top:1.3rem}.results>div{display:flex;min-height:106px;flex-direction:column;justify-content:center;border:1px solid var(--line);border-radius:12px;background:#fff;padding:.8rem}.results .hero{background:var(--ink);color:#fff}.results span{color:var(--muted);font-size:.7rem;font-weight:800}.results .hero span,.results .hero small{color:#c3d7de}.results strong{margin:.2rem 0;font:700 clamp(1.25rem,2.7vw,1.8rem)/1.15 var(--serif);font-variant-numeric:tabular-nums}.results small{color:var(--muted);font-size:.66rem;line-height:1.35}.controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}.controls section,.bridge,.sensitivity,.formula{border-top:1px solid var(--line);padding-top:1rem}.venture-lab h4{margin:0 0 .7rem;font-size:.98rem}.controls label{display:block;margin:.55rem 0;border:1px solid var(--line);border-radius:9px;background:#fff;padding:.65rem}.controls label span{display:flex;justify-content:space-between;gap:.6rem;color:var(--muted);font-size:.72rem;font-weight:750}.controls output{color:var(--ink);font-variant-numeric:tabular-nums}.controls input{width:100%;margin-top:.45rem;accent-color:var(--accent)}.bridge,.sensitivity,.formula{margin-top:1.5rem}.bridge>div{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));align-items:stretch}.bridge article{display:flex;min-height:82px;flex-direction:column;justify-content:center;border:1px solid var(--line);border-radius:10px;background:#fff;padding:.65rem}.bridge b{font-size:.75rem}.bridge article span{margin-top:.35rem;color:var(--muted);font-size:.68rem;line-height:1.35}.bridge i{display:grid;place-items:center;color:#6f93a0;font-style:normal}.bridge>p,.formula p{margin:.75rem 0 0;color:var(--muted);font-size:.73rem;line-height:1.6}.table-wrap{overflow-x:auto}.sensitivity table{width:100%;min-width:500px;border-collapse:collapse;background:#fff}.sensitivity th,.sensitivity td{padding:.65rem;border-bottom:1px solid var(--line);text-align:right;font-size:.78rem;font-variant-numeric:tabular-nums}.sensitivity th:first-child{text-align:left}.pass{color:#237256;font-weight:800}.fail{color:#aa514b;font-weight:800}@media(max-width:760px){.results{grid-template-columns:repeat(2,minmax(0,1fr))}.controls{grid-template-columns:1fr}.bridge>div{grid-template-columns:1fr}.bridge i{height:22px;transform:rotate(90deg)}.intro{display:block}.assumption{display:inline-block;margin-top:.7rem}}@media(max-width:480px){.results{grid-template-columns:1fr}.venture-lab{border-radius:15px}.results>div{min-height:88px}.tabs button{flex:1}.preset span{width:100%}}
.valuation-compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:1.5rem;border-top:1px solid var(--line);padding-top:1rem}.valuation-compare>div{border:1px solid var(--line);border-radius:12px;background:#fff;padding:.8rem}.valuation-compare span,.valuation-compare small{display:block;color:var(--muted);font-size:.7rem;font-weight:800}.valuation-compare strong{display:block;margin:.25rem 0;font:700 1.35rem/1.15 var(--serif);font-variant-numeric:tabular-nums}.valuation-compare p{grid-column:1/-1;margin:0;color:var(--muted);font-size:.73rem;line-height:1.55}@media(max-width:760px){.valuation-compare{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.valuation-compare{grid-template-columns:1fr}}
</style>
