---
interface Props { language?: 'ko' | 'en'; }
const { language = 'ko' } = Astro.props;
const en = language === 'en';
---
<section class="pe-lab" data-pe-lab data-language={language} aria-labelledby="pe-lab-title">
  <header><div><p>THE ARCHIVE / ENTERPRISE AX LAB</p><h3 id="pe-lab-title">Private Equity AX Value Creation Lab</h3><span>{en ? 'Separate the paths from AX to EBITDA, debt paydown, and equity returns.' : 'AX가 EBITDA·부채상환·지분수익률로 이어지는 경로를 분리해서 봅니다.'}</span></div><b>{en ? 'Assumption-based · educational' : '가정 기반 · 교육용'}</b></header>
  <div class="presets"><span>Scenario</span><button data-preset="bear">Bear</button><button data-preset="base" class="active" aria-pressed="true">Base</button><button data-preset="bull">Bull</button></div>
  <div class="headline" aria-live="polite"><div><span>AX Equity MOIC</span><strong data-out="moic">2.0×</strong></div><div><span>AX Equity IRR</span><strong data-out="irr">15.0%</strong></div><div><span>{en ? 'Incremental AX equity value' : 'AX가 만든 추가 지분가치'}</span><strong data-out="incremental">0억</strong></div><div><span>{en ? 'Versus No-AX' : 'No-AX 대비'}</span><strong data-out="deltaMoic">+0.0×</strong></div></div>
  <div class="lab-grid"><section><h4>01 / Entry & operating assumptions</h4><label>Entry EBITDA <output data-value="entryEbitda"></output><input name="entryEbitda" type="range" min="50" max="300" step="10" value="100"></label><label>Entry EV / EBITDA <output data-value="entryMultiple"></output><input name="entryMultiple" type="range" min="5" max="12" step=".5" value="8"></label><label>Entry net debt <output data-value="entryDebt"></output><input name="entryDebt" type="range" min="0" max="600" step="25" value="350"></label><label>Holding period <output data-value="years"></output><input name="years" type="range" min="3" max="7" step="1" value="5"></label><label>Organic EBITDA growth <output data-value="growth"></output><input name="growth" type="range" min="0" max="15" step=".5" value="5"></label></section><section><h4>02 / AX assumptions</h4><label>AX EBITDA improvement <output data-value="axImprove"></output><input name="axImprove" type="range" min="0" max="40" step="1" value="20"></label><label>AX ramp-up period <output data-value="ramp"></output><input name="ramp" type="range" min="0" max="3" step="1" value="2"></label><label>One-time implementation cost <output data-value="implementation"></output><input name="implementation" type="range" min="0" max="100" step="5" value="30"></label><label>Recurring AI operating cost / year <output data-value="aiCost"></output><input name="aiCost" type="range" min="0" max="30" step="1" value="8"></label><label>Annual FCF available for debt paydown <output data-value="fcf"></output><input name="fcf" type="range" min="0" max="100" step="5" value="45"></label><label>Exit EV / EBITDA <output data-value="exitMultiple"></output><input name="exitMultiple" type="range" min="5" max="12" step=".5" value="8"></label></section></div>
  <section class="results"><h4>03 / Value-creation bridge</h4><div class="bridge"><div><span>Entry EV</span><b data-out="entryEv"></b></div><div><span>Entry equity</span><b data-out="entryEquity"></b></div><div><span>Exit EBITDA</span><b data-out="exitEbitda"></b></div><div><span>Exit EV</span><b data-out="exitEv"></b></div><div><span>Exit net debt</span><b data-out="exitDebt"></b></div><div><span>Exit equity</span><b data-out="exitEquity"></b></div></div><div class="bars"><div><span>Organic growth</span><i data-bar="organic"></i><b data-out="organicValue"></b></div><div><span>AX EBITDA less AI costs</span><i data-bar="ax"></i><b data-out="axValue"></b></div><div><span>Debt paydown</span><i data-bar="debt"></i><b data-out="debtValue"></b></div><div><span>Multiple movement</span><i data-bar="multiple"></i><b data-out="multipleValue"></b></div></div></section>
  <section class="comparison"><h4>04 / AX versus counterfactual</h4><div class="table-scroll"><table><thead><tr><th></th><th>Exit EBITDA</th><th>Exit equity value</th><th>MOIC</th><th>IRR</th></tr></thead><tbody data-comparison></tbody></table></div><p>{en ? 'The model simplifies tax, working capital, interim distributions, and transaction fees. FCF repays net debt each year; the one-time AX cost is included once in entry equity. AI cost and EBITDA improvement are not double counted.' : '모델은 세금·운전자본·중간 분배·거래 수수료를 단순화합니다. FCF는 매년 순차입금 상환에 사용되며, AX 일회성 비용은 진입 지분 투자에 한 번만 포함됩니다. AI 비용과 EBITDA 개선은 중복 계상하지 않습니다.'}</p></section>
</section>
<script>
  import { track } from '../../scripts/track';
  document.querySelectorAll<HTMLElement>('[data-pe-lab]').forEach((root) => {
    const n=(x:string)=>Number(root.querySelector<HTMLInputElement>(`[name="${x}"]`)!.value); const en=root.dataset.language==='en'; const won=(x:number)=>en?`KRW ${(x/10).toFixed(x%10===0?0:1)}bn`:`${Math.round(x).toLocaleString('ko-KR')}억`; const years=(x:number)=>en?`${x} yr`:`${x}년`; const pct=(x:number)=>`${(x*100).toFixed(1)}%`; const write=(k:string,v:string)=>{const el=root.querySelector<HTMLElement>(`[data-out="${k}"]`);if(el)el.textContent=v};
    const assumptions=()=>({entryEbitda:n('entryEbitda'),entryMultiple:n('entryMultiple'),entryDebt:n('entryDebt'),years:n('years'),growth:n('growth')/100,axImprove:n('axImprove')/100,ramp:n('ramp'),implementation:n('implementation'),aiCost:n('aiCost'),fcf:n('fcf'),exitMultiple:n('exitMultiple')});
    const calc=(a:any,ax=true)=>{const entryEv=a.entryEbitda*a.entryMultiple, entryEquity=entryEv-a.entryDebt+(ax?a.implementation:0);let e=a.entryEbitda, debt=a.entryDebt;for(let y=1;y<=a.years;y++){const ramp=ax?Math.min(1,y/Math.max(1,a.ramp)):0;e=e*(1+a.growth)*(1+a.axImprove*ramp);debt=Math.max(0,debt-(a.fcf-(ax?a.aiCost:0)))}const exitEv=e*a.exitMultiple, equity=exitEv-debt, moic=equity/entryEquity, irr=Math.pow(Math.max(0.001,moic),1/a.years)-1;return{entryEv,entryEquity,exitEbitda:e,exitEv,exitDebt:debt,exitEquity:equity,moic,irr}};
    const values:any={entryEbitda:(x:number)=>won(x),entryMultiple:(x:number)=>`${x.toFixed(1)}×`,entryDebt:(x:number)=>won(x),years,growth:(x:number)=>pct(x/100),axImprove:(x:number)=>pct(x/100),ramp:years,implementation:(x:number)=>won(x),aiCost:(x:number)=>won(x),fcf:(x:number)=>won(x),exitMultiple:(x:number)=>`${x.toFixed(1)}×`};
    const render=()=>{const a=assumptions(), withAx=calc(a,true), without=calc(a,false), delta=withAx.exitEquity-without.exitEquity;root.querySelectorAll<HTMLInputElement>('input').forEach(i=>{const out=root.querySelector<HTMLOutputElement>(`[data-value="${i.name}"]`);if(out)out.value=values[i.name](Number(i.value))});for(const [k,v] of Object.entries({entryEv:won(withAx.entryEv),entryEquity:won(withAx.entryEquity),exitEbitda:won(withAx.exitEbitda),exitEv:won(withAx.exitEv),exitDebt:won(withAx.exitDebt),exitEquity:won(withAx.exitEquity)}))write(k,v as string);write('moic',`${withAx.moic.toFixed(2)}×`);write('irr',pct(withAx.irr));write('incremental',`${delta>=0?'+':''}${won(delta)}`);write('deltaMoic',`${withAx.moic-without.moic>=0?'+':''}${(withAx.moic-without.moic).toFixed(2)}×`);const bridge:any={organicValue:(a.entryEbitda*Math.pow(1+a.growth,a.years)-a.entryEbitda)*a.exitMultiple,axValue:(withAx.exitEbitda-a.entryEbitda*Math.pow(1+a.growth,a.years))*a.exitMultiple, debtValue:a.entryDebt-withAx.exitDebt,multipleValue:withAx.exitEbitda*(a.exitMultiple-a.entryMultiple)};const max=Math.max(1,...Object.values(bridge).map((v:any)=>Math.abs(v)));Object.entries(bridge).forEach(([k,v]:any)=>{write(`${k}Value`,`${v>=0?'+':''}${won(v)}`);const bar=root.querySelector<HTMLElement>(`[data-bar="${k.replace('Value','')}"]`);if(bar)bar.style.width=`${Math.max(2,Math.abs(v)/max*100)}%`});const tb=root.querySelector<HTMLTableSectionElement>('[data-comparison]')!;tb.innerHTML=`<tr><th>AX</th><td>${won(withAx.exitEbitda)}</td><td>${won(withAx.exitEquity)}</td><td>${withAx.moic.toFixed(2)}×</td><td>${pct(withAx.irr)}</td></tr><tr><th>No-AX</th><td>${won(without.exitEbitda)}</td><td>${won(without.exitEquity)}</td><td>${without.moic.toFixed(2)}×</td><td>${pct(without.irr)}</td></tr>`};
    const presets:any={bear:{growth:2,axImprove:8,implementation:50,aiCost:14,ramp:3,exitMultiple:6},base:{growth:5,axImprove:20,implementation:30,aiCost:8,ramp:2,exitMultiple:8},bull:{growth:8,axImprove:32,implementation:25,aiCost:6,ramp:1,exitMultiple:9}};let tracked=false;root.querySelectorAll<HTMLInputElement>('input').forEach(i=>i.addEventListener('input',()=>{root.querySelectorAll('button').forEach(b=>b.classList.remove('active'));render();if(!tracked){track('code_run',{articleSlug:'the-future-of-ax-domain-experts-software-owners',language:en?'en':'ko',component:'pe-ax-value-creation-lab-v1'});tracked=true}}));root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b=>b.addEventListener('click',()=>{Object.entries(presets[b.dataset.preset!]).forEach(([k,v])=>root.querySelector<HTMLInputElement>(`[name="${k}"]`)!.value=String(v));root.querySelectorAll('button').forEach(x=>x.classList.toggle('active',x===b));render()}));render();
  });
</script>
<style>
  .pe-lab{--ink:#26353a;--accent:#9b5739;--line:#d9d6cf;--soft:#f6f4ef;margin:2.5rem 0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:20px;background:#fbfaf7;color:var(--ink)}.pe-lab header{display:flex;justify-content:space-between;gap:1rem}.pe-lab header p{margin:0;color:var(--accent);font:800 .67rem ui-monospace,monospace;letter-spacing:.1em}.pe-lab h3{margin:.25rem 0;font:700 clamp(1.35rem,3vw,2rem)/1.2 var(--serif)}.pe-lab header span,.comparison p{color:#68706d;font-size:.8rem}.pe-lab header>b{height:max-content;padding:.35rem .55rem;border-radius:999px;background:#f1e6df;color:#78452e;font-size:.7rem;white-space:nowrap}.presets{display:flex;gap:.4rem;align-items:center;margin:1.2rem 0}.presets span{font-size:.75rem;font-weight:700}.presets button{border:1px solid var(--line);border-radius:7px;background:#fff;padding:.4rem .7rem;font-weight:700;cursor:pointer}.presets button.active{border-color:var(--ink);background:var(--ink);color:#fff}.headline{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem}.headline div{padding:.8rem;border:1px solid var(--line);border-radius:10px;background:#fff}.headline span,.bridge span{display:block;color:#6d7470;font-size:.7rem}.headline strong{display:block;margin-top:.25rem;font:700 clamp(1.25rem,2.5vw,1.8rem) var(--serif);font-variant-numeric:tabular-nums}.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.5rem}.lab-grid section,.results,.comparison{border-top:1px solid var(--line);padding-top:1rem}.pe-lab h4{margin:0 0 .7rem;font-size:.95rem}.pe-lab label{display:block;margin:.45rem 0;padding:.6rem;border:1px solid var(--line);border-radius:8px;background:#fff;color:#626964;font-size:.75rem;font-weight:700}.pe-lab output{float:right;color:var(--ink);font-variant-numeric:tabular-nums}.pe-lab input{display:block;width:100%;margin-top:.45rem;accent-color:var(--accent)}.results,.comparison{margin-top:1.5rem}.bridge{display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line)}.bridge div{padding:.65rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.bridge b{display:block;margin-top:.25rem;font:700 1.05rem var(--serif);font-variant-numeric:tabular-nums}.bars{margin-top:1rem}.bars div{display:grid;grid-template-columns:150px 1fr 90px;gap:.5rem;align-items:center;margin:.45rem 0;font-size:.73rem}.bars i{height:10px;border-radius:99px;background:var(--accent)}.bars b{text-align:right;font-variant-numeric:tabular-nums}.table-scroll{overflow-x:auto}.comparison table{width:100%;min-width:500px;border-collapse:collapse;background:#fff;font-size:.8rem}.comparison th,.comparison td{padding:.6rem;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}.comparison th:first-child{text-align:left}@media(max-width:680px){.pe-lab header{display:block}.pe-lab header>b{display:inline-block;margin-top:.7rem}.headline{grid-template-columns:repeat(2,1fr)}.lab-grid{grid-template-columns:1fr}.bridge{grid-template-columns:1fr 1fr}.bars div{grid-template-columns:120px 1fr 70px}}@media(max-width:420px){.headline,.bridge{grid-template-columns:1fr}.bars div{grid-template-columns:1fr}.bars b{text-align:left}}
</style>
