---
interface Props {
  kind: 'overview' | 'deployment' | 'lifecycle';
  language?: 'ko' | 'en';
}

const { kind, language = 'ko' } = Astro.props;
const ko = language === 'ko';

const captions = {
  overview: ko
    ? '그림 1. Agent backend — 명령 흐름(실선)과 관측 흐름(점선)'
    : 'Figure 1. Agent backend — command flow (solid) and observation flow (dashed)',
  deployment: ko
    ? '그림 2. 개발(단일 process/Pod 가능)과 운영(API·Worker Deployment 분리)'
    : 'Figure 2. Dev (single process/Pod) vs prod (separate API and Worker Deployments)',
  lifecycle: ko
    ? '그림 3. 하나의 run이 시스템을 통과하는 순서'
    : 'Figure 3. One run through the system',
};

const overviewLegend = ko
  ? [
      ['실선 화살표', '명령: 사용자 → API → Queue → Worker'],
      ['점선 화살표', '관측: Worker → 저장소 → SSE → 사용자'],
    ]
  : [
      ['Solid arrow', 'Command: user → API → Queue → Worker'],
      ['Dashed arrow', 'Observation: Worker → stores → SSE → user'],
    ];

const lifecycleSteps = ko
  ? [
      ['1', 'Browser → API', 'POST /runs', '인증·권한·입력 검증', 'command'],
      ['2', 'API → PostgreSQL', 'submitting', 'run_id와 복구 가능한 실행 의도 기록', 'durable'],
      ['3', 'API → Queue', 'queued', '실행 의도를 API process 밖에 보관', 'command'],
      ['4', 'API → Browser', '202 + run_id', '완료가 아니라 안전한 접수 결과', 'observe'],
      ['5', 'Queue → Worker', 'claim → running', 'attempt_id·lease로 이번 시도 시작', 'command'],
      ['6', 'Worker → Stores', 'checkpoint · progress · event', 'PostgreSQL은 내구성, Redis는 짧은 관측 데이터', 'durable'],
      ['7', 'Worker → PostgreSQL', 'completed / failed', '최종 결과 commit 뒤 queue ack', 'durable'],
      ['8', 'API · SSE → Browser', 'snapshot + cursor', '조회·재연결·중복 event 무시', 'observe'],
    ]
  : [
      ['1', 'Browser → API', 'POST /runs', 'Authenticate, authorize, and validate input', 'command'],
      ['2', 'API → PostgreSQL', 'submitting', 'Persist run_id and recoverable execution intent', 'durable'],
      ['3', 'API → Queue', 'queued', 'Execution intent lives outside the API process', 'command'],
      ['4', 'API → Browser', '202 + run_id', 'Safe acceptance, not completion', 'observe'],
      ['5', 'Queue → Worker', 'claim → running', 'Start this attempt with attempt_id and lease', 'command'],
      ['6', 'Worker → Stores', 'checkpoint · progress · event', 'PostgreSQL is durable; Redis is short-lived observation data', 'durable'],
      ['7', 'Worker → PostgreSQL', 'completed / failed', 'Commit terminal result before queue ack', 'durable'],
      ['8', 'API · SSE → Browser', 'snapshot + cursor', 'Read, reconnect, and ignore duplicate events', 'observe'],
    ];
---

<figure class="agent-backend-map" aria-labelledby={`agent-backend-${kind}-${language}`}>
  <figcaption id={`agent-backend-${kind}-${language}`}>{captions[kind]}</figcaption>

  {kind === 'overview' && (
    <>
      <ul class="legend" aria-label={ko ? '화살표 범례' : 'Arrow legend'}>
        {overviewLegend.map(([label, detail]) => (
          <li>
            <span class="swatch" data-flow={label.includes('점') || label.includes('Dashed') ? 'observe' : 'command'} />
            <span><strong>{label}</strong> — {detail}</span>
          </li>
        ))}
      </ul>
      <div class="stack overview">
        <div class="node browser">
          <strong>Browser</strong>
          <span>{ko ? 'POST로 명령 · GET/SSE로 관측' : 'Command with POST · observe with GET/SSE'}</span>
        </div>
        <div class="arrow command" aria-hidden="true" />
        <div class="node api">
          <div class="node-heading">
            <strong>{ko ? 'API Deployment' : 'API Deployment'}</strong>
            <span class="lifetime">{ko ? '짧은 요청 수명' : 'Short request lifetime'}</span>
          </div>
          <ul>
            <li><b>POST</b> {ko ? '인증·권한·입력 검증, run 생성' : 'auth, validation, create run'}</li>
            <li><b>GET</b> {ko ? 'PostgreSQL snapshot 조회' : 'read PostgreSQL snapshot'}</li>
            <li><b>SSE</b> {ko ? 'cursor 이후 event 전달' : 'relay events after cursor'}</li>
          </ul>
        </div>
        <div class="arrow command" aria-hidden="true" />
        <div class="node queue">
          <strong>{ko ? 'Queue · 실행 요청' : 'Queue · execution request'}</strong>
          <span>{ko ? 'claim · lease · retry · redelivery' : 'claim · lease · retry · redelivery'}</span>
        </div>
        <div class="arrow command" aria-hidden="true" />
        <div class="node worker">
          <div class="node-heading">
            <strong>{ko ? 'Worker Deployment' : 'Worker Deployment'}</strong>
            <span class="lifetime">{ko ? 'run attempt 수명' : 'Run-attempt lifetime'}</span>
          </div>
          <ul>
            <li>{ko ? 'attempt_id · lease로 이번 실행 시도 소유' : 'Own this attempt with attempt_id and lease'}</li>
            <li>{ko ? 'Agent graph · LLM · Tool 실행' : 'Run agent graph, LLM calls, and tools'}</li>
            <li>{ko ? 'checkpoint·결과 저장 후 ack' : 'Persist checkpoint/result before ack'}</li>
          </ul>
        </div>
        <div class="storage-grid" aria-label={ko ? 'Worker가 사용하는 저장소와 외부 시스템' : 'Stores and external systems used by workers'}>
          <div class="store durable">
            <strong>PostgreSQL</strong>
            <span>{ko ? 'run · JSONB snapshot · checkpoint · result · audit' : 'run · JSONB snapshot · checkpoint · result · audit'}</span>
            <small>{ko ? '재시작 뒤에도 남는 기준 정보' : 'System of record across restarts'}</small>
          </div>
          <div class="store ephemeral">
            <strong>Redis</strong>
            <span>{ko ? 'progress · cancel · lock · cursor · 제한된 Stream' : 'progress · cancel · lock · cursor · bounded Stream'}</span>
            <small>{ko ? '작고 만료 가능한 실행 중 데이터' : 'Small, expiring coordination data'}</small>
          </div>
          <div class="store external">
            <strong>{ko ? 'LLM · Tool · 업무 DB' : 'LLM · tools · business DBs'}</strong>
            <span>{ko ? '네트워크 I/O · 부수 효과' : 'Network I/O · side effects'}</span>
            <small>{ko ? 'timeout·재시도·멱등성 필요' : 'Timeout, retry, idempotency required'}</small>
          </div>
        </div>
        <div class="observe-band">
          <span class="observe-label">{ko ? '관측 흐름 · 실행을 소유하지 않음' : 'Observation path · does not own execution'}</span>
          <div class="observe-path">
            <span>{ko ? 'Worker' : 'Worker'}</span>
            <span class="arrow observe inline" aria-hidden="true" />
            <span>{ko ? 'snapshot · event' : 'snapshot · events'}</span>
            <span class="arrow observe inline" aria-hidden="true" />
            <span>{ko ? 'GET · SSE API' : 'GET · SSE API'}</span>
            <span class="arrow observe inline" aria-hidden="true" />
            <span>{ko ? 'Browser' : 'Browser'}</span>
          </div>
          <p>{ko ? '연결이 끊겨도 run은 계속되고, 재연결은 snapshot + last event cursor로 복구한다.' : 'A disconnect does not stop the run; reconnect recovers from snapshot + last event cursor.'}</p>
        </div>
      </div>
    </>
  )}

  {kind === 'deployment' && (
    <div class="deploy-grid">
      <section class="deploy-panel" data-env="dev">
        <h3>{ko ? '개발' : 'Development'}</h3>
        <p>{ko ? 'API와 worker를 한 process 또는 한 Pod에서 실행할 수 있음' : 'API and worker may share one process or one Pod'}</p>
        <div class="pod single">
          <span>{ko ? 'Process / Pod' : 'Process / Pod'}</span>
          <span class="role">{ko ? 'HTTP handler + queue consumer + Agent run' : 'HTTP handler + queue consumer + agent runs'}</span>
        </div>
        <ul class="deploy-facts">
          <li>{ko ? '코드 책임은 분리' : 'Responsibilities stay separate in code'}</li>
          <li>{ko ? '배포·장애 수명은 공유' : 'Deployment and failure lifetime are shared'}</li>
        </ul>
      </section>
      <section class="deploy-panel" data-env="prod">
        <h3>{ko ? '운영' : 'Production'}</h3>
        <p>
          {ko
            ? '별도 Deployment · Pod 집합 — 확장·배포·장애 수명이 분리됨'
            : 'Separate Deployments and Pod sets — scale, deploy, and fail independently'}
        </p>
        <div class="deploy-col">
          <strong>{ko ? 'API Deployment' : 'API Deployment'}</strong>
          <div class="pod">API Pod 1</div>
          <div class="pod">API Pod 2</div>
          <div class="pod">API Pod 3</div>
          <span class="scale-note">{ko ? 'HTTP 요청량 기준 확장' : 'Scale on HTTP load'}</span>
        </div>
        <div class="deploy-col">
          <strong>{ko ? 'Worker Deployment' : 'Worker Deployment'}</strong>
          <div class="pod">Worker Pod 1</div>
          <div class="pod">Worker Pod 2</div>
          <span class="scale-note">
            {ko ? 'Queue 길이 · CPU/GPU · 외부 API 부하' : 'Queue depth, CPU/GPU, external API load'}
          </span>
        </div>
        <div class="shared-plane">
          <strong>{ko ? '공유 실행 평면' : 'Shared execution plane'}</strong>
          <span>{ko ? 'Queue · PostgreSQL · Redis' : 'Queue · PostgreSQL · Redis'}</span>
          <small>{ko ? 'API Pod 교체 뒤에도 run을 다시 발견하게 함' : 'Keeps runs discoverable after API Pod replacement'}</small>
        </div>
      </section>
    </div>
  )}

  {kind === 'lifecycle' && (
    <ol class="lifecycle">
      {lifecycleSteps.map(([number, owner, state, detail, flow]) => (
        <li data-flow={flow}>
          <span class="step-number">{number}</span>
          <span class="step-owner">{owner}</span>
          <strong>{state}</strong>
          <small>{detail}</small>
        </li>
      ))}
    </ol>
  )}
</figure>

<style>
  .agent-backend-map {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--paper-deep);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .agent-backend-map figcaption {
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .legend {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .legend li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .swatch {
    flex-shrink: 0;
    width: 2rem;
    height: 0.35rem;
    margin-top: 0.45rem;
    border-radius: 1px;
  }
  .swatch[data-flow='command'] {
    background: var(--accent);
  }
  .swatch[data-flow='observe'] {
    background: repeating-linear-gradient(
      90deg,
      var(--muted),
      var(--muted) 4px,
      transparent 4px,
      transparent 7px
    );
  }
  .stack.overview {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
  }
  .node {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    background: var(--paper);
    text-align: left;
  }
  .node-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }
  .lifetime {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .node ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--muted);
    text-align: left;
  }
  .node ul li + li {
    margin-top: 0.25rem;
  }
  .node.browser,
  .node.queue {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    text-align: left;
  }
  .node.browser span,
  .node.queue span {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .storage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 0.65rem;
  }
  .store {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .store.durable {
    border-top: 3px solid var(--accent);
  }
  .store.ephemeral {
    border-top: 3px dashed var(--accent);
  }
  .store.external {
    border-top: 3px double var(--muted);
  }
  .store span {
    font-size: 0.78rem;
  }
  .store small {
    color: var(--muted);
    font-size: 0.72rem;
  }
  .arrow.command {
    align-self: center;
    width: 2px;
    height: 1.25rem;
    background: var(--accent);
    position: relative;
  }
  .arrow.command::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--accent);
  }
  .observe-band {
    margin-top: 1rem;
    padding: 0.75rem;
    border: 1px dashed var(--muted);
    background: var(--paper);
  }
  .observe-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .observe-path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.82rem;
  }
  .observe-band p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    text-align: center;
  }
  .arrow.observe.inline {
    width: 1.5rem;
    height: 0;
    border-top: 2px dashed var(--muted);
    position: relative;
  }
  .arrow.observe.inline::after {
    content: '';
    position: absolute;
    right: -1px;
    top: -4px;
    border: 4px solid transparent;
    border-left-color: var(--muted);
  }
  .deploy-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .deploy-grid {
      grid-template-columns: 1fr 1.2fr;
    }
  }
  .deploy-panel {
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .deploy-panel h3 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
  }
  .deploy-panel p {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pod {
    padding: 0.5rem 0.65rem;
    margin-top: 0.35rem;
    border: 1px solid var(--line);
    font-size: 0.82rem;
    text-align: center;
  }
  .pod.single {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem;
  }
  .pod.single .role {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .deploy-facts {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .deploy-col {
    margin-top: 0.75rem;
  }
  .deploy-col strong {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.88rem;
  }
  .scale-note {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .shared-plane {
    display: grid;
    gap: 0.2rem;
    margin-top: 1rem;
    padding: 0.75rem;
    border: 1px dashed var(--accent);
    background: var(--paper-deep);
    text-align: center;
  }
  .shared-plane span {
    font-size: 0.82rem;
  }
  .shared-plane small {
    color: var(--muted);
    font-size: 0.75rem;
  }
  .lifecycle {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: lifecycle;
    display: grid;
    gap: 0.5rem;
  }
  .lifecycle li {
    display: grid;
    grid-template-columns: auto minmax(7rem, 0.7fr) minmax(8rem, 0.8fr) minmax(12rem, 1.5fr);
    align-items: center;
    gap: 0.45rem 0.75rem;
    margin: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    background: var(--paper);
    position: relative;
    font-size: 0.88rem;
  }
  .lifecycle li[data-flow='observe'] {
    border-left-style: dashed;
  }
  .lifecycle li[data-flow='durable'] {
    border-left-style: double;
  }
  .step-number {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper-deep);
    font-weight: 700;
    font-size: 0.75rem;
  }
  .step-owner {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 600;
  }
  .lifecycle small {
    color: var(--muted);
    font-size: 0.76rem;
  }
  @media (max-width: 640px) {
    .agent-backend-map {
      padding: 1rem;
    }
    .storage-grid {
      grid-template-columns: 1fr;
    }
    .observe-path {
      display: grid;
      grid-template-columns: 1fr;
      text-align: center;
    }
    .arrow.observe.inline {
      width: 0;
      height: 0.9rem;
      margin: 0 auto;
      border-top: 0;
      border-left: 2px dashed var(--muted);
    }
    .arrow.observe.inline::after {
      right: auto;
      left: -4px;
      top: auto;
      bottom: -4px;
      border-left-color: transparent;
      border-top-color: var(--muted);
    }
    .lifecycle li {
      grid-template-columns: auto 1fr;
    }
    .lifecycle li strong,
    .lifecycle li small {
      grid-column: 2;
    }
  }
  @media (prefers-color-scheme: dark) {
    .agent-backend-map {
      --paper: #202720;
      --paper-deep: #171d19;
      --ink: #edf1e9;
      --muted: #b8c3b6;
      --line: #465347;
      --accent: #a0ceac;
    }
  }
</style>
