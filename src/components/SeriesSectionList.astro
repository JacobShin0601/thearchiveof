---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import {
  partIdsForSeries,
  partMeta,
  postsInPart,
} from '../lib/series-sections';

interface Props {
  seriesName: string;
  posts: CollectionEntry<'posts'>[];
  language: 'ko' | 'en';
}

const { seriesName, posts, language } = Astro.props;
const partIds = partIdsForSeries(seriesName);
---

<div class="series-section-list">
  {partIds.map((partId) => {
    const meta = partMeta(partId);
    const sectionPosts = postsInPart(posts, partId);
    return (
      <section class="series-section-block" aria-labelledby={`series-part-${partId}`}>
        <header class="series-section-heading">
          <p class="eyebrow">{String(meta.index).padStart(2, '0')}</p>
          <h2 id={`series-part-${partId}`}>{meta.title[language]}</h2>
          <p class="series-section-dek">{meta.description[language]}</p>
        </header>
        {sectionPosts.length > 0 ? (
          <div class="post-grid series-section-grid">
            {sectionPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            {language === 'ko' ? '이 단계의 글이 준비 중입니다.' : 'Articles for this stage are being prepared.'}
          </p>
        )}
      </section>
    );
  })}
</div>
