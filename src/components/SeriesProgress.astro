---
import {
  isAppliedTrackDetailSeries,
  progressLabel,
  seriesUsesParts,
  trackProgressLabel,
  type SeriesPartId,
} from '../lib/series-sections';

interface Props {
  seriesName: string;
  seriesPart?: SeriesPartId;
  seriesOrder?: number;
  totalInSeries: number;
  language: 'ko' | 'en';
}

const { seriesName, seriesPart, seriesOrder, totalInSeries, language } = Astro.props;

const showPartProgress =
  seriesUsesParts(seriesName)
  && seriesPart
  && seriesOrder != null
  && totalInSeries > 0;

const showTrackProgress =
  isAppliedTrackDetailSeries(seriesName)
  && seriesOrder != null
  && totalInSeries > 0;

const labels = showPartProgress
  ? progressLabel({
      seriesName,
      partId: seriesPart!,
      seriesOrder: seriesOrder!,
      totalInSeries,
      language,
    })
  : showTrackProgress
    ? trackProgressLabel({
        detailSeriesName: seriesName,
        seriesOrder: seriesOrder!,
        totalInTrack: totalInSeries,
        language,
      })
    : null;

const show = showPartProgress || showTrackProgress;
---

{show && labels && (
  <p class="series-progress" aria-label={labels.aria}>
    <span class="series-progress-visible" aria-hidden="true">{labels.visible}</span>
  </p>
)}
