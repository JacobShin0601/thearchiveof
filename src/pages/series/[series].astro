---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeriesAppliedTrackSection from '../../components/SeriesAppliedTrackSection.astro';
import SeriesSectionList from '../../components/SeriesSectionList.astro';
import { postPath, seriesDefinition, slugify } from '../../consts';
import { isVisiblePost } from '../../environment';
import {
  AGENT_ENGINEERING_APPLIED_TRACKS,
  AGENT_ENGINEERING_SERIES,
  INTERNAL_LLM_SERVING_SERIES,
  isAppliedTrackDetailSeries,
  seriesUsesParts,
} from '../../lib/series-sections';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => isVisiblePost(data) && data.language === 'ko');
  const names = new Set(posts.flatMap((post) => post.data.series ? [post.data.series] : []));
  return [...names]
    .filter((name) => !isAppliedTrackDetailSeries(name))
    .map((name) => ({ params: { series: slugify(name) }, props: { name } }));
}) satisfies GetStaticPaths;

const { name } = Astro.props as { name: string };
const posts = (await getCollection('posts', ({ data }) => isVisiblePost(data) && data.language === 'ko' && data.series === name))
  .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999));
const description = seriesDefinition(name)?.description.ko
  ?? '핵심 개념에서 구현과 근거로 이어지는 순서 있는 읽기 경로입니다.';
const isAgentEngineering = name === AGENT_ENGINEERING_SERIES;
const appliedTrackPosts = isAgentEngineering
  ? (await getCollection('posts', ({ data }) =>
      isVisiblePost(data)
      && data.language === 'ko'
      && data.series === INTERNAL_LLM_SERVING_SERIES))
    .sort((a, b) => (a.data.seriesOrder ?? 999) - (b.data.seriesOrder ?? 999))
  : [];
---

<BaseLayout title={name} description={description} language="ko" alternateLanguageUrl={`/en/series/${slugify(name)}/`} indexable={posts.length > 0}>
  <section class="listing-page shell">
    <header>
      <p class="eyebrow"><a href="/series/">Series</a> / Learning path</p>
      <h1>{name}</h1>
      <p>{description}</p>
    </header>
    {posts.length > 0 ? (
      seriesUsesParts(name) ? (
        <>
          <SeriesSectionList seriesName={name} posts={posts} language="ko" />
          {isAgentEngineering && AGENT_ENGINEERING_APPLIED_TRACKS.map((detailSeries) => (
            <SeriesAppliedTrackSection
              detailSeriesName={detailSeries}
              trackPosts={appliedTrackPosts}
              language="ko"
            />
          ))}
        </>
      ) : (
        <ol class="series-articles">
          {posts.map((post, index) => (
            <li>
              <span>{String(post.data.seriesOrder ?? index + 1).padStart(2, '0')}</span>
              <div>
                <p class="post-meta">{post.data.section} / {post.data.subsection} / {post.data.contentType}</p>
                <h2><a href={postPath(post)}>{post.data.title}</a></h2>
                {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
                <p>{post.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    ) : (
      <p class="empty-state">This series is being prepared. Its articles will appear here in reading order.</p>
    )}
  </section>
</BaseLayout>
