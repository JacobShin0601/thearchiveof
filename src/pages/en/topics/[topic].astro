---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { topicDefinition, topicPath } from '../../../consts';
import { isVisiblePost } from '../../../environment';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => isVisiblePost(data) && data.language === 'en');
  const topics = new Set(posts.flatMap((post) => post.data.topics));
  return [...topics].map((topic) => ({ params: { topic }, props: { topic } }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props as { topic: string };
const allPosts = await getCollection('posts', ({ data }) => isVisiblePost(data) && data.language === 'en');
const posts = allPosts
  .filter((post) => post.data.topics.includes(topic))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured)
    || (b.data.updatedDate ?? b.data.publishedDate).valueOf() - (a.data.updatedDate ?? a.data.publishedDate).valueOf());
const definition = topicDefinition(topic);
const pillar = posts.find((post) => post.data.pillar);
const indexable = Boolean(definition?.indexable && posts.length >= 2);
const availableTopics = new Set(allPosts.flatMap((post) => post.data.topics));
const relatedTopics = definition?.related.filter((related) => availableTopics.has(related)) ?? [];
const groups = [
  { type: 'foundation', label: 'Foundation' },
  { type: 'research', label: 'Research' },
  { type: 'implementation', label: 'Implementation' },
  { type: 'current', label: 'Current' },
  { type: 'perspective', label: 'Perspective' },
].map((group) => ({ ...group, posts: posts.filter((post) => post.data.contentType === group.type && post.id !== pillar?.id) }))
  .filter((group) => group.posts.length > 0);

const koPosts = await getCollection('posts', ({ data }) => isVisiblePost(data) && data.language === 'ko');
const hasKoreanTopic = koPosts.some((post) => post.data.topics.includes(topic));
---

<BaseLayout
  title={definition?.name ?? topic}
  description={definition?.description ?? `Articles connected through ${topic}.`}
  language="en"
  alternateLanguageUrl={hasKoreanTopic ? topicPath(topic) : '/topics/'}
  indexable={indexable}
>
  <section class="listing-page shell topic-hub">
    <header>
      <p class="eyebrow"><a href="/en/topics/">Topics</a> / Knowledge hub</p>
      <h1>{definition?.name ?? topic}</h1>
      <p>{definition?.description}</p>
    </header>

    {pillar && <section class="topic-group start-here" aria-labelledby="start-here-heading">
      <div class="section-heading"><p class="eyebrow" id="start-here-heading">Start here</p></div>
      <div class="post-grid"><PostCard post={pillar} featured /></div>
    </section>}

    {groups.map((group) => <section class="topic-group" aria-labelledby={`group-${group.type}`}>
      <div class="section-heading"><p class="eyebrow" id={`group-${group.type}`}>{group.label}</p></div>
      <div class="post-grid">{group.posts.map((post, index) => <PostCard post={post} featured={index === 0} />)}</div>
    </section>)}

    {relatedTopics.length > 0 && <nav class="related-topics" aria-label="Related topics">
      <p class="eyebrow">Related topics</p>
      <div class="topic-links">{relatedTopics.map((related) => <a href={topicPath(related, 'en')}>{topicDefinition(related)?.name ?? related}</a>)}</div>
    </nav>}
  </section>
</BaseLayout>
