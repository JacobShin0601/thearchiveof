---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About The Archive of Ideas and its editorial principles.">
  <article class="prose-page shell">
    <header>
      <p class="eyebrow">About this publication</p>
      <h1>A working archive for ideas that deserve a longer life.</h1>
    </header>
    <div class="prose-grid">
      <aside>
        <p>Investing</p><p>AI & AX</p><p>Coding</p><p>Mathematics</p>
      </aside>
      <div class="prose">
        <p class="lead">The Archive of Ideas is an independent research journal by Jacob Shin.</p>
        <p>It is a place for durable explanations, working notes, original analysis, and connections across markets, technology, code, and mathematics.</p>
        <h2>Editorial principles</h2>
        <p>Prefer primary sources. Separate observation from inference. Show the model, code, or calculation when it matters. Update a note when the evidence changes.</p>
        <h2>Built to remain open</h2>
        <p>Every article is published as static HTML with a permanent URL, structured metadata, and an RSS entry. There is no login, paywall, or client-side application standing between a reader and the text.</p>
      </div>
    </div>
  </article>
</BaseLayout>
