---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath } from '../../consts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.(md|mdx)$/, '') }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.publishedDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
>
  <article class="article-page shell">
    <header class="article-header">
      <div class="post-meta">
        <a href={`/${categoryPath(post.data.category)}/`}>{post.data.category}</a>
        <span>/</span>
        <time datetime={post.data.publishedDate.toISOString()}>{date}</time>
      </div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="article-byline">
        <span>By {post.data.author}</span>
        {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
      </div>
    </header>
    <div class="article-body-wrap">
      {headings.length > 1 && <aside class="toc" aria-label="Table of contents">
        <p>In this note</p>
        <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </aside>}
      <div class="article-content"><Content /></div>
    </div>
  </article>
</BaseLayout>
